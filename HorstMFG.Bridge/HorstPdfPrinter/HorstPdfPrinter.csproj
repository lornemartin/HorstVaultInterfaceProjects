<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>HorstPdfPrinter</AssemblyName>
    <RootNamespace>HorstPdfPrinter</RootNamespace>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Output alongside Bridge.exe so it can be found at runtime via AppDomain.CurrentDomain.BaseDirectory -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\HorstMFG.Bridge\bin\$(Configuration)\net48\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\PrintPDF\PrintPDF.csproj" />
  </ItemGroup>

</Project>
