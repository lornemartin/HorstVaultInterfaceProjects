<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>HorstMFG.Bridge</RootNamespace>
    <AssemblyName>HorstMFG.Bridge</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting"                Version="6.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="6.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client"          Version="6.0.28" />
    <PackageReference Include="Serilog"                                      Version="3.1.1" />
    <PackageReference Include="Serilog.Extensions.Hosting"                  Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Console"                       Version="5.0.1" />
    <PackageReference Include="Serilog.Sinks.File"                          Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Radan\RadanProject\RadanProject.csproj" />
    <ProjectReference Include="..\..\Radan\RadanInterface2\RadanInterface2.csproj" />
    <ProjectReference Include="..\..\VaultAccess\VaultAccess.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vault 2026 SDK runtime DLLs — must be alongside the executable -->
    <None Include="..\..\Vault 2026 SDK Binaries\AdskLicensingSDK_9.dll">             <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><Link>AdskLicensingSDK_9.dll</Link></None>
    <None Include="..\..\Vault 2026 SDK Binaries\AdskIdentitySDK.dll">                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><Link>AdskIdentitySDK.dll</Link></None>
    <None Include="..\..\Vault 2026 SDK Binaries\Autodesk.Connectivity.WebServices.dll">           <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><Link>Autodesk.Connectivity.WebServices.dll</Link></None>
    <None Include="..\..\Vault 2026 SDK Binaries\Autodesk.Connectivity.WebServices.WCF.dll">      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><Link>Autodesk.Connectivity.WebServices.WCF.dll</Link></None>
    <None Include="..\..\Vault 2026 SDK Binaries\Autodesk.Connectivity.LicenseWrapper.dll">       <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><Link>Autodesk.Connectivity.LicenseWrapper.dll</Link></None>
    <None Include="..\..\Vault 2026 SDK Binaries\Autodesk.Connectivity.IDServicesWrapper.dll">    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><Link>Autodesk.Connectivity.IDServicesWrapper.dll</Link></None>
    <None Include="..\..\Vault 2026 SDK Binaries\Autodesk.Connectivity.Extensibility.Framework.dll"> <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><Link>Autodesk.Connectivity.Extensibility.Framework.dll</Link></None>
    <None Include="..\..\Vault 2026 SDK Binaries\Autodesk.DataManagement.Client.Framework.dll">        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><Link>Autodesk.DataManagement.Client.Framework.dll</Link></None>
    <None Include="..\..\Vault 2026 SDK Binaries\Autodesk.DataManagement.Client.Framework.Vault.dll">  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><Link>Autodesk.DataManagement.Client.Framework.Vault.dll</Link></None>
    <None Include="..\..\Vault 2026 SDK Binaries\Autodesk.DataManagement.Client.Framework.Forms.dll">       <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><Link>Autodesk.DataManagement.Client.Framework.Forms.dll</Link></None>
    <None Include="..\..\Vault 2026 SDK Binaries\Autodesk.DataManagement.Client.Framework.Vault.Forms.dll"> <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><Link>Autodesk.DataManagement.Client.Framework.Vault.Forms.dll</Link></None>
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.Development.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
