{
  "EnvTool": {
    // PostgreSQL login with rights to create, rename and drop databases. The Database part is
    // ignored. Blank: the web app's ConnectionStrings:DefaultConnection, read from WebAppSettingsPath.
    "ConnectionString": "",
    "WebAppSettingsPath": "..\\..\\src\\HorstMFG.Web\\appsettings.json",

    // The database the web app runs on. Every environment is this name, or this name + "_something".
    "LiveDatabase": "horstmfg",

    // Where environments' PDF folders go (each gets <PdfRoot>\<database>). Blank: the web app's
    // FileSystemPaths:LocalPdfPath, which is where it has been putting them so far.
    "PdfRoot": "",

    // The web app's IIS app pool (HorstMFG on the server, as in scripts/deploy.ps1). swap, and clear
    // of the live database, stop it and start it again; needs an elevated prompt. Blank: not managed.
    "AppPool": "",

    "BackupRoot": "C:\\HorstMFG\\Backups",
    "PgBinPath": "C:\\Program Files\\PostgreSQL\\18\\bin"
  }
}
