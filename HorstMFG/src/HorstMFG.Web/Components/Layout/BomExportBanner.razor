@rendermode InteractiveServer
@inject BridgeNotificationService BridgeEvents
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor
@inject IDbContextFactory<HorstMFG.Infrastructure.Data.ApplicationDbContext> DbContextFactory
@implements IDisposable
@using System.Security.Claims
@using HorstMFG.Web.Services
@using Microsoft.EntityFrameworkCore

@if (_showBanner)
{
    <div style="background:#d1fae5; border:1px solid #6ee7b7; border-radius:6px;
                padding:.6rem 1rem; margin-bottom:1rem;
                display:flex; justify-content:space-between; align-items:center;">
        <span>
            New BOM export detected from Vault.
            <a href="/bom-import" style="font-weight:600; text-decoration:underline; cursor:pointer;"
               @onclick="NavigateToBomImport" @onclick:preventDefault="true">
                Click here to go to BOM Import.
            </a>
        </span>
        <button @onclick="DismissBanner"
                style="background:none; border:none; cursor:pointer; font-size:1.1rem;
                       padding:0 .4rem; line-height:1; color:#065f46;"
                title="Dismiss">&#x2715;</button>
    </div>
}

@code {
    private bool _showBanner;
    private bool _isAdmin;
    private int? _myStationId;
    private int _myPlantId;

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var user = HttpContextAccessor.HttpContext?.User;
            _isAdmin = user?.HasClaim(ClaimTypes.Role, "Admin") ?? false;
            if (int.TryParse(user?.FindFirst("StationId")?.Value, out var sid))
                _myStationId = sid;
            int.TryParse(user?.FindFirst("PlantId")?.Value, out _myPlantId);

            BridgeEvents.BomExportReceived += OnBomExportReceived;
        }
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        BridgeEvents.BomExportReceived -= OnBomExportReceived;
    }

    private void OnBomExportReceived(int stationId, string fileContents)
    {
        var path = new Uri(Nav.Uri).AbsolutePath;
        if (path.Equals("/bom-import", StringComparison.OrdinalIgnoreCase)) return;

        _ = InvokeAsync(async () =>
        {
            // This event is a global broadcast (BridgeNotificationService is a singleton, and every
            // logged-in user's layout subscribes). A user assigned to a specific station only sees
            // exports from THAT station. A user with no station assigned (StationId is optional,
            // unlike PlantId which every user has) falls back to their own plant, so they still see
            // only exports relevant to them rather than either everything or nothing.
            if (!_isAdmin)
            {
                if (_myStationId.HasValue)
                {
                    if (stationId != _myStationId.Value) return;
                }
                else
                {
                    await using var db = await DbContextFactory.CreateDbContextAsync();
                    var stationPlantId = await db.NestingStations
                        .Where(s => s.Id == stationId)
                        .Select(s => (int?)s.PlantId)
                        .FirstOrDefaultAsync();
                    if (stationPlantId != _myPlantId) return;
                }
            }

            _showBanner = true;
            StateHasChanged();
        });
    }

    private void NavigateToBomImport()
    {
        _showBanner = false;
        Nav.NavigateTo("/bom-import");
    }

    private void DismissBanner()
    {
        _showBanner = false;
        BridgeEvents.ClearPendingBomExport();
    }
}
