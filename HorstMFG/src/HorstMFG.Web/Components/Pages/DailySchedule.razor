@page "/engineering/orders"
@attribute [Authorize(Policy = "Engineering")]
@rendermode InteractiveServer
@inject IBomService BomService
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JS
@inject HorstMFG.Web.Services.ScheduleTreeFilterState ScheduleFilterState
@inject HorstMFG.Web.Services.BatchTreeFilterState BatchFilterState
@using HorstMFG.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.TreeGrid
@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.Data

<PageTitle>Orders - HorstMFG</PageTitle>

<h3>Orders</h3>

<div style="display: flex; gap: 2rem; margin-bottom: 1rem; align-items: flex-end; flex-wrap: wrap;">
    <div style="min-width: 200px;">
        <label style="display: block; font-weight: 600; margin-bottom: 0.25rem;">Plant</label>
        <SfDropDownList TValue="int?" TItem="PlantOption"
                        Value="_selectedPlantId"
                        ValueChanged="OnPlantChanged"
                        DataSource="_plantOptions"
                        Enabled="_isAdmin">
            <DropDownListFieldSettings Text="Name" Value="Id" />
        </SfDropDownList>
    </div>

    <div style="min-width: 140px;">
        <label style="display: block; font-weight: 600; margin-bottom: 0.25rem;">From</label>
        <SfDatePicker TValue="DateTime?" Value="_fromDate" ValueChanged="OnFromDateChanged" Format="MM/dd/yyyy" />
    </div>

    <div style="min-width: 140px;">
        <label style="display: block; font-weight: 600; margin-bottom: 0.25rem;">To</label>
        <SfDatePicker TValue="DateTime?" Value="_toDate" ValueChanged="OnToDateChanged" Format="MM/dd/yyyy" />
    </div>

    <div>
        <label style="display: block; font-weight: 600; margin-bottom: 0.25rem;">&nbsp;</label>
        <div style="display: flex; gap: 0.5rem;">
            <SfButton OnClick="@(() => SetDateRange(30))">30 days</SfButton>
            <SfButton OnClick="@(() => SetDateRange(90))">90 days</SfButton>
            <SfButton OnClick="@(() => SetDateRange(null))">All</SfButton>
        </div>
    </div>

    <div style="display: flex; align-items: center; padding-bottom: 0.25rem;">
        <SfCheckBox Label="Show Processed Items" @bind-Checked="_showProcessed" ValueChange="OnShowProcessedChanged" TChecked="bool" />
    </div>
</div>

<SfTab>
    <TabItems>
        <TabItem>
            <ChildContent>
                <TabHeader Text="Daily Schedule" />
            </ChildContent>
            <ContentTemplate>
                <div style="padding-top: 0.5rem;">
                    <SfTreeGrid TValue="ExportTreeItem" @ref="_schedGrid" ID="OrdersGrid_v5" IdMapping="TreeId" ParentIdMapping="TreeParentId"
                                HasChildMapping="HasChildren" LoadChildOnDemand="true" EnablePersistence="true"
                                TreeColumnIndex="0" AllowSorting="true" AllowMultiSorting="true" Height="600" AllowResizing="true"
                                ContextMenuItems="@_contextMenuItems">
                        <SfDataManager AdaptorInstance="typeof(HorstMFG.Web.Services.ScheduleTreeAdaptor)" Adaptor="Adaptors.CustomAdaptor" />
                        <TreeGridEvents TValue="ExportTreeItem"
                                        RowDataBound="OnMtoRowDataBound"
                                        ContextMenuOpen="OnContextMenuOpen"
                                        ContextMenuItemClicked="OnMtoContextMenuClicked" />
                            <TreeGridColumns>
                                <TreeGridColumn Field="@nameof(ExportTreeItem.Number)" HeaderText="Number" Width="300">
                                    <Template>
                                        @{
                                            var item = context as ExportTreeItem;
                                            @if (item!.IsBatchRow)
                                            {
                                                <strong>@item.BatchName</strong>
                                            }
                                            else if (item.IsProductRow)
                                            {
                                                <span style="font-style: italic;">@item.ProductName</span>
                                            }
                                            else
                                            {
                                                <span>@item.Number</span>
                                            }
                                        }
                                    </Template>
                                </TreeGridColumn>
                                <TreeGridColumn Field="@nameof(ExportTreeItem.Description)" HeaderText="Description" Width="220">
                                    <Template>
                                        @{
                                            var item = context as ExportTreeItem;
                                            @if (!item!.IsBatchRow && !item.IsProductRow)
                                            {
                                                <span>@item.Description</span>
                                            }
                                        }
                                    </Template>
                                </TreeGridColumn>
                                <TreeGridColumn Field="@nameof(ExportTreeItem.CategoryOrder)" HeaderText="Category" Width="100">
                                    <Template>
                                        @{
                                            var item = context as ExportTreeItem;
                                            <span>@item!.Category</span>
                                        }
                                    </Template>
                                </TreeGridColumn>
                                <TreeGridColumn Field="@nameof(ExportTreeItem.Material)" HeaderText="Material" Width="120" />
                                <TreeGridColumn Field="@nameof(ExportTreeItem.Thickness)" HeaderText="Thickness" Width="90" />
                                <TreeGridColumn Field="@nameof(ExportTreeItem.Operations)" HeaderText="Operations" Width="110" />
                                <TreeGridColumn Field="@nameof(ExportTreeItem.Qty)" HeaderText="Qty" Width="70" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                    <Template>
                                        @{
                                            var item = context as ExportTreeItem;
                                            @if (item!.IsBatchRow)
                                            {
                                                <span style="color: #6b7280;">@item.ItemCount items</span>
                                            }
                                            else if (item.IsProductRow)
                                            {
                                                <strong>@item.ParentQty</strong>
                                            }
                                            else
                                            {
                                                @item.Qty
                                            }
                                        }
                                    </Template>
                                </TreeGridColumn>
                                <TreeGridColumn Field="@nameof(ExportTreeItem.IsStock)" HeaderText="Stock" Width="70"
                                                DisplayAsCheckBox="true" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center" />
                                <TreeGridColumn Field="@nameof(ExportTreeItem.HasPdf)" HeaderText="PDF" Width="70"
                                                DisplayAsCheckBox="true" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center" />
                                <TreeGridColumn Field="@nameof(ExportTreeItem.Notes)" HeaderText="Notes" Width="150" />
                                <TreeGridColumn Field="@nameof(ExportTreeItem.ImportDate)" HeaderText="Imported" Width="140">
                                    <Template>
                                        @{
                                            var item = context as ExportTreeItem;
                                            @if (item!.IsBatchRow && item.ImportDate.HasValue)
                                            {
                                                @item.ImportDate.Value.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")
                                            }
                                        }
                                    </Template>
                                </TreeGridColumn>
                            </TreeGridColumns>
                    </SfTreeGrid>
                </div>
            </ContentTemplate>
        </TabItem>
        <TabItem>
            <ChildContent>
                <TabHeader Text="Batches" />
            </ChildContent>
            <ContentTemplate>
                <div style="padding-top: 0.5rem;">
                    <SfTreeGrid TValue="ExportTreeItem" @ref="_batchGrid" ID="BatchesGrid_v4" IdMapping="TreeId" ParentIdMapping="TreeParentId"
                                HasChildMapping="HasChildren" LoadChildOnDemand="true" EnablePersistence="true"
                                TreeColumnIndex="0" AllowSorting="true" AllowMultiSorting="true" Height="600" AllowResizing="true"
                                Toolbar="@_toolbar"
                                ContextMenuItems="@_contextMenuItems">
                        <SfDataManager AdaptorInstance="typeof(HorstMFG.Web.Services.BatchTreeAdaptor)" Adaptor="Adaptors.CustomAdaptor" />
                        <TreeGridEvents TValue="ExportTreeItem"
                                        RowDataBound="OnMtsRowDataBound"
                                        ContextMenuOpen="OnContextMenuOpen"
                                        ContextMenuItemClicked="OnMtsContextMenuClicked" />
                            <TreeGridColumns>
                                <TreeGridColumn Field="@nameof(ExportTreeItem.Number)" HeaderText="Number" Width="300">
                                    <Template>
                                        @{
                                            var item = context as ExportTreeItem;
                                            @if (item!.IsBatchRow)
                                            {
                                                <strong>@item.BatchName</strong>
                                            }
                                            else if (item.IsProductRow)
                                            {
                                                <span style="font-style: italic;">@item.ProductName</span>
                                            }
                                            else
                                            {
                                                <span>@item.Number</span>
                                            }
                                        }
                                    </Template>
                                </TreeGridColumn>
                                <TreeGridColumn Field="@nameof(ExportTreeItem.Description)" HeaderText="Description" Width="220">
                                    <Template>
                                        @{
                                            var item = context as ExportTreeItem;
                                            @if (!item!.IsBatchRow && !item.IsProductRow)
                                            {
                                                <span>@item.Description</span>
                                            }
                                        }
                                    </Template>
                                </TreeGridColumn>
                                <TreeGridColumn Field="@nameof(ExportTreeItem.CategoryOrder)" HeaderText="Category" Width="100">
                                    <Template>
                                        @{
                                            var item = context as ExportTreeItem;
                                            <span>@item!.Category</span>
                                        }
                                    </Template>
                                </TreeGridColumn>
                                <TreeGridColumn Field="@nameof(ExportTreeItem.Material)" HeaderText="Material" Width="120" />
                                <TreeGridColumn Field="@nameof(ExportTreeItem.Thickness)" HeaderText="Thickness" Width="90" />
                                <TreeGridColumn Field="@nameof(ExportTreeItem.Operations)" HeaderText="Operations" Width="110" />
                                <TreeGridColumn Field="@nameof(ExportTreeItem.Qty)" HeaderText="Qty" Width="70" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                    <Template>
                                        @{
                                            var item = context as ExportTreeItem;
                                            @if (item!.IsBatchRow)
                                            {
                                                <span style="color: #6b7280;">@item.ItemCount items</span>
                                            }
                                            else if (item.IsProductRow)
                                            {
                                                <strong>@item.ParentQty</strong>
                                            }
                                            else
                                            {
                                                @item.Qty
                                            }
                                        }
                                    </Template>
                                </TreeGridColumn>
                                <TreeGridColumn Field="@nameof(ExportTreeItem.IsStock)" HeaderText="Stock" Width="70"
                                                DisplayAsCheckBox="true" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center" />
                                <TreeGridColumn Field="@nameof(ExportTreeItem.HasPdf)" HeaderText="PDF" Width="70"
                                                DisplayAsCheckBox="true" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center" />
                                <TreeGridColumn Field="@nameof(ExportTreeItem.Notes)" HeaderText="Notes" Width="150" />
                                <TreeGridColumn Field="@nameof(ExportTreeItem.ImportDate)" HeaderText="Imported" Width="140">
                                    <Template>
                                        @{
                                            var item = context as ExportTreeItem;
                                            @if (item!.IsBatchRow && item.ImportDate.HasValue)
                                            {
                                                @item.ImportDate.Value.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")
                                            }
                                        }
                                    </Template>
                                </TreeGridColumn>
                            </TreeGridColumns>
                    </SfTreeGrid>
                </div>
            </ContentTemplate>
        </TabItem>
    </TabItems>
</SfTab>

@code {
    private List<PlantOption> _plantOptions = new();
    private int? _selectedPlantId;
    private bool _showProcessed;
    private bool _isAdmin;
    private DateTime? _fromDate = DateTime.Today.AddDays(-30);
    private DateTime? _toDate = DateTime.Today;

    // Load-on-demand grids (CustomAdaptors read the filter state services)
    private SfTreeGrid<ExportTreeItem>? _schedGrid;
    private SfTreeGrid<ExportTreeItem>? _batchGrid;

    private record PlantOption(int? Id, string Name);

    private readonly List<string> _toolbar = new() { "Search" };

    private readonly List<object> _contextMenuItems = new()
    {
        new ContextMenuItemModel { Text = "Laser Parts Report",         Id = "laser-report"      },
        new ContextMenuItemModel { Text = "Iron Worker Report",         Id = "op-iron-worker"    },
        new ContextMenuItemModel { Text = "Machine Shop Report",        Id = "op-machine-shop"   },
        new ContextMenuItemModel { Text = "Bandsaw Report",             Id = "op-bandsaw"        },
        new ContextMenuItemModel { Text = "Purchased Parts Report",     Id = "op-purchased"      },
    };

    private static readonly Dictionary<string, string> _opMenuItems = new()
    {
        ["op-iron-worker"]  = "Iron Worker",
        ["op-machine-shop"] = "Machine Shop",
        ["op-bandsaw"]      = "Bandsaw",
        ["op-purchased"]    = "Purchased",
    };

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var plants = await db.Plants.Where(p => p.IsActive).OrderBy(p => p.Name).ToListAsync();
        _plantOptions = new List<PlantOption> { new(null, "All Plants") };
        _plantOptions.AddRange(plants.Select(p => new PlantOption(p.Id, p.Name)));

        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext?.User.Identity?.IsAuthenticated == true)
        {
            _isAdmin = httpContext.User.HasClaim(ClaimTypes.Role, "Admin");

            if (!_isAdmin)
            {
                var plantIdClaim = httpContext.User.FindFirst("PlantId")?.Value;
                if (int.TryParse(plantIdClaim, out var pid))
                    _selectedPlantId = pid;
            }
        }

        // Prime filter state so the adaptor has correct values on first fetch
        SyncFilterState();
    }

    private bool _isFirstLoad = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadData();
        StateHasChanged();
    }

    private void SyncFilterState()
    {
        ScheduleFilterState.PlantId = _selectedPlantId;
        ScheduleFilterState.IncludeProcessed = _showProcessed;
        ScheduleFilterState.FromDate = _fromDate;
        ScheduleFilterState.ToDate = _toDate;

        BatchFilterState.PlantId = _selectedPlantId;
        BatchFilterState.IncludeProcessed = _showProcessed;
        BatchFilterState.FromDate = _fromDate;
        BatchFilterState.ToDate = _toDate;
    }

    private async Task LoadData()
    {
        SyncFilterState();

        // RefreshAsync() crashes before the grid finishes initializing on first render.
        // The adaptors fire automatically on first load, so only call after that.
        if (_isFirstLoad)
        {
            _isFirstLoad = false;
        }
        else
        {
            if (_schedGrid is not null) await _schedGrid.RefreshAsync();
            if (_batchGrid is not null) await _batchGrid.RefreshAsync();
        }
    }

    private async Task OnPlantChanged(int? value)
    {
        _selectedPlantId = value;
        await LoadData();
        StateHasChanged();
    }

    private async Task OnShowProcessedChanged(Syncfusion.Blazor.Buttons.ChangeEventArgs<bool> args)
    {
        _showProcessed = args.Checked;
        await LoadData();
        StateHasChanged();
    }

    private async Task OnFromDateChanged(DateTime? value)
    {
        _fromDate = value;
        await LoadData();
        StateHasChanged();
    }

    private async Task OnToDateChanged(DateTime? value)
    {
        _toDate = value;
        await LoadData();
        StateHasChanged();
    }

    private async Task SetDateRange(int? days)
    {
        _fromDate = days.HasValue ? DateTime.Today.AddDays(-days.Value) : null;
        _toDate = days.HasValue ? DateTime.Today : null;
        await LoadData();
        StateHasChanged();
    }

    // ── Context menu ─────────────────────────────────────────────────────────

    private void OnContextMenuOpen(ContextMenuOpenEventArgs<ExportTreeItem> args)
    {
        // Only show on top-level schedule/batch rows
        if (args.RowInfo?.RowData is not { IsBatchRow: true })
            args.Cancel = true;
    }

    private async Task OnMtoContextMenuClicked(ContextMenuClickEventArgs<ExportTreeItem> args)
    {
        if (args.RowInfo?.RowData?.BatchName is not string name) return;

        if (args.Item.Id == "laser-report")
            await JS.InvokeVoidAsync("window.open",
                $"/api/reports/schedule-laser/{Uri.EscapeDataString(name)}", "_blank");
        else if (_opMenuItems.TryGetValue(args.Item.Id, out var op))
            await JS.InvokeVoidAsync("window.open",
                $"/api/reports/schedule-op/{Uri.EscapeDataString(name)}/{Uri.EscapeDataString(op)}", "_blank");
    }

    private async Task OnMtsContextMenuClicked(ContextMenuClickEventArgs<ExportTreeItem> args)
    {
        if (args.RowInfo?.RowData?.BatchName is not string name) return;

        if (args.Item.Id == "laser-report")
            await JS.InvokeVoidAsync("window.open",
                $"/api/reports/batch-laser/{Uri.EscapeDataString(name)}", "_blank");
        else if (_opMenuItems.TryGetValue(args.Item.Id, out var op))
            await JS.InvokeVoidAsync("window.open",
                $"/api/reports/batch-op/{Uri.EscapeDataString(name)}/{Uri.EscapeDataString(op)}", "_blank");
    }

    // Daily Schedule tab: stock items are dimmed (they belong on the Batches tab)
    private void OnMtoRowDataBound(RowDataBoundEventArgs<ExportTreeItem> args)
    {
        if (args.Data.IsBatchRow)
            args.Row.AddClass(new[] { "row-batch" });
        else if (args.Data.IsProductRow)
            args.Row.AddClass(new[] { "row-product" });
        else
        {
            if (args.Data.IsProcessed)
                args.Row.AddClass(new[] { "row-processed" });
            if (!string.IsNullOrWhiteSpace(args.Data.Notes))
                args.Row.AddClass(new[] { "row-has-notes" });
            if (args.Data.IsStock)
                args.Row.AddClass(new[] { "row-dimmed" });
        }
    }

    // Batches tab: non-stock items are dimmed (they belong on the Daily Schedule tab)
    private void OnMtsRowDataBound(RowDataBoundEventArgs<ExportTreeItem> args)
    {
        if (args.Data.IsBatchRow)
            args.Row.AddClass(new[] { "row-batch" });
        else if (args.Data.IsProductRow)
            args.Row.AddClass(new[] { "row-product" });
        else
        {
            if (args.Data.IsProcessed)
                args.Row.AddClass(new[] { "row-processed" });
            if (!string.IsNullOrWhiteSpace(args.Data.Notes))
                args.Row.AddClass(new[] { "row-has-notes" });
            if (!args.Data.IsStock)
                args.Row.AddClass(new[] { "row-dimmed" });
        }
    }
}
