@page "/engineering/orders"
@attribute [Authorize(Policy = "Engineering")]
@rendermode InteractiveServer
@inject IBomService BomService
@inject ApplicationDbContext DbContext
@inject IHttpContextAccessor HttpContextAccessor
@using HorstMFG.Infrastructure.Data
@using HorstMFG.Core.Entities
@using Microsoft.EntityFrameworkCore
@using System.Text.Json

<PageTitle>Orders - HorstMFG</PageTitle>

<h3>Orders</h3>

<div style="display: flex; gap: 2rem; margin-bottom: 1rem; align-items: center; flex-wrap: wrap;">
    <div style="min-width: 200px;">
        <label style="display: block; font-weight: 600; margin-bottom: 0.25rem;">Plant</label>
        <SfDropDownList TValue="int?" TItem="PlantOption"
                        Value="_selectedPlantId"
                        ValueChanged="OnPlantChanged"
                        DataSource="_plantOptions"
                        Enabled="_isAdmin">
            <DropDownListFieldSettings Text="Name" Value="Id" />
        </SfDropDownList>
    </div>

    <div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 1.5rem;">
        <SfCheckBox Label="Show Processed Items" @bind-Checked="_showProcessed" ValueChange="OnShowProcessedChanged" TChecked="bool" />
    </div>
</div>

<SfTab>
    <TabItems>
        <TabItem>
            <ChildContent>
                <TabHeader Text="Daily Schedule" />
            </ChildContent>
            <ContentTemplate>
                <div style="padding-top: 0.5rem;">
                    @if (_mtoItems.Count == 0)
                    {
                        <p style="color: #64748b; padding: 2rem; text-align: center;">No orders found.</p>
                    }
                    else
                    {
                        <SfTreeGrid ID="OrdersGrid_v2" DataSource="_mtoItems" IdMapping="TreeId" ParentIdMapping="TreeParentId"
                                    ExpandStateMapping="IsExpanded"
                                    TreeColumnIndex="0" AllowSorting="true" AllowMultiSorting="true" Height="550" AllowResizing="true" EnablePersistence="true">
                            <TreeGridEvents TValue="ExportTreeItem"
                                            RowDataBound="OnMtoRowDataBound"
                                            Collapsed="OnOrdersRowCollapsed"
                                            Expanded="OnOrdersRowExpanded" />
                            <TreeGridColumns>
                                <TreeGridColumn Field="@nameof(ExportTreeItem.Number)" HeaderText="Number" Width="300">
                                    <Template>
                                        @{
                                            var item = context as ExportTreeItem;
                                            @if (item!.IsBatchRow)
                                            {
                                                <strong>@item.BatchName</strong>
                                            }
                                            else if (item.IsProductRow)
                                            {
                                                <span style="font-style: italic;">@item.ProductName</span>
                                            }
                                            else
                                            {
                                                <span>@item.Number</span>
                                            }
                                        }
                                    </Template>
                                </TreeGridColumn>
                                <TreeGridColumn Field="@nameof(ExportTreeItem.Description)" HeaderText="Description" Width="220">
                                    <Template>
                                        @{
                                            var item = context as ExportTreeItem;
                                            @if (!item!.IsBatchRow && !item.IsProductRow)
                                            {
                                                <span>@item.Description</span>
                                            }
                                        }
                                    </Template>
                                </TreeGridColumn>
                                <TreeGridColumn Field="@nameof(ExportTreeItem.CategoryOrder)" HeaderText="Category" Width="100">
                                    <Template>
                                        @{
                                            var item = context as ExportTreeItem;
                                            <span>@item!.Category</span>
                                        }
                                    </Template>
                                </TreeGridColumn>
                                <TreeGridColumn Field="@nameof(ExportTreeItem.Material)" HeaderText="Material" Width="120" />
                                <TreeGridColumn Field="@nameof(ExportTreeItem.Thickness)" HeaderText="Thickness" Width="90" />
                                <TreeGridColumn Field="@nameof(ExportTreeItem.Operations)" HeaderText="Operations" Width="110" />
                                <TreeGridColumn Field="@nameof(ExportTreeItem.Qty)" HeaderText="Qty" Width="70" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                    <Template>
                                        @{
                                            var item = context as ExportTreeItem;
                                            @if (item!.IsBatchRow || item.IsProductRow)
                                            {
                                                <span style="color: #6b7280;">@item.ItemCount items</span>
                                            }
                                            else
                                            {
                                                @item.Qty
                                            }
                                        }
                                    </Template>
                                </TreeGridColumn>
                                <TreeGridColumn Field="@nameof(ExportTreeItem.IsStock)" HeaderText="Stock" Width="70"
                                                DisplayAsCheckBox="true" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center" />
                                <TreeGridColumn Field="@nameof(ExportTreeItem.HasPdf)" HeaderText="PDF" Width="70"
                                                DisplayAsCheckBox="true" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center" />
                                <TreeGridColumn Field="@nameof(ExportTreeItem.Notes)" HeaderText="Notes" Width="150" />
                                <TreeGridColumn Field="@nameof(ExportTreeItem.ImportDate)" HeaderText="Imported" Width="140">
                                    <Template>
                                        @{
                                            var item = context as ExportTreeItem;
                                            @if (item!.IsBatchRow && item.ImportDate.HasValue)
                                            {
                                                @item.ImportDate.Value.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")
                                            }
                                        }
                                    </Template>
                                </TreeGridColumn>
                            </TreeGridColumns>
                        </SfTreeGrid>
                    }
                </div>
            </ContentTemplate>
        </TabItem>
        <TabItem>
            <ChildContent>
                <TabHeader Text="Batches" />
            </ChildContent>
            <ContentTemplate>
                <div style="padding-top: 0.5rem;">
                    @if (_mtsItems.Count == 0)
                    {
                        <p style="color: #64748b; padding: 2rem; text-align: center;">No batches found.</p>
                    }
                    else
                    {
                        <SfTreeGrid ID="BatchesGrid_v2" DataSource="_mtsItems" IdMapping="TreeId" ParentIdMapping="TreeParentId"
                                    ExpandStateMapping="IsExpanded"
                                    TreeColumnIndex="0" AllowSorting="true" AllowMultiSorting="true" Height="550" AllowResizing="true" EnablePersistence="true">
                            <TreeGridEvents TValue="ExportTreeItem"
                                            RowDataBound="OnMtsRowDataBound"
                                            Collapsed="OnBatchesRowCollapsed"
                                            Expanded="OnBatchesRowExpanded" />
                            <TreeGridColumns>
                                <TreeGridColumn Field="@nameof(ExportTreeItem.Number)" HeaderText="Number" Width="300">
                                    <Template>
                                        @{
                                            var item = context as ExportTreeItem;
                                            @if (item!.IsBatchRow)
                                            {
                                                <strong>@item.BatchName</strong>
                                            }
                                            else if (item.IsProductRow)
                                            {
                                                <span style="font-style: italic;">@item.ProductName</span>
                                            }
                                            else
                                            {
                                                <span>@item.Number</span>
                                            }
                                        }
                                    </Template>
                                </TreeGridColumn>
                                <TreeGridColumn Field="@nameof(ExportTreeItem.Description)" HeaderText="Description" Width="220">
                                    <Template>
                                        @{
                                            var item = context as ExportTreeItem;
                                            @if (!item!.IsBatchRow && !item.IsProductRow)
                                            {
                                                <span>@item.Description</span>
                                            }
                                        }
                                    </Template>
                                </TreeGridColumn>
                                <TreeGridColumn Field="@nameof(ExportTreeItem.CategoryOrder)" HeaderText="Category" Width="100">
                                    <Template>
                                        @{
                                            var item = context as ExportTreeItem;
                                            <span>@item!.Category</span>
                                        }
                                    </Template>
                                </TreeGridColumn>
                                <TreeGridColumn Field="@nameof(ExportTreeItem.Material)" HeaderText="Material" Width="120" />
                                <TreeGridColumn Field="@nameof(ExportTreeItem.Thickness)" HeaderText="Thickness" Width="90" />
                                <TreeGridColumn Field="@nameof(ExportTreeItem.Operations)" HeaderText="Operations" Width="110" />
                                <TreeGridColumn Field="@nameof(ExportTreeItem.Qty)" HeaderText="Qty" Width="70" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                    <Template>
                                        @{
                                            var item = context as ExportTreeItem;
                                            @if (item!.IsBatchRow || item.IsProductRow)
                                            {
                                                <span style="color: #6b7280;">@item.ItemCount items</span>
                                            }
                                            else
                                            {
                                                @item.Qty
                                            }
                                        }
                                    </Template>
                                </TreeGridColumn>
                                <TreeGridColumn Field="@nameof(ExportTreeItem.IsStock)" HeaderText="Stock" Width="70"
                                                DisplayAsCheckBox="true" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center" />
                                <TreeGridColumn Field="@nameof(ExportTreeItem.HasPdf)" HeaderText="PDF" Width="70"
                                                DisplayAsCheckBox="true" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center" />
                                <TreeGridColumn Field="@nameof(ExportTreeItem.Notes)" HeaderText="Notes" Width="150" />
                                <TreeGridColumn Field="@nameof(ExportTreeItem.ImportDate)" HeaderText="Imported" Width="140">
                                    <Template>
                                        @{
                                            var item = context as ExportTreeItem;
                                            @if (item!.IsBatchRow && item.ImportDate.HasValue)
                                            {
                                                @item.ImportDate.Value.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")
                                            }
                                        }
                                    </Template>
                                </TreeGridColumn>
                            </TreeGridColumns>
                        </SfTreeGrid>
                    }
                </div>
            </ContentTemplate>
        </TabItem>
    </TabItems>
</SfTab>

@code {
    private List<ExportTreeItem> _mtoItems = new();
    private List<ExportTreeItem> _mtsItems = new();
    private List<PlantOption> _plantOptions = new();
    private int? _selectedPlantId;
    private bool _showProcessed;
    private bool _isAdmin;
    private int _userId;

    private HashSet<string> _ordersCollapsed = new();
    private HashSet<string> _ordersProductsCollapsed = new();
    private HashSet<string> _batchesCollapsed = new();
    private HashSet<string> _batchesProductsCollapsed = new();

    private record PlantOption(int? Id, string Name);

protected override async Task OnInitializedAsync()
    {
        var plants = await DbContext.Plants.Where(p => p.IsActive).OrderBy(p => p.Name).ToListAsync();
        _plantOptions = new List<PlantOption> { new(null, "All Plants") };
        _plantOptions.AddRange(plants.Select(p => new PlantOption(p.Id, p.Name)));

        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext?.User.Identity?.IsAuthenticated == true)
        {
            _isAdmin = httpContext.User.HasClaim(ClaimTypes.Role, "Admin");

            if (int.TryParse(httpContext.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var uid))
                _userId = uid;

            if (!_isAdmin)
            {
                var plantIdClaim = httpContext.User.FindFirst("PlantId")?.Value;
                if (int.TryParse(plantIdClaim, out var pid))
                    _selectedPlantId = pid;
            }
        }

        // Data loaded in OnAfterRenderAsync so collapsed state from DB is known first
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (_userId > 0)
        {
            var prefs = await DbContext.UserGridPreferences
                .Where(p => p.UserId == _userId && (
                    p.GridId == "OrdersGrid" || p.GridId == "OrdersGrid_L2" ||
                    p.GridId == "BatchesGrid" || p.GridId == "BatchesGrid_L2"))
                .ToListAsync();

            HashSet<string> Load(string gridId) =>
                JsonSerializer.Deserialize<HashSet<string>>(
                    prefs.FirstOrDefault(p => p.GridId == gridId)?.CollapsedState ?? "[]") ?? new();

            _ordersCollapsed         = Load("OrdersGrid");
            _ordersProductsCollapsed = Load("OrdersGrid_L2");
            _batchesCollapsed        = Load("BatchesGrid");
            _batchesProductsCollapsed = Load("BatchesGrid_L2");
        }

        await LoadData();
        StateHasChanged();
    }

    private async Task LoadData()
    {
        var mtoItems = await BomService.GetScheduleTreeItemsAsync(_selectedPlantId, _showProcessed);
        var mtsItems = await BomService.GetBatchTreeItemsAsync(_selectedPlantId, _showProcessed);

        ApplyExpansionState(mtoItems, _ordersCollapsed, _ordersProductsCollapsed);
        ApplyExpansionState(mtsItems, _batchesCollapsed, _batchesProductsCollapsed);

        _mtoItems = mtoItems;
        _mtsItems = mtsItems;
    }

    private static void ApplyExpansionState(List<ExportTreeItem> items, HashSet<string> collapsed, HashSet<string> collapsedProducts)
    {
        foreach (var item in items)
        {
            if (item.IsBatchRow && item.BatchName != null && collapsed.Contains(item.BatchName))
                item.IsExpanded = false;
            else if (item.IsProductRow && item.ProductName != null && collapsedProducts.Contains(item.ProductName))
                item.IsExpanded = false;
        }
    }

    private async Task OnPlantChanged(int? value)
    {
        _selectedPlantId = value;
        await LoadData();
    }

    private async Task OnShowProcessedChanged(Syncfusion.Blazor.Buttons.ChangeEventArgs<bool> args)
    {
        _showProcessed = args.Checked;
        await LoadData();
    }

    private async Task SaveCollapsedAsync(string gridId, HashSet<string> collapsed)
    {
        if (_userId <= 0) return;

        var pref = await DbContext.UserGridPreferences
            .FirstOrDefaultAsync(p => p.UserId == _userId && p.GridId == gridId);

        if (pref == null)
        {
            pref = new UserGridPreference { UserId = _userId, GridId = gridId };
            DbContext.UserGridPreferences.Add(pref);
        }

        pref.CollapsedState = JsonSerializer.Serialize(collapsed);
        await DbContext.SaveChangesAsync();
    }

    private async Task OnOrdersRowCollapsed(RowCollapsedEventArgs<ExportTreeItem> args)
    {
        if (args.Data.IsBatchRow && args.Data.BatchName != null)
        {
            _ordersCollapsed.Add(args.Data.BatchName);
            await SaveCollapsedAsync("OrdersGrid", _ordersCollapsed);
        }
        else if (args.Data.IsProductRow && args.Data.ProductName != null)
        {
            _ordersProductsCollapsed.Add(args.Data.ProductName);
            await SaveCollapsedAsync("OrdersGrid_L2", _ordersProductsCollapsed);
        }
    }

    private async Task OnOrdersRowExpanded(RowExpandedEventArgs<ExportTreeItem> args)
    {
        if (args.Data.IsBatchRow && args.Data.BatchName != null)
        {
            _ordersCollapsed.Remove(args.Data.BatchName);
            await SaveCollapsedAsync("OrdersGrid", _ordersCollapsed);
        }
        else if (args.Data.IsProductRow && args.Data.ProductName != null)
        {
            _ordersProductsCollapsed.Remove(args.Data.ProductName);
            await SaveCollapsedAsync("OrdersGrid_L2", _ordersProductsCollapsed);
        }
    }

    private async Task OnBatchesRowCollapsed(RowCollapsedEventArgs<ExportTreeItem> args)
    {
        if (args.Data.IsBatchRow && args.Data.BatchName != null)
        {
            _batchesCollapsed.Add(args.Data.BatchName);
            await SaveCollapsedAsync("BatchesGrid", _batchesCollapsed);
        }
        else if (args.Data.IsProductRow && args.Data.ProductName != null)
        {
            _batchesProductsCollapsed.Add(args.Data.ProductName);
            await SaveCollapsedAsync("BatchesGrid_L2", _batchesProductsCollapsed);
        }
    }

    private async Task OnBatchesRowExpanded(RowExpandedEventArgs<ExportTreeItem> args)
    {
        if (args.Data.IsBatchRow && args.Data.BatchName != null)
        {
            _batchesCollapsed.Remove(args.Data.BatchName);
            await SaveCollapsedAsync("BatchesGrid", _batchesCollapsed);
        }
        else if (args.Data.IsProductRow && args.Data.ProductName != null)
        {
            _batchesProductsCollapsed.Remove(args.Data.ProductName);
            await SaveCollapsedAsync("BatchesGrid_L2", _batchesProductsCollapsed);
        }
    }

    // Daily Schedule tab: stock items are dimmed (they belong on the Batches tab)
    private void OnMtoRowDataBound(RowDataBoundEventArgs<ExportTreeItem> args)
    {
        if (args.Data.IsBatchRow)
            args.Row.AddClass(new[] { "row-batch" });
        else if (args.Data.IsProductRow)
            args.Row.AddClass(new[] { "row-product" });
        else
        {
            if (args.Data.IsProcessed)
                args.Row.AddClass(new[] { "row-processed" });
            if (!string.IsNullOrWhiteSpace(args.Data.Notes))
                args.Row.AddClass(new[] { "row-has-notes" });
            if (args.Data.IsStock)
                args.Row.AddClass(new[] { "row-dimmed" });
        }
    }

    // Batches tab: non-stock items are dimmed (they belong on the Daily Schedule tab)
    private void OnMtsRowDataBound(RowDataBoundEventArgs<ExportTreeItem> args)
    {
        if (args.Data.IsBatchRow)
            args.Row.AddClass(new[] { "row-batch" });
        else if (args.Data.IsProductRow)
            args.Row.AddClass(new[] { "row-product" });
        else
        {
            if (args.Data.IsProcessed)
                args.Row.AddClass(new[] { "row-processed" });
            if (!string.IsNullOrWhiteSpace(args.Data.Notes))
                args.Row.AddClass(new[] { "row-has-notes" });
            if (!args.Data.IsStock)
                args.Row.AddClass(new[] { "row-dimmed" });
        }
    }
}
