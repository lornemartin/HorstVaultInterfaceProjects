@page "/production/orders"
@attribute [Authorize(Policy = "Nesting")]
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject IHttpContextAccessor HttpContextAccessor
@using HorstMFG.Core.Entities
@using HorstMFG.Infrastructure.Data
@using HorstMFG.Web.Components.Shared
@using Microsoft.EntityFrameworkCore
@using Syncfusion.Blazor.Grids
@using System.Security.Claims

<PageTitle>Orders - HorstMFG</PageTitle>

<style>
    .row-in-project td { font-weight: 600; background-color: #e8f4e8 !important; }
    td.remaining-partial  { background-color: #fff3cd !important; }
    td.remaining-complete { background-color: #00b050 !important; }
    td.remaining-over     { background-color: #f8d7da !important; }
    .qty-input { width: 55px; text-align: right; border: 1px solid transparent; border-radius: 3px; padding: 1px 3px; background: transparent; }
    .qty-input:hover, .qty-input:focus { border-color: #ced4da; background: #fff; outline: none; }
</style>

<h3>Orders</h3>

<NestingPanel ItemType="Order"
              PlantId="_plantId"
              SelectedItems="_selectedForNesting"
              OnCompleted="ReloadAsync" />

<SfGrid @ref="_grid"
        TValue="OrderItemRow" DataSource="_items" ID="ProductionOrdersGrid_v2"
        AllowSorting="true" AllowMultiSorting="true" AllowResizing="true"
        AllowFiltering="true" AllowGrouping="true" AllowReordering="true"
        EnablePersistence="true" Height="600">
    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
    <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Multiple" Mode="Syncfusion.Blazor.Grids.SelectionMode.Row" />
    <GridEvents TValue="OrderItemRow"
                RowSelected="OnRowSelected"
                RowDeselected="OnRowDeselected"
                RowDataBound="OnRowDataBound"
                QueryCellInfo="OnQueryCellInfo" />
    <GridColumns>
        <GridColumn Type="ColumnType.CheckBox" Width="50" />
        <GridColumn Field="@nameof(OrderItemRow.QtyRequired)"    HeaderText="Req'd"      Width="80"  TextAlign="TextAlign.Right">
            <Template>
                @{ var row = (context as OrderItemRow)!; }
                <input type="number" class="qty-input" value="@row.QtyRequired" min="0"
                       @onchange="@(async e => await OnQtyRequiredChangedAsync(row, e.Value?.ToString()))" />
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(OrderItemRow.QtyNested)"      HeaderText="Nested"     Width="80"  TextAlign="TextAlign.Right" />
        <GridColumn Field="@nameof(OrderItemRow.Remaining)"      HeaderText="Remaining"  Width="95"  TextAlign="TextAlign.Right" />
        <GridColumn Field="@nameof(OrderItemRow.FileName)"       HeaderText="File Name"  Width="220" />
        <GridColumn Field="@nameof(OrderItemRow.Description)"    HeaderText="Description" Width="220" />
        <GridColumn Field="@nameof(OrderItemRow.Material)"       HeaderText="Material"   Width="110" />
        <GridColumn Field="@nameof(OrderItemRow.Thickness)"      HeaderText="Thickness"  Width="90"  TextAlign="TextAlign.Right" />
        <GridColumn Field="@nameof(OrderItemRow.OrderNumber)"    HeaderText="Order #"    Width="120" />
        <GridColumn Field="@nameof(OrderItemRow.ScheduleName)"   HeaderText="Schedule"   Width="180" />
        <GridColumn Field="@nameof(OrderItemRow.IsComplete)"     HeaderText="Complete"   Width="95"  DisplayAsCheckBox="true" TextAlign="TextAlign.Center" />
        <GridColumn Field="@nameof(OrderItemRow.Notes)"          HeaderText="Notes"      Width="180" />
    </GridColumns>
</SfGrid>

@code {
    private SfGrid<OrderItemRow>? _grid;
    private List<OrderItemRow> _items = new();
    private List<NestingSelectionItem> _selectedForNesting = new();
    private int _plantId;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var user    = HttpContextAccessor.HttpContext?.User;
        var isAdmin = user?.HasClaim(ClaimTypes.Role, "Admin") ?? false;
        int.TryParse(user?.FindFirst("PlantId")?.Value, out _plantId);

        await using var db = await DbContextFactory.CreateDbContextAsync();

        var query = db.OrderItems.AsQueryable();
        if (!isAdmin && _plantId > 0)
            query = query.Where(i => i.NestOrder.PlantId == _plantId);

        _items = await query
            .Select(i => new OrderItemRow
            {
                Id               = i.Id,
                PartId           = i.PartId,
                RadanIdNumber    = i.RadanIdNumber,
                OrderNumber      = i.NestOrder.ScheduleOrder.OrderNumber,
                ScheduleName     = i.NestOrder.ScheduleOrder.Schedule.Name,
                FileName         = i.Part.FileName,
                Description      = i.Part.Description,
                Material         = i.Part.Material,
                Thickness        = i.Part.Thickness,
                QtyRequired      = i.QtyRequired,
                QtyNested        = i.QtyNested,
                HasBends         = i.Part.HasBends,
                IsInRadanProject = i.IsInRadanProject,
                IsComplete       = i.IsComplete,
                Notes            = i.Notes,
            })
            .OrderBy(i => i.OrderNumber).ThenBy(i => i.FileName)
            .ToListAsync();

        _selectedForNesting.Clear();
    }

    private async Task ReloadAsync()
    {
        await LoadAsync();
        StateHasChanged();
    }

    private async Task OnQtyRequiredChangedAsync(OrderItemRow row, string? value)
    {
        if (!int.TryParse(value, out var qty) || qty < 0) return;
        row.QtyRequired = qty;
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var item = await db.OrderItems.FindAsync(row.Id);
        if (item == null) return;
        item.QtyRequired = qty;
        await db.SaveChangesAsync();
    }

    private void OnRowSelected(RowSelectEventArgs<OrderItemRow> args)
    {
        var row = args.Data;
        if (_selectedForNesting.Any(x => x.ItemId == row.Id)) return;
        _selectedForNesting.Add(new NestingSelectionItem(
            ItemId:          row.Id,
            PartId:          row.PartId,
            FileName:        row.FileName,
            QtyRequired:     row.QtyRequired,
            Material:        row.Material,
            Thickness:       row.Thickness ?? 0m,
            GroupName:        row.OrderNumber,
            RadanIdNumber:    row.RadanIdNumber,
            IsInRadanProject: row.IsInRadanProject,
            Description:      row.Description,
            ScheduleName:     row.ScheduleName,
            BatchName:        null,
            HasBends:         row.HasBends
        ));
    }

    private void OnRowDeselected(RowDeselectEventArgs<OrderItemRow> args)
    {
        _selectedForNesting.RemoveAll(x => x.ItemId == args.Data.Id);
    }

    private void OnRowDataBound(RowDataBoundEventArgs<OrderItemRow> args)
    {
        if (args.Data.IsInRadanProject)
            args.Row.AddClass(new[] { "row-in-project" });
    }

    private void OnQueryCellInfo(QueryCellInfoEventArgs<OrderItemRow> args)
    {
        if (args.Column.Field != nameof(OrderItemRow.Remaining)) return;
        var row = args.Data;
        if (row.QtyNested == 0) return;
        var css = row.QtyNested > row.QtyRequired ? "remaining-over"
                : row.QtyNested == row.QtyRequired ? "remaining-complete"
                : "remaining-partial";
        args.Cell.AddClass(new[] { css });
    }

    private class OrderItemRow
    {
        public int     Id               { get; set; }
        public int     PartId           { get; set; }
        public int?    RadanIdNumber    { get; set; }
        public string? OrderNumber      { get; set; }
        public string? ScheduleName     { get; set; }
        public string? FileName         { get; set; }
        public string? Description      { get; set; }
        public string? Material         { get; set; }
        public decimal? Thickness       { get; set; }
        public int     QtyRequired      { get; set; }
        public int     QtyNested        { get; set; }
        public int     Remaining        => QtyRequired - QtyNested;
        public bool    IsInRadanProject { get; set; }
        public bool    HasBends         { get; set; }
        public bool    IsComplete       { get; set; }
        public string? Notes            { get; set; }
    }
}
