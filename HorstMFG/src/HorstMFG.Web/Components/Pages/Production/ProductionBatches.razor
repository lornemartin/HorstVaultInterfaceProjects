@page "/production/batches"
@attribute [Authorize(Policy = "Nesting")]
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject IHttpContextAccessor HttpContextAccessor
@using HorstMFG.Core.Entities
@using HorstMFG.Infrastructure.Data
@using HorstMFG.Web.Components.Shared
@using Microsoft.EntityFrameworkCore
@using Syncfusion.Blazor.Grids
@using System.Security.Claims

<PageTitle>Batches - HorstMFG</PageTitle>

<style>
    .row-in-project td { font-weight: 600; background-color: #e8f4e8 !important; }
    td.remaining-partial  { background-color: #fff3cd !important; }
    td.remaining-complete { background-color: #00b050 !important; }
    td.remaining-over     { background-color: #f8d7da !important; }
    .qty-input { width: 55px; text-align: right; border: 1px solid transparent; border-radius: 3px; padding: 1px 3px; background: transparent; }
    .qty-input:hover, .qty-input:focus { border-color: #ced4da; background: #fff; outline: none; }
</style>

<h3>Batches</h3>

<NestingPanel ItemType="Batch"
              PlantId="_plantId"
              SelectedItems="_selectedForNesting"
              OnCompleted="ReloadAsync" />

<SfGrid @ref="_grid"
        TValue="BatchItemRow" DataSource="_items" ID="ProductionBatchesGrid_v2"
        AllowSorting="true" AllowMultiSorting="true" AllowResizing="true"
        AllowFiltering="true" AllowGrouping="true" AllowReordering="true"
        EnablePersistence="true" Height="600">
    <GridTemplates>
        <DetailTemplate>
            @{
                var row = (context as BatchItemRow)!;
            }
            <div style="display:flex; gap:1.5rem; padding:.75rem; align-items:flex-start;">
                <img src="/api/thumbnails/part/@row.PartId" loading="lazy"
                     style="height:140px; object-fit:contain; border:1px solid #dee2e6; border-radius:4px; background:#fafafa; flex-shrink:0;"
                     onerror="this.style.display='none'" />
                @if (row.Nests.Any())
                {
                    <table class="table table-sm table-bordered mb-0" style="width:auto;">
                        <thead>
                            <tr><th>Nest</th><th class="text-end">Qty</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var nest in row.Nests)
                            {
                                <tr>
                                    <td>@nest.NestName</td>
                                    <td class="text-end">@nest.Qty</td>
                                    <td>
                                        <img src="/api/thumbnails/nest/@nest.NestId" loading="lazy"
                                             style="height:64px; object-fit:contain;"
                                             onerror="this.style.display='none'" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <span style="color:#9ca3af; font-size:.85em; align-self:center;">No nests yet.</span>
                }
            </div>
        </DetailTemplate>
    </GridTemplates>
    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
    <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Multiple" Mode="Syncfusion.Blazor.Grids.SelectionMode.Row" />
    <GridEvents TValue="BatchItemRow"
                RowSelected="OnRowSelected"
                RowDeselected="OnRowDeselected"
                RowDataBound="OnRowDataBound"
                QueryCellInfo="OnQueryCellInfo" />
    <GridColumns>
        <GridColumn Type="ColumnType.CheckBox" Width="50" />
        <GridColumn HeaderText="" Width="68" AllowSorting="false" AllowFiltering="false" AllowGrouping="false" AllowReordering="false">
            <Template>
                @{ var row = (context as BatchItemRow)!; }
                <img src="/api/thumbnails/part/@row.PartId" loading="lazy"
                     style="height:42px; object-fit:contain; display:block; margin:auto;"
                     onerror="this.style.display='none'" />
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(BatchItemRow.QtyRequired)"    HeaderText="Req'd"      Width="80"  TextAlign="TextAlign.Right">
            <Template>
                @{ var row = (context as BatchItemRow)!; }
                <input type="number" class="qty-input" value="@row.QtyRequired" min="0"
                       @onchange="@(async e => await OnQtyRequiredChangedAsync(row, e.Value?.ToString()))" />
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(BatchItemRow.QtyNested)"      HeaderText="Nested"     Width="80"  TextAlign="TextAlign.Right" />
        <GridColumn Field="@nameof(BatchItemRow.Remaining)"      HeaderText="Remaining"  Width="95"  TextAlign="TextAlign.Right" />
        <GridColumn Field="@nameof(BatchItemRow.FileName)"       HeaderText="File Name"  Width="220" />
        <GridColumn Field="@nameof(BatchItemRow.Description)"    HeaderText="Description" Width="220" />
        <GridColumn Field="@nameof(BatchItemRow.Material)"       HeaderText="Material"   Width="110" />
        <GridColumn Field="@nameof(BatchItemRow.Thickness)"      HeaderText="Thickness"  Width="90"  TextAlign="TextAlign.Right" />
        <GridColumn Field="@nameof(BatchItemRow.BatchName)"      HeaderText="Batch"      Width="180" />
        <GridColumn Field="@nameof(BatchItemRow.IsComplete)"     HeaderText="Complete"   Width="95"  DisplayAsCheckBox="true" TextAlign="TextAlign.Center" />
        <GridColumn Field="@nameof(BatchItemRow.Notes)"          HeaderText="Notes"      Width="180" />
    </GridColumns>
</SfGrid>

@code {
    private SfGrid<BatchItemRow>? _grid;
    private List<BatchItemRow> _items = new();
    private List<NestingSelectionItem> _selectedForNesting = new();
    private int _plantId;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var user    = HttpContextAccessor.HttpContext?.User;
        var isAdmin = user?.HasClaim(ClaimTypes.Role, "Admin") ?? false;
        int.TryParse(user?.FindFirst("PlantId")?.Value, out _plantId);

        await using var db = await DbContextFactory.CreateDbContextAsync();

        var query = db.BatchItems.AsQueryable();
        if (!isAdmin && _plantId > 0)
            query = query.Where(i => i.NestBatch.PlantId == _plantId);

        _items = await query
            .Select(i => new BatchItemRow
            {
                Id               = i.Id,
                PartId           = i.PartId,
                RadanIdNumber    = i.RadanIdNumber,
                BatchName        = i.NestBatch.Batch.Name,
                FileName         = i.Part.FileName,
                Description      = i.Part.Description,
                Material         = i.Part.Material,
                Thickness        = i.Part.Thickness,
                QtyRequired      = i.QtyRequired,
                QtyNested        = i.QtyNested,
                HasBends         = i.Part.HasBends,
                IsInRadanProject = i.IsInRadanProject,
                IsComplete       = i.IsComplete,
                Notes            = i.Notes,
            })
            .OrderBy(i => i.BatchName).ThenBy(i => i.FileName)
            .ToListAsync();

        // Load nest associations for all visible items
        var itemIds = _items.Select(i => i.Id).ToList();
        if (itemIds.Any())
        {
            var nestData = await db.NestedParts
                .Where(np => np.BatchItemId.HasValue && itemIds.Contains(np.BatchItemId.Value))
                .Select(np => new {
                    BatchItemId = np.BatchItemId!.Value,
                    NestId      = np.NestId,
                    NestName    = np.Nest.NestName,
                    Qty         = np.Qty,
                })
                .ToListAsync();

            var lookup = nestData
                .GroupBy(n => n.BatchItemId)
                .ToDictionary(g => g.Key, g => g.Select(n => new NestInfoRow
                {
                    NestId   = n.NestId,
                    NestName = n.NestName,
                    Qty      = n.Qty,
                }).ToList());

            foreach (var item in _items)
                if (lookup.TryGetValue(item.Id, out var nests))
                    item.Nests = nests;
        }

        _selectedForNesting.Clear();
    }

    private async Task ReloadAsync()
    {
        await LoadAsync();
        StateHasChanged();
    }

    private async Task OnQtyRequiredChangedAsync(BatchItemRow row, string? value)
    {
        if (!int.TryParse(value, out var qty) || qty < 0) return;
        row.QtyRequired = qty;
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var item = await db.BatchItems.FindAsync(row.Id);
        if (item == null) return;
        item.QtyRequired = qty;
        await db.SaveChangesAsync();
    }

    private void OnRowSelected(RowSelectEventArgs<BatchItemRow> args)
    {
        var row = args.Data;
        if (_selectedForNesting.Any(x => x.ItemId == row.Id)) return;
        _selectedForNesting.Add(new NestingSelectionItem(
            ItemId:          row.Id,
            PartId:          row.PartId,
            FileName:        row.FileName,
            QtyRequired:     row.QtyRequired,
            Material:        row.Material,
            Thickness:       row.Thickness ?? 0m,
            GroupName:        row.BatchName,
            RadanIdNumber:    row.RadanIdNumber,
            IsInRadanProject: row.IsInRadanProject,
            Description:      row.Description,
            ScheduleName:     null,
            BatchName:        row.BatchName,
            HasBends:         row.HasBends
        ));
    }

    private void OnRowDeselected(RowDeselectEventArgs<BatchItemRow> args)
    {
        _selectedForNesting.RemoveAll(x => x.ItemId == args.Data.Id);
    }

    private void OnRowDataBound(RowDataBoundEventArgs<BatchItemRow> args)
    {
        if (args.Data.IsInRadanProject)
            args.Row.AddClass(new[] { "row-in-project" });
    }

    private void OnQueryCellInfo(QueryCellInfoEventArgs<BatchItemRow> args)
    {
        if (args.Column.Field != nameof(BatchItemRow.Remaining)) return;
        var row = args.Data;
        if (row.QtyNested == 0) return;
        var css = row.QtyNested > row.QtyRequired ? "remaining-over"
                : row.QtyNested == row.QtyRequired ? "remaining-complete"
                : "remaining-partial";
        args.Cell.AddClass(new[] { css });
    }

    private class BatchItemRow
    {
        public int     Id               { get; set; }
        public int     PartId           { get; set; }
        public int?    RadanIdNumber    { get; set; }
        public string? BatchName        { get; set; }
        public string? FileName         { get; set; }
        public string? Description      { get; set; }
        public string? Material         { get; set; }
        public decimal? Thickness       { get; set; }
        public int     QtyRequired      { get; set; }
        public int     QtyNested        { get; set; }
        public int     Remaining        => QtyRequired - QtyNested;
        public bool    IsInRadanProject { get; set; }
        public bool    HasBends         { get; set; }
        public bool    IsComplete       { get; set; }
        public string? Notes            { get; set; }
        public List<NestInfoRow> Nests  { get; set; } = new();
    }

    private class NestInfoRow
    {
        public int    NestId   { get; set; }
        public string NestName { get; set; } = "";
        public int    Qty      { get; set; }
    }
}
