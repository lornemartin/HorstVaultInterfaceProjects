@page "/production/batches"
@attribute [Authorize(Policy = "Nesting")]
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject IHttpContextAccessor HttpContextAccessor
@inject IConfiguration Configuration
@inject ProtectedLocalStorage LocalStorage
@inject IJSRuntime JS
@inject HorstMFG.Web.Services.LocalStorageService LocalSvc
@using HorstMFG.Core.Entities
@using HorstMFG.Infrastructure.Data
@using HorstMFG.Web.Components.Shared
@using Microsoft.EntityFrameworkCore
@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.Grids
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using System.Security.Claims
@implements IAsyncDisposable

<PageTitle>Batches - HorstMFG</PageTitle>

<style>
    .row-in-project td { font-weight: 600; background-color: #e8f4e8 !important; }
    td.remaining-partial  { background-color: #fff3cd !important; }
    td.remaining-complete { background-color: #00b050 !important; }
    td.remaining-over     { background-color: #f8d7da !important; }
    .qty-input { width: 55px; text-align: right; border: 1px solid transparent; border-radius: 3px; padding: 1px 3px; background: transparent; }
    .qty-input:hover, .qty-input:focus { border-color: #ced4da; background: #fff; outline: none; }
</style>

<h3>Batches</h3>

<NestingPanel ItemType="Batch"
              PlantId="_plantId"
              StationId="_stationId"
              SelectedItems="_selectedForNesting"
              OnCompleted="ReloadAsync" />

<div style="display:flex; align-items:center; gap:.75rem; margin-bottom:.75rem; flex-wrap:wrap;">
    <label style="font-size:.9em; color:#374151; margin:0;">From</label>
    <SfDatePicker TValue="DateTime?" @bind-Value="_fromDate" Format="yyyy-MM-dd" Width="140px" />
    <label style="font-size:.9em; color:#374151; margin:0;">To</label>
    <SfDatePicker TValue="DateTime?" @bind-Value="_toDate" Format="yyyy-MM-dd" Width="140px" Placeholder="today" />
    <button class="btn btn-sm btn-primary" @onclick="ReloadAsync">Load</button>
    <label style="font-size:.9em; color:#374151; margin:0; display:flex; align-items:center; gap:.35rem; cursor:pointer;">
        <input type="checkbox" checked="@_hideComplete" @onchange="OnHideCompleteChanged" />
        Hide fully nested
    </label>
    @if (_items.Count > 0)
    {
        <span style="font-size:.8em; color:#6b7280;">@_items.Count rows</span>
    }
</div>

<SfGrid @ref="_grid"
        TValue="BatchItemRow" DataSource="_items" ID="ProductionBatchesGrid_v3"
        AllowSorting="true" AllowMultiSorting="true" AllowResizing="true"
        AllowFiltering="true" AllowGrouping="true" AllowReordering="true"
        AllowPaging="true" EnablePersistence="true" Height="600">
    <GridPageSettings PageSize="100" PageSizes="@(new int[]{50,100,200,500})" />
    <GridTemplates>
        <DetailTemplate>
            @{
                var row = (context as BatchItemRow)!;
            }
            <div style="display:flex; gap:1.5rem; padding:.75rem; align-items:flex-start;">
                <img src="/api/thumbnails/part/@row.PartId?v=@_thumbnailVersion" loading="lazy"
                     style="height:140px; object-fit:contain; border:1px solid #dee2e6; border-radius:4px; background:#fafafa; flex-shrink:0;"
                     onerror="this.style.display='none'" />
                @if (row.Nests.Any())
                {
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:.6rem;">
                        @foreach (var nest in row.Nests)
                        {
                            <div style="border:1px solid #dee2e6; border-radius:4px; padding:.5rem; display:flex; gap:.6rem; align-items:flex-start; background:#fff;">
                                <img src="/api/thumbnails/nest/@nest.NestId?v=@_thumbnailVersion" loading="lazy"
                                     style="height:80px; object-fit:contain; flex-shrink:0;"
                                     onerror="this.style.display='none'" />
                                <div>
                                    <div style="font-weight:600; font-size:.9em;">@nest.NestName</div>
                                    @if (!string.IsNullOrEmpty(nest.NestPath))
                                    {
                                        <div style="font-size:.75em; color:#6b7280; word-break:break-all;">@nest.NestPath</div>
                                    }
                                    <div style="font-size:.85em; margin-top:.2rem;">Qty: <strong>@nest.Qty</strong></div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <span style="color:#9ca3af; font-size:.85em; align-self:center;">No nests yet.</span>
                }
            </div>
        </DetailTemplate>
    </GridTemplates>
    <GridGroupSettings ShowGroupedColumn="false" EnableLazyLoading="true">
        <CaptionTemplate>
            @{
                var ctx = context as CaptionTemplateContext;
                var keyStr = ctx!.Key?.ToString() ?? "";
            }
            <span data-group-key="@keyStr" data-group-level="1" style="display:none;"></span>
            <span style="font-weight:600;">@keyStr</span>
            <span style="margin-left:.5rem; color:#6b7280; font-size:.8rem;">(@ctx.Count)</span>
        </CaptionTemplate>
    </GridGroupSettings>
    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel" />
    <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Multiple" Mode="Syncfusion.Blazor.Grids.SelectionMode.Row" />
    <GridEvents TValue="BatchItemRow"
                RowSelected="OnRowSelected"
                RowDeselected="OnRowDeselected"
                RowDataBound="OnRowDataBound"
                QueryCellInfo="OnQueryCellInfo" />
    <GridColumns>
        <GridColumn Type="ColumnType.CheckBox" Width="50" />
        <GridColumn HeaderText="" Width="68" AllowSorting="false" AllowFiltering="false" AllowGrouping="false" AllowReordering="false">
            <Template>
                @{ var row = (context as BatchItemRow)!; }
                <img src="/api/thumbnails/part/@row.PartId?v=@_thumbnailVersion" loading="lazy"
                     style="height:42px; object-fit:contain; display:block; margin:auto;"
                     onerror="this.style.display='none'" />
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(BatchItemRow.QtyRequired)"    HeaderText="Req'd"      Width="80"  TextAlign="TextAlign.Right">
            <Template>
                @{ var row = (context as BatchItemRow)!; }
                <input type="number" class="qty-input" value="@row.QtyRequired" min="0"
                       @onchange="@(async e => await OnQtyRequiredChangedAsync(row, e.Value?.ToString()))" />
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(BatchItemRow.QtyNested)"      HeaderText="Nested"     Width="80"  TextAlign="TextAlign.Right" />
        <GridColumn Field="@nameof(BatchItemRow.Remaining)"      HeaderText="Remaining"  Width="95"  TextAlign="TextAlign.Right" />
        <GridColumn Field="@nameof(BatchItemRow.FileName)"       HeaderText="File Name"  Width="220" />
        <GridColumn Field="@nameof(BatchItemRow.Description)"    HeaderText="Description" Width="220" />
        <GridColumn Field="@nameof(BatchItemRow.Material)"       HeaderText="Material"   Width="110" />
        <GridColumn Field="@nameof(BatchItemRow.Thickness)"      HeaderText="Thickness"  Width="90"  TextAlign="TextAlign.Right" />
        <GridColumn Field="@nameof(BatchItemRow.BatchName)"      HeaderText="Batch"      Width="180" />
        <GridColumn Field="@nameof(BatchItemRow.IsComplete)"     HeaderText="Complete"   Width="95"  DisplayAsCheckBox="true" TextAlign="TextAlign.Center" />
        <GridColumn Field="@nameof(BatchItemRow.Notes)"          HeaderText="Notes"      Width="180" />
    </GridColumns>
</SfGrid>

@code {
    private SfGrid<BatchItemRow>? _grid;
    private List<BatchItemRow> _items = new();
    private List<NestingSelectionItem> _selectedForNesting = new();
    private int  _plantId;
    private int? _stationId;
    private DateTime? _fromDate = DateTime.Today.AddDays(-90);
    private DateTime? _toDate;
    private bool _hideComplete;
    private HashSet<string> _expandedGroupKeys = new();
    private DotNetObjectReference<ProductionBatches>? _dotNetRef;
    private long _thumbnailVersion = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();

    // Load is deferred to OnAfterRenderAsync so we can read stored dates first.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var from = await LocalStorage.GetAsync<DateTime?>("prod-batches-from");
            var to   = await LocalStorage.GetAsync<DateTime?>("prod-batches-to");
            var hide = await LocalStorage.GetAsync<bool>("prod-batches-hide-complete");
            if (from.Success) _fromDate     = from.Value;
            if (to.Success)   _toDate       = to.Value;
            if (hide.Success) _hideComplete = hide.Value;
        }
        catch { }
        _dotNetRef = DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("horstGrid.watchStringExpansion", "ProductionBatchesGrid_v3", _dotNetRef); }
        catch (JSException) { }
        var savedKeys = await LocalSvc.GetAsync<List<string>>("prod-batches-expanded-groups");
        if (savedKeys?.Count > 0) _expandedGroupKeys = savedKeys.ToHashSet();
        await LoadAsync();
        StateHasChanged();
        await RestoreExpansionAsync();
    }

    private async Task LoadAsync()
    {
        var user    = HttpContextAccessor.HttpContext?.User;
        var isAdmin = user?.HasClaim(ClaimTypes.Role, "Admin") ?? false;
        int.TryParse(user?.FindFirst("PlantId")?.Value, out _plantId);
        if (int.TryParse(user?.FindFirst("StationId")?.Value, out var sid)) _stationId = sid;

        await using var db = await DbContextFactory.CreateDbContextAsync();

        var query = db.BatchItems.AsQueryable();

        if (!isAdmin && _plantId > 0)
            query = query.Where(i => i.NestBatch.PlantId == _plantId);

        if (_fromDate.HasValue)
            query = query.Where(i => i.NestBatch.EntryDate >= _fromDate.Value.ToUniversalTime());

        if (_toDate.HasValue)
            query = query.Where(i => i.NestBatch.EntryDate < _toDate.Value.AddDays(1).ToUniversalTime());

        if (_hideComplete)
            query = query.Where(i => i.QtyRequired > i.QtyNested);

        _items = await query
            .Select(i => new BatchItemRow
            {
                Id               = i.Id,
                PartId           = i.PartId,
                RadanIdNumber    = i.RadanIdNumber,
                BatchName        = i.NestBatch.Batch.Name,
                FileName         = i.Part.FileName,
                Description      = i.Part.Description,
                Material         = i.Part.Material,
                Thickness        = i.Part.Thickness,
                QtyRequired      = i.QtyRequired,
                QtyNested        = i.QtyNested,
                HasBends         = i.Part.HasBends,
                IsInRadanProject = i.IsInRadanProject,
                IsComplete       = i.IsComplete,
                Notes            = i.Notes,
            })
            .OrderBy(i => i.BatchName).ThenBy(i => i.FileName)
            .ToListAsync();

        // Load nest associations only for the items we just fetched
        var itemIds = _items.Select(i => i.Id).ToList();
        if (itemIds.Count > 0)
        {
            var nestData = await db.NestedParts
                .Where(np => np.BatchItemId.HasValue && itemIds.Contains(np.BatchItemId.Value))
                .Select(np => new {
                    BatchItemId = np.BatchItemId!.Value,
                    NestId      = np.NestId,
                    NestName    = np.Nest.NestName,
                    NestPath    = np.Nest.NestPath,
                    Qty         = np.Qty,
                })
                .ToListAsync();

            var nestRoot = Configuration["FileSystemPaths:RadanProjectsRootPath"] ?? "";
            var lookup = nestData
                .GroupBy(n => n.BatchItemId)
                .ToDictionary(g => g.Key, g => g.Select(n => new NestInfoRow
                {
                    NestId   = n.NestId,
                    NestName = n.NestName,
                    NestPath = StripRoot(n.NestPath, nestRoot),
                    Qty      = n.Qty,
                }).ToList());

            foreach (var item in _items)
                if (lookup.TryGetValue(item.Id, out var nests))
                    item.Nests = nests;
        }

        _selectedForNesting.Clear();
    }

    private async Task ReloadAsync()
    {
        try
        {
            await LocalStorage.SetAsync("prod-batches-from", _fromDate);
            await LocalStorage.SetAsync("prod-batches-to", _toDate);
            await LocalStorage.SetAsync("prod-batches-hide-complete", _hideComplete);
        }
        catch { }
        _thumbnailVersion = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        await LoadAsync();
        StateHasChanged();
        await RestoreExpansionAsync();
    }

    private async Task OnHideCompleteChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _hideComplete = (bool)(e.Value ?? false);
        await ReloadAsync();
    }

    private async Task OnQtyRequiredChangedAsync(BatchItemRow row, string? value)
    {
        if (!int.TryParse(value, out var qty) || qty < 0) return;
        row.QtyRequired = qty;
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var item = await db.BatchItems.FindAsync(row.Id);
        if (item == null) return;
        item.QtyRequired = qty;
        await db.SaveChangesAsync();
    }

    private void OnRowSelected(RowSelectEventArgs<BatchItemRow> args)
    {
        var row = args.Data;
        if (_selectedForNesting.Any(x => x.ItemId == row.Id)) return;
        _selectedForNesting.Add(new NestingSelectionItem(
            ItemId:          row.Id,
            PartId:          row.PartId,
            FileName:        row.FileName,
            QtyRequired:     row.QtyRequired,
            Material:        row.Material,
            Thickness:       row.Thickness ?? 0m,
            GroupName:        row.BatchName,
            RadanIdNumber:    row.RadanIdNumber,
            IsInRadanProject: row.IsInRadanProject,
            Description:      row.Description,
            ScheduleName:     null,
            BatchName:        row.BatchName,
            HasBends:         row.HasBends
        ));
    }

    private void OnRowDeselected(RowDeselectEventArgs<BatchItemRow> args)
    {
        _selectedForNesting.RemoveAll(x => x.ItemId == args.Data.Id);
    }

    private void OnRowDataBound(RowDataBoundEventArgs<BatchItemRow> args)
    {
        if (args.Data.IsInRadanProject)
            args.Row.AddClass(new[] { "row-in-project" });
    }

    private void OnQueryCellInfo(QueryCellInfoEventArgs<BatchItemRow> args)
    {
        if (args.Column.Field != nameof(BatchItemRow.Remaining)) return;
        var row = args.Data;
        if (row.QtyNested == 0) return;
        var css = row.QtyNested > row.QtyRequired ? "remaining-over"
                : row.QtyNested == row.QtyRequired ? "remaining-complete"
                : "remaining-partial";
        args.Cell.AddClass(new[] { css });
    }

    [JSInvokable]
    public async Task UpdateGroupExpansionState(List<string> keys)
    {
        _expandedGroupKeys = keys.ToHashSet();
        await LocalSvc.SetAsync("prod-batches-expanded-groups", keys);
    }

    private async Task RestoreExpansionAsync()
    {
        if (_expandedGroupKeys.Count == 0) return;
        try
        {
            await JS.InvokeVoidAsync("horstGrid.restoreStringExpansion",
                "ProductionBatchesGrid_v3", _expandedGroupKeys.ToList());
        }
        catch (JSException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        await ValueTask.CompletedTask;
    }

    private class BatchItemRow
    {
        public int     Id               { get; set; }
        public int     PartId           { get; set; }
        public int?    RadanIdNumber    { get; set; }
        public string? BatchName        { get; set; }
        public string? FileName         { get; set; }
        public string? Description      { get; set; }
        public string? Material         { get; set; }
        public decimal? Thickness       { get; set; }
        public int     QtyRequired      { get; set; }
        public int     QtyNested        { get; set; }
        public int     Remaining        => QtyRequired - QtyNested;
        public bool    IsInRadanProject { get; set; }
        public bool    HasBends         { get; set; }
        public bool    IsComplete       { get; set; }
        public string? Notes            { get; set; }
        public List<NestInfoRow> Nests  { get; set; } = new();
    }

    private static string? StripRoot(string? path, string root)
    {
        if (string.IsNullOrEmpty(path) || string.IsNullOrEmpty(root)) return path;
        if (path.StartsWith(root, StringComparison.OrdinalIgnoreCase))
            return path[root.Length..].TrimStart('\\', '/');
        return path;
    }

    private class NestInfoRow
    {
        public int     NestId   { get; set; }
        public string  NestName { get; set; } = "";
        public string? NestPath { get; set; }
        public int     Qty      { get; set; }
    }
}
