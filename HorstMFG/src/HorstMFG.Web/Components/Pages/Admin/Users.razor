@page "/admin/users"
@attribute [Authorize(Policy = "Admin")]
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@using HorstMFG.Core.Entities
@using HorstMFG.Core.Enums
@using HorstMFG.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.DropDowns

<PageTitle>User Management - HorstMFG</PageTitle>

<h3>User Management</h3>

<div style="margin-bottom: 1rem;">
    <SfButton CssClass="e-primary" OnClick="OpenAddDialog">Add User</SfButton>
</div>

<SfGrid TValue="UserRow" DataSource="_users" AllowSorting="true" AllowResizing="true" Height="500">
    <GridEvents TValue="UserRow" OnRecordDoubleClick="OnRowDoubleClick" />
    <GridColumns>
        <GridColumn Field="@nameof(UserRow.FullName)"    HeaderText="Full Name"  Width="200" />
        <GridColumn Field="@nameof(UserRow.UserName)"    HeaderText="Username"   Width="160" />
        <GridColumn Field="@nameof(UserRow.PlantName)"   HeaderText="Plant"      Width="140" />
        <GridColumn Field="@nameof(UserRow.StationName)" HeaderText="Station"    Width="160" />
        <GridColumn Field="@nameof(UserRow.RoleNames)"   HeaderText="Roles"      Width="220" />
        <GridColumn Field="@nameof(UserRow.IsActive)"    HeaderText="Active"     Width="90"  DisplayAsCheckBox="true" TextAlign="TextAlign.Center" />
    </GridColumns>
</SfGrid>

@if (_error is not null)
{
    <div style="color:red; margin-top:0.5rem;">@_error</div>
}

<!-- Add / Edit dialog -->
<SfDialog @ref="_dialog" Width="480px" IsModal="true" ShowCloseIcon="true"
          Header="@(_editId is null ? "Add User" : "Edit User")"
          Visible="false">
    <DialogEvents Closed="ResetForm" />
    <DialogTemplates>
        <Content>
            <div style="display:flex; flex-direction:column; gap:0.75rem; padding:0.5rem 0;">

                <div>
                    <label class="form-label">Full Name</label>
                    <input class="form-control" @bind="_form.FullName" />
                </div>

                <div>
                    <label class="form-label">Username</label>
                    <input class="form-control" @bind="_form.UserName" autocomplete="off" />
                </div>

                <div>
                    <label class="form-label">Password @(_editId is not null ? "(leave blank to keep current)" : "")</label>
                    <input class="form-control" type="password" @bind="_form.Password" autocomplete="new-password" />
                </div>

                <div>
                    <label class="form-label">Plant</label>
                    <SfDropDownList TValue="int" TItem="PlantOption" DataSource="_plants"
                                    @bind-Value="_form.PlantId">
                        <DropDownListFieldSettings Text="Name" Value="Id" />
                    </SfDropDownList>
                </div>

                <div>
                    <label class="form-label">Nesting Station <span style="font-weight:400; color:#6b7280;">(optional)</span></label>
                    <SfDropDownList TValue="int?" TItem="StationOption" DataSource="_stations"
                                    @bind-Value="_form.StationId" Placeholder="None">
                        <DropDownListFieldSettings Text="Name" Value="Id" />
                    </SfDropDownList>
                </div>

                <div>
                    <label class="form-label">Roles</label>
                    <div style="display:flex; flex-direction:column; gap:0.25rem; margin-top:0.25rem;">
                        @foreach (var role in _allRoles)
                        {
                            <SfCheckBox Label="@role.ToString()" Checked="_form.Roles.Contains(role)"
                                        CheckedChanged="@((bool v) => ToggleRole(role, v))" TChecked="bool" />
                        }
                    </div>
                </div>

                <div>
                    <SfCheckBox Label="Active" @bind-Checked="_form.IsActive" TChecked="bool" />
                </div>

                @if (_dialogError is not null)
                {
                    <div style="color:red; font-size:0.85rem;">@_dialogError</div>
                }
            </div>
        </Content>
        <FooterTemplate>
            <SfButton CssClass="e-primary" OnClick="SaveUser">Save</SfButton>
            <SfButton OnClick="@(() => _dialog!.HideAsync())" style="margin-left: 8px;">Cancel</SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    // ── Data ─────────────────────────────────────────────────────────────────

    private List<UserRow>     _users    = new();
    private List<PlantOption>   _plants   = new();
    private List<StationOption> _stations = new();
    private string? _error;

    private static readonly UserRoleType[] _allRoles =
        Enum.GetValues<UserRoleType>();

    // ── Dialog state ─────────────────────────────────────────────────────────

    private SfDialog? _dialog;
    private int? _editId;
    private UserForm _form = new();
    private string? _dialogError;

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        _plants = await db.Plants
            .OrderBy(p => p.Name)
            .Select(p => new PlantOption(p.Id, p.Name))
            .ToListAsync();
        _stations = await db.NestingStations
            .OrderBy(s => s.Name)
            .Select(s => new StationOption(s.Id, s.Name))
            .ToListAsync();
        await LoadUsersAsync(db);
    }

    private async Task LoadUsersAsync(ApplicationDbContext db)
    {
        var raw = await db.Users
            .Include(u => u.Roles)
            .Include(u => u.Plant)
            .OrderBy(u => u.FullName)
            .ToListAsync();

        var stationNames = _stations.ToDictionary(s => s.Id, s => s.Name);
        _users = raw.Select(u => new UserRow
        {
            Id          = u.Id,
            FullName    = u.FullName,
            UserName    = u.UserName,
            PlantName   = u.Plant.Name,
            StationName = u.StationId.HasValue && stationNames.TryGetValue(u.StationId.Value, out var sn) ? sn : "",
            RoleNames   = string.Join(", ", u.Roles.OrderBy(r => r.RoleName).Select(r => r.RoleName.ToString())),
            IsActive    = u.IsActive,
        }).ToList();
    }

    // ── Grid interaction ─────────────────────────────────────────────────────

    private async Task OnRowDoubleClick(RecordDoubleClickEventArgs<UserRow> args)
    {
        await OpenEditDialog(args.RowData.Id);
    }

    // ── Dialog helpers ────────────────────────────────────────────────────────

    private async Task OpenAddDialog()
    {
        _editId = null;
        _form = new UserForm { PlantId = _plants.FirstOrDefault()?.Id ?? 0 };
        _dialogError = null;
        await _dialog!.ShowAsync();
    }

    private async Task OpenEditDialog(int userId)
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var user = await db.Users.Include(u => u.Roles).FirstOrDefaultAsync(u => u.Id == userId);
        if (user is null) return;

        _editId = userId;
        _form = new UserForm
        {
            FullName  = user.FullName,
            UserName  = user.UserName,
            PlantId   = user.PlantId,
            StationId = user.StationId,
            IsActive  = user.IsActive,
            Roles     = user.Roles.Select(r => r.RoleName).ToHashSet(),
        };
        _dialogError = null;
        await _dialog!.ShowAsync();
    }

    private void ToggleRole(UserRoleType role, bool enabled)
    {
        if (enabled) _form.Roles.Add(role);
        else         _form.Roles.Remove(role);
    }

    private void ResetForm()
    {
        _editId = null;
        _form = new();
        _dialogError = null;
    }

    private async Task SaveUser()
    {
        _dialogError = null;

        if (string.IsNullOrWhiteSpace(_form.FullName))  { _dialogError = "Full name is required."; return; }
        if (string.IsNullOrWhiteSpace(_form.UserName))  { _dialogError = "Username is required."; return; }
        if (_editId is null && string.IsNullOrWhiteSpace(_form.Password)) { _dialogError = "Password is required for new users."; return; }
        if (_form.PlantId == 0)                          { _dialogError = "Plant is required."; return; }
        if (_form.Roles.Count == 0)                      { _dialogError = "At least one role is required."; return; }

        try
        {
            await using var db = await DbContextFactory.CreateDbContextAsync();

            // Check for duplicate username
            var duplicate = await db.Users.AnyAsync(u => u.UserName == _form.UserName.Trim() && u.Id != (_editId ?? -1));
            if (duplicate) { _dialogError = "That username is already taken."; return; }

            if (_editId is null)
            {
                // Create
                var user = new ApplicationUser
                {
                    FullName     = _form.FullName.Trim(),
                    UserName     = _form.UserName.Trim(),
                    PasswordHash = BCrypt.Net.BCrypt.HashPassword(_form.Password),
                    PlantId      = _form.PlantId,
                    StationId    = _form.StationId,
                    IsActive     = _form.IsActive,
                };
                db.Users.Add(user);
                await db.SaveChangesAsync();
                foreach (var role in _form.Roles)
                    db.Set<UserRole>().Add(new UserRole { UserId = user.Id, RoleName = role });
            }
            else
            {
                // Edit
                var user = await db.Users.Include(u => u.Roles).FirstAsync(u => u.Id == _editId);
                user.FullName  = _form.FullName.Trim();
                user.UserName  = _form.UserName.Trim();
                user.PlantId   = _form.PlantId;
                user.StationId = _form.StationId;
                user.IsActive  = _form.IsActive;
                if (!string.IsNullOrWhiteSpace(_form.Password))
                    user.PasswordHash = BCrypt.Net.BCrypt.HashPassword(_form.Password);

                // Replace roles
                db.Set<UserRole>().RemoveRange(user.Roles);
                foreach (var role in _form.Roles)
                    db.Set<UserRole>().Add(new UserRole { UserId = user.Id, RoleName = role });
            }

            await db.SaveChangesAsync();
            await LoadUsersAsync(db);
            await _dialog!.HideAsync();
        }
        catch (Exception ex)
        {
            _dialogError = ex.Message;
        }
    }

    // ── Models ────────────────────────────────────────────────────────────────

    private record UserRow
    {
        public int    Id          { get; init; }
        public string FullName    { get; init; } = "";
        public string UserName    { get; init; } = "";
        public string PlantName   { get; init; } = "";
        public string StationName { get; init; } = "";
        public string RoleNames   { get; init; } = "";
        public bool   IsActive    { get; init; }
    }

    private record PlantOption(int Id, string Name);
    private record StationOption(int Id, string Name);

    private class UserForm
    {
        public string FullName  { get; set; } = "";
        public string UserName  { get; set; } = "";
        public string Password  { get; set; } = "";
        public int    PlantId   { get; set; }
        public int?   StationId { get; set; }
        public bool   IsActive  { get; set; } = true;
        public HashSet<UserRoleType> Roles { get; set; } = new();
    }
}
