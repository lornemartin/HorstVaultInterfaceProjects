@page "/engineering/batches"
@attribute [Authorize(Policy = "Engineering")]
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JS
@inject IBomService BomService
@inject HorstMFG.Web.Services.ExcelBatchImportService BatchImportSvc
@inject Microsoft.AspNetCore.SignalR.IHubContext<HorstMFG.Web.Hubs.BridgeHub> HubContext
@inject HorstMFG.Web.Services.LocalStorageService LocalStorage
@using HorstMFG.Core.DTOs
@using HorstMFG.Infrastructure.Data
@using Microsoft.Extensions.Logging
@inject ILogger<Batches> Logger
@using HorstMFG.Web.Hubs
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.Popups
@implements IAsyncDisposable

<PageTitle>Batches - HorstMFG</PageTitle>

@if (_releasing)
{
    <div class="loading-overlay">
        <div class="spinner"></div>
        <span class="spinner-label">Releasing to production…</span>
    </div>
}

@if (_loading)
{
    <div class="loading-overlay">
        <div class="spinner"></div>
        <span class="spinner-label">Loading…</span>
    </div>
}

<h3>Batches</h3>

@if (_statusMessage is not null)
{
    <div style="padding: 0.5rem 0.75rem; border-radius: 4px; margin-bottom: 0.75rem;
                background: @(_statusIsError ? "#fee2e2" : "#dcfce7");
                color: @(_statusIsError ? "#991b1b" : "#166534"); font-size: 0.875rem;">
        @_statusMessage
    </div>
}

<div style="display: flex; gap: 2rem; margin-bottom: 1rem; align-items: flex-end; flex-wrap: wrap;">
    <div style="min-width: 200px;">
        <label style="display: block; font-weight: 600; margin-bottom: 0.25rem;">Plant</label>
        <SfDropDownList TValue="int?" TItem="PlantOption"
                        Value="_selectedPlantId"
                        ValueChanged="OnPlantChanged"
                        DataSource="_plantOptions"
                        Enabled="_isAdmin">
            <DropDownListFieldSettings Text="Name" Value="Id" />
        </SfDropDownList>
    </div>

    <div>
        <label style="display: block; font-weight: 600; margin-bottom: 0.25rem;">Date range</label>
        <div style="display: flex; gap: 0.5rem;">
            <SfButton OnClick="@(() => SetDateRange(30))">30 days</SfButton>
            <SfButton OnClick="@(() => SetDateRange(60))">60 days</SfButton>
            <SfButton OnClick="@(() => SetDateRange(90))">90 days</SfButton>
            <SfButton OnClick="@(() => SetDateRange(null))">All</SfButton>
        </div>
    </div>

    <div style="min-width: 240px;">
        <label style="display: block; font-weight: 600; margin-bottom: 0.25rem;">Search</label>
        <input type="text" value="@_searchTerm" @oninput="OnSearchInput"
               placeholder="Batch name, part number, description…"
               style="width: 100%; padding: 0.375rem 0.5rem; border: 1px solid #d1d5db; border-radius: 4px; font-size: 0.875rem;" />
    </div>

    <div style="display: flex; flex-direction: column; gap: 0.4rem; padding-bottom: 0.25rem;">
        <label style="display: flex; align-items: center; gap: 0.4rem; cursor: pointer; font-size: 0.875rem;">
            <input type="checkbox" @bind="_hideReleased" @bind:after="OnHideReleasedChanged" />
            Hide released
        </label>
        <label style="display: flex; align-items: center; gap: 0.4rem; cursor: pointer; font-size: 0.875rem;">
            <input type="checkbox" @bind="_hideAssemblies" @bind:after="OnHideAssembliesChanged" />
            Hide assemblies
        </label>
        <label style="display: flex; align-items: center; gap: 0.4rem; cursor: pointer; font-size: 0.875rem;">
            <input type="checkbox" @bind="_hideNonStock" @bind:after="OnHideNonStockChanged" />
            Hide non-stock parts
        </label>
    </div>
</div>

<SfGrid TValue="FlatBatchPartRow" @ref="_batchGrid" ID="BatchesGrid_v6"
        DataSource="_rows" AllowGrouping="true" AllowSorting="true" AllowFiltering="true" EnablePersistence="true"
        AllowResizing="true" Height="600">
    <GridGroupSettings ShowGroupedColumn="false" ShowDropArea="false" EnableLazyLoading="true"
                       Columns="@(new[] { "BatchId", "BatchProductId" })">
        <CaptionTemplate>
            @{
                var ctx = context as CaptionTemplateContext;
                var key = Convert.ToInt32(ctx!.Key);
            }
            @if (ctx.Field == "BatchId" && _batchMeta.TryGetValue(key, out var batch))
            {
                <span data-group-key="@batch.Id" data-group-level="1" style="display:none;"></span>
                @if (batch.IsReleased)
                {
                    <span style="font-weight: 700; font-size: 1rem;">@batch.Name</span>
                }
                else
                {
                    <input type="text" value="@batch.Name"
                           @onchange="@(async e => await OnBatchNameChanged(batch.Id, e.Value?.ToString() ?? ""))"
                           @onkeydown="@(async e => { if (e.Key == "Enter") await JS.InvokeVoidAsync("eval", "document.activeElement.blur()"); })"
                           @onclick:stopPropagation="true"
                           @onkeydown:stopPropagation="true"
                           @onkeyup:stopPropagation="true"
                           title="Edit batch name, press Enter or click elsewhere to save"
                           style="font-weight: 700; font-size: 1rem; border: 1px solid #d1d5db; border-radius: 3px; padding: 1px 4px; color: #111827; min-width: 180px;" />
                }
                <span style="margin-left: 1rem; color: #6b7280; font-size: 0.8rem;">
                    @batch.ImportDate.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")
                </span>
                <span style="margin-left: 0.75rem; color: #6b7280; font-size: 0.8rem;">
                    (@ctx.Count part@(ctx.Count != 1 ? "s" : ""))
                </span>
                @if (_batchMissingPdfCount.TryGetValue(batch.Id, out var batchMissing) && batchMissing > 0)
                {
                    <span style="margin-left: 0.5rem; color: #b91c1c; font-size: 0.75rem; font-weight: 600;">
                        &#9888; @batchMissing missing PDF@(batchMissing != 1 ? "s" : "")
                    </span>
                }
                <span style="margin-left: 1.5rem; display: inline-flex; gap: 0.4rem; align-items: center;">
                    @if (!batch.IsReleased)
                    {
                        @if (_productMeta.Values.Any(p => p.BatchId == batch.Id && !p.VaultBomImported))
                        {
                            <button @onclick="@(async () => await OnRetryBatchPending(batch.Id))" @onclick:stopPropagation="true"
                                    style="@BtnStyle("e-primary")">Re-import pending</button>
                        }
                        <button @onclick="@(async () => await OnReleaseBatch(batch))" @onclick:stopPropagation="true"
                                style="@BtnStyle("e-primary")">Release to Production</button>
                        <button @onclick="@(async () => await OnDeleteBatch(batch))" @onclick:stopPropagation="true"
                                style="@BtnStyle("danger")">Delete</button>
                        <button @onclick="@(async () => await OnMarkAllStockBatchLevel(batch))" @onclick:stopPropagation="true"
                                style="@BtnStyle("")">Mark all as stock</button>
                        <span style="border-left: 1px solid #d1d5db; height: 18px; margin: 0 0.2rem;"></span>
                    }
                    <button @onclick="@(async () => await OpenReport("batch-op", batch.Name, "laser"))" @onclick:stopPropagation="true"
                            style="@BtnStyle("")">Laser</button>
                    <button @onclick="@(async () => await OpenReport("batch-op", batch.Name, "Iron Worker"))" @onclick:stopPropagation="true"
                            style="@BtnStyle("")">Iron Worker</button>
                    <button @onclick="@(async () => await OpenReport("batch-op", batch.Name, "Machine Shop"))" @onclick:stopPropagation="true"
                            style="@BtnStyle("")">Machine Shop</button>
                    <button @onclick="@(async () => await OpenReport("batch-op", batch.Name, "Bandsaw"))" @onclick:stopPropagation="true"
                            style="@BtnStyle("")">Bandsaw</button>
                    <button @onclick="@(async () => await OpenReport("batch-op", batch.Name, "Purchased"))" @onclick:stopPropagation="true"
                            style="@BtnStyle("")">Purchased</button>
                </span>
            }
            else if (ctx.Field == "BatchProductId" && _productMeta.TryGetValue(key, out var product))
            {
                <span data-group-key="@product.Id" data-group-level="2" style="display:none;"></span>
                @if (product.IsReleased)
                {
                    <span style="font-style: italic; font-weight: 600;">@product.ProductName</span>
                }
                else
                {
                    <input type="text" value="@product.ProductName"
                           @onchange="@(async e => await OnBatchProductNameChanged(product.Id, e.Value?.ToString() ?? ""))"
                           @onkeydown="@(async e => { if (e.Key == "Enter") await JS.InvokeVoidAsync("eval", "document.activeElement.blur()"); })"
                           @onclick:stopPropagation="true"
                           @onkeydown:stopPropagation="true"
                           @onkeyup:stopPropagation="true"
                           placeholder="product number"
                           title="Edit product number, press Enter or click elsewhere to save"
                           style="width: 200px; font-style: italic; font-weight: 600; border: 1px solid #d1d5db; border-radius: 3px; padding: 1px 4px; font-size: 0.875rem; color: #374151;" />
                }
                @if (_productMissingPdfCount.TryGetValue(product.Id, out var productMissing) && productMissing > 0)
                {
                    <span style="margin-left: 0.5rem; color: #b91c1c; font-size: 0.75rem; font-weight: 600;">
                        &#9888; @productMissing missing PDF@(productMissing != 1 ? "s" : "")
                    </span>
                }
                <span style="margin-left: 1.5rem; display: inline-flex; gap: 0.5rem; align-items: center;">
                    <span style="font-size: 0.8rem; color: #6b7280;">Qty:</span>
                    @if (product.IsReleased)
                    {
                        <strong>@product.Qty</strong>
                    }
                    else
                    {
                        <input type="number" value="@product.Qty"
                               @onchange="@(async e => await OnBatchProductQtyChanged(product.Id, e.Value?.ToString() ?? ""))"
                               @onclick:stopPropagation="true"
                               min="1" max="9999"
                               style="width: 58px; text-align: right; border: 1px solid #d1d5db; border-radius: 3px; padding: 1px 3px; font-weight: 600;" />
                        @if (_importingProductIds.Contains(product.Id) && !product.VaultBomImported)
                        {
                            <span style="display:inline-flex;align-items:center;gap:0.3rem;color:#3b82f6;font-size:0.8rem;">
                                <span style="display:inline-block;width:12px;height:12px;border:2px solid #bfdbfe;border-top-color:#3b82f6;border-radius:50%;animation:spin 0.8s linear infinite;flex-shrink:0;"></span>
                                Importing…
                            </span>
                        }
                        else if (!product.VaultBomImported)
                        {
                            @if (_importErrorByProductId.TryGetValue(product.Id, out var importErr))
                            {
                                <span style="color:#dc2626;font-size:0.75rem;margin-right:0.25rem;">@importErr —</span>
                            }
                            <button @onclick="@(async () => await OnRetryBatchProduct(product.Id))" @onclick:stopPropagation="true"
                                    style="@BtnStyle("e-primary")">Re-import BOM</button>
                        }
                        else if (_forceReimportProductIds.Contains(product.Id))
                        {
                            <button @onclick="@(async () => await OnRetryBatchProduct(product.Id))" @onclick:stopPropagation="true"
                                    style="@BtnStyle("e-primary")">Re-import BOM</button>
                        }
                        else
                        {
                            <button @onclick="@(() => _forceReimportProductIds.Add(product.Id))" @onclick:stopPropagation="true"
                                    style="border: none; background: none; padding: 0 4px; cursor: pointer; color: #9ca3af; font-size: 0.9rem;"
                                    title="Show re-import option">&#8942;</button>
                        }
                        <button @onclick="@(async () => await OnDeleteBatchProduct(product))" @onclick:stopPropagation="true"
                                style="@BtnStyle("danger")">Delete</button>
                        <button @onclick="@(() => OnMarkAllAsStockClicked(product))" @onclick:stopPropagation="true"
                                style="@BtnStyle("")">Mark all as stock</button>
                    }
                </span>
            }
            else
            {
                <span style="font-weight: 600;">@ctx.Key</span>
                <span style="margin-left: 0.5rem; color: #6b7280; font-size: 0.8rem;">(@ctx.Count)</span>
            }
        </CaptionTemplate>
    </GridGroupSettings>
    <GridSortSettings>
        <GridSortColumns>
            <GridSortColumn Field="CategoryOrder" Direction="SortDirection.Ascending" />
            <GridSortColumn Field="PartLineItemId" Direction="SortDirection.Ascending" />
        </GridSortColumns>
    </GridSortSettings>
    <GridEvents TValue="FlatBatchPartRow" RowDataBound="OnRowDataBound" OnActionBegin="OnSortActionBegin" />
    <GridColumns>
        <GridColumn Field="BatchId" Visible="false" Width="0" />
        <GridColumn Field="BatchProductId" Visible="false" Width="0" />
        <GridColumn Field="PartLineItemId" IsPrimaryKey="true" Visible="false" Width="0" />
        <GridColumn Field="CategoryOrder"  Visible="false" Width="0" />
        <GridColumn Field="BatchReleased"  Visible="false" Width="0" />
        <GridColumn Field="PartNumber" HeaderText="Number" Width="300">
            <Template>
                @{
                    var row = context as FlatBatchPartRow;
                    if (row!.HasPdf)
                    {
                        <a href="/api/pdf-local/@Uri.EscapeDataString(row.PartNumber)" target="_blank"
                           @onclick:stopPropagation="true"
                           style="margin-right: 0.4rem; color: #3b82f6; font-size: 0.75rem; text-decoration: none;"
                           title="View PDF">&#x1F4C4;</a>
                        <span @onmouseenter="@(e => OnThumbEnter(row.PartNumber, e))"
                              @onmouseleave="OnThumbLeave"
                              style="cursor: default;">
                            @row.PartNumber
                        </span>
                    }
                    else if (row.RequiresPdf)
                    {
                        @if (_refreshingPartIds.Contains(row.PartLineItemId))
                        {
                            <span style="margin-right: 0.4rem; font-size: 0.75rem;" title="Checking share…">&#8987;</span>
                        }
                        else
                        {
                            <button @onclick="@(async () => await OnRefreshPdf(row))" @onclick:stopPropagation="true"
                                    style="margin-right: 0.4rem; border: none; background: none; padding: 0; cursor: pointer; font-size: 0.75rem;"
                                    title="Re-check the share for this PDF">&#x1F504;</button>
                        }
                        <span style="color: #b91c1c;" title="PDF required but missing">@row.PartNumber</span>
                    }
                    else
                    {
                        <span>@row.PartNumber</span>
                    }
                }
            </Template>
        </GridColumn>
        <GridColumn Field="Description" HeaderText="Description" Width="220" />
        <GridColumn Field="Category" HeaderText="Category" Width="100" AllowSorting="false" />
        <GridColumn Field="Material" HeaderText="Material" Width="120" />
        <GridColumn Field="Thickness" HeaderText="Thickness" Width="90" />
        <GridColumn Field="Operations" HeaderText="Operations" Width="110" />
        <GridColumn Field="Qty" HeaderText="Qty" Width="70" TextAlign="TextAlign.Right" />
        <GridColumn Field="IsStock" HeaderText="Stock" Width="70" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var row = context as FlatBatchPartRow;
                    <input type="checkbox" checked="@row!.IsStock"
                           @onchange="@(async e => await OnIsStockChanged(row, (bool)e.Value!))"
                           disabled="@row.BatchReleased"
                           style="cursor: @(row.BatchReleased ? "default" : "pointer"); width: 16px; height: 16px;" />
                }
            </Template>
        </GridColumn>
        <GridColumn Field="HasPdf" HeaderText="PDF" Width="60" DisplayAsCheckBox="true" TextAlign="TextAlign.Center" />
        <GridColumn Field="Notes" HeaderText="Notes" Width="150" />
    </GridColumns>
</SfGrid>

@if (_thumbNumber is not null)
{
    <div style="position:fixed; left:@(_thumbX)px; top:@(_thumbY)px; z-index:9999;
                background:#fff; border:1px solid #dee2e6; border-radius:4px;
                box-shadow:0 4px 16px rgba(0,0,0,.18); padding:4px; pointer-events:none;">
        <img src="/api/pdf-thumbnail/@Uri.EscapeDataString(_thumbNumber)" loading="lazy"
             style="display:block; width:220px; height:auto;"
             onerror="this.parentElement.style.display='none'" />
    </div>
}

<SfDialog @bind-Visible="_showStockDialog" Width="440px" IsModal="true" ShowCloseIcon="true"
          Header="Update Stock Flag" AllowDragging="true">
    <DialogTemplates>
        <Content>
            @if (_stockDialogRow is not null)
            {
                <p>Part <strong>@_stockDialogRow.PartNumber</strong> appears <strong>@_stockDialogSiblingCount</strong>
                   time@(_stockDialogSiblingCount != 1 ? "s" : "") in this batch.</p>
                <p>Update all instances or just this one?</p>
            }
        </Content>
        <FooterTemplate>
            <SfButton OnClick="OnStockDialogCancel">Cancel</SfButton>
            <SfButton OnClick="OnStockDialogThisOnly" CssClass="e-outline" style="margin-left: 8px;">This part only</SfButton>
            <SfButton OnClick="OnStockDialogAll" CssClass="e-primary" style="margin-left: 8px;">
                All @_stockDialogSiblingCount instance@(_stockDialogSiblingCount != 1 ? "s" : "")
            </SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<SfDialog @bind-Visible="_showMarkAllStockDialog" Width="440px" IsModal="true" ShowCloseIcon="true"
          Header="Mark All Parts as Stock" AllowDragging="true">
    <DialogTemplates>
        <Content>
            @if (_markAllStockProduct is not null && _markAllStockBatch is not null)
            {
                <p>Mark all parts in <strong>@_markAllStockProduct.ProductName</strong> as stock?</p>
                <p><strong>This batch item only</strong> marks all parts in <strong>@_markAllStockProduct.ProductName</strong>.</p>
                <p><strong>All batch items</strong> marks the same part numbers wherever they appear across all batch items in <strong>@_markAllStockBatch.Name</strong>.</p>
            }
        </Content>
        <FooterTemplate>
            <SfButton OnClick="OnMarkAllStockCancel">Cancel</SfButton>
            <SfButton OnClick="OnMarkAllStockThisOnly" CssClass="e-outline" style="margin-left: 8px;">This batch item only</SfButton>
            <SfButton OnClick="OnMarkAllStockEntireBatch" CssClass="e-primary" style="margin-left: 8px;">All batch items</SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    // ── Data ─────────────────────────────────────────────────────────────────
    private List<FlatBatchPartRow> _rows = new();
    private Dictionary<int, BatchCaption> _batchMeta = new();
    private Dictionary<int, ProductCaption> _productMeta = new();
    private Dictionary<int, int> _batchMissingPdfCount = new();
    private Dictionary<int, int> _productMissingPdfCount = new();

    private sealed record BatchCaption(int Id, string Name, DateTime ImportDate, bool IsReleased);
    private sealed record ProductCaption(int Id, int BatchId, string? ProductName, int Qty, bool IsReleased, bool VaultBomImported);

    // ── Persisted state ───────────────────────────────────────────────────────
    private sealed class BatchesGridState
    {
        public int?      DateRangeDays      { get; set; } = 30;
        public bool      HideReleased       { get; set; } = false;
        public bool      HideAssemblies     { get; set; } = true;
        public bool      HideNonStock       { get; set; } = true;
        public List<int> ExpandedBatchIds   { get; set; } = new();
        public List<int> ExpandedProductIds { get; set; } = new();
    }
    private const string StateKey = "horstmfg.batches.grid.state";

    // ── UI state ─────────────────────────────────────────────────────────────
    private SfGrid<FlatBatchPartRow>? _batchGrid;
    private List<PlantOption> _plantOptions = new();
    private int? _selectedPlantId;
    private bool _isAdmin;
    private bool _releasing;
    private bool _loading;
    private int?      _dateRangeDays = 30;
    private DateTime? _fromDate = DateTime.Today.AddDays(-30);
    private DateTime? _toDate = DateTime.Today;
    private string _searchTerm = "";
    private bool _hideReleased    = false;
    private bool _hideAssemblies  = true;
    private bool _hideNonStock    = true;
    private HashSet<int> _expandedBatchIds   = new();
    private HashSet<int> _expandedProductIds = new();
    private CancellationTokenSource? _searchCts;
    private CancellationTokenSource? _saveCts;
    private CancellationTokenSource? _pollCts;
    private DotNetObjectReference<Batches>? _dotNetRef;

    // Products currently being polled for VaultBomImported completion
    private HashSet<int> _importingProductIds = new();
    private Dictionary<int, string> _importErrorByProductId = new();

    // Products where the user has manually revealed the Re-import BOM button
    // (hidden by default once a product has successfully imported).
    private HashSet<int> _forceReimportProductIds = new();
    private int? _activePartLineItemId;

    // Status message (retry feedback)
    private string? _statusMessage;
    private bool _statusIsError;

    // PDF thumbnail hover
    private string? _thumbNumber;
    private double _thumbX, _thumbY;

    // PDF refresh
    private HashSet<int> _refreshingPartIds = new();

    // Stock dialog
    private bool _showStockDialog;
    private FlatBatchPartRow? _stockDialogRow;
    private bool _stockDialogNewValue;
    private int _stockDialogSiblingCount;
    private double _stockDialogScrollTop;

    // Mark-all-as-stock dialog
    private bool _showMarkAllStockDialog;
    private ProductCaption? _markAllStockProduct;
    private BatchCaption? _markAllStockBatch;

    private record PlantOption(int? Id, string Name);

    // ── Helpers ───────────────────────────────────────────────────────────────
    private static string BtnStyle(string variant) => variant switch
    {
        "e-primary" => "padding: 2px 8px; font-size: 0.75rem; border-radius: 3px; border: 1px solid #3b82f6; background: #3b82f6; color: white; cursor: pointer;",
        "danger"    => "padding: 2px 8px; font-size: 0.75rem; border-radius: 3px; border: 1px solid #ef4444; background: white; color: #ef4444; cursor: pointer;",
        _           => "padding: 2px 8px; font-size: 0.75rem; border-radius: 3px; border: 1px solid #d1d5db; background: white; color: #374151; cursor: pointer;",
    };

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var plants = await db.Plants.Where(p => p.IsActive).OrderBy(p => p.Name).ToListAsync();
        _plantOptions = new List<PlantOption> { new(null, "All Plants") };
        _plantOptions.AddRange(plants.Select(p => new PlantOption(p.Id, p.Name)));

        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext?.User.Identity?.IsAuthenticated == true)
        {
            _isAdmin = httpContext.User.HasClaim(ClaimTypes.Role, "Admin");
            if (!_isAdmin)
            {
                var plantIdClaim = httpContext.User.FindFirst("PlantId")?.Value;
                if (int.TryParse(plantIdClaim, out var pid))
                    _selectedPlantId = pid;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var user = HttpContextAccessor.HttpContext?.User;
        var canEdit = user?.HasClaim(ClaimTypes.Role, "Admin") == true
                   || user?.HasClaim(ClaimTypes.Role, "Engineering") == true;
        await JS.InvokeVoidAsync("setUserCanEdit", canEdit);
        _dotNetRef = DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("horstGrid.watchExpansion", "BatchesGrid_v6", _dotNetRef); }
        catch (JSException) { /* app.js not yet available (stale cache); expansion tracking inactive */ }
        await LoadStateAsync();
        await LoadData();
    }

    // ── Data loading ──────────────────────────────────────────────────────────
    private async Task LoadData()
    {
        _restoringExpansion = true;
        _loading = true;
        _statusMessage = null;
        _importErrorByProductId.Clear();
        StateHasChanged();
        await JS.InvokeVoidAsync("console.log", "[DBG Batches] LoadData start — expandedBatches:",
            _expandedBatchIds.ToList(), "expandedProducts:", _expandedProductIds.ToList());
        var term = string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm.Trim();
        _rows = await BomService.GetFlatBatchPartsAsync(_selectedPlantId, _fromDate, _toDate, term);
        BuildMeta();
        _loading = false;
        StateHasChanged();
        await ApplyGridFilters();
        await RestoreExpansionAsync();
    }

    private void BuildMeta()
    {
        _batchMeta = _rows
            .GroupBy(r => r.BatchId)
            .ToDictionary(g => g.Key, g => new BatchCaption(
                g.Key,
                g.First().BatchName,
                g.First().BatchImportDate,
                g.First().BatchReleased));

        _productMeta = _rows
            .GroupBy(r => r.BatchProductId)
            .ToDictionary(g => g.Key, g => new ProductCaption(
                g.Key,
                g.First().BatchId,
                g.First().ProductName,
                g.First().ProductQty,
                g.First().BatchReleased,
                g.First().VaultBomImported));

        RecomputeMissingPdfCounts();
    }

    // Missing-PDF counts only include rows currently visible under the "Hide non-stock
    // parts" and "Hide assemblies" filters — a part hidden from the grid shouldn't count
    // toward the badge.
    private void RecomputeMissingPdfCounts()
    {
        var missingRows = _rows.Where(r => r.PartLineItemId != 0 && r.RequiresPdf && !r.HasPdf
                                         && (!_hideNonStock || r.IsStock)
                                         && (!_hideAssemblies || r.CategoryOrder != 1));
        _batchMissingPdfCount = missingRows
            .GroupBy(r => r.BatchId)
            .ToDictionary(g => g.Key, g => g.Count());
        _productMissingPdfCount = missingRows
            .GroupBy(r => r.BatchProductId)
            .ToDictionary(g => g.Key, g => g.Count());
    }

