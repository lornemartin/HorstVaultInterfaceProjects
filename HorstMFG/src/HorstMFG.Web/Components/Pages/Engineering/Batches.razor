    // ── Batch actions ─────────────────────────────────────────────────────────
    private async Task OnReleaseBatch(BatchCaption batch)
    {
        var missingCount = _batchMissingPdfCount.GetValueOrDefault(batch.Id);
        var warning = missingCount > 0
            ? $"Warning: {missingCount} part{(missingCount != 1 ? "s" : "")} in this batch require a PDF but are missing one.\n\n"
            : "";
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"{warning}Release batch '{batch.Name}' to production? This cannot be undone and the batch will become read-only.");
        if (!confirmed) return;

        var stationId = BridgeHub.GetAnyOnlineStationId();
        if (stationId == null)
        {
            await JS.InvokeVoidAsync("alert",
                "No bridge connection is active. A bridge must be connected to release to production.");
            return;
        }

        _releasing = true;
        StateHasChanged();
        try
        {
            await BomService.ReleaseBatchToProductionAsync(batch.Id);

            await using var db = await DbContextFactory.CreateDbContextAsync();
            var thumbItems = await db.BatchItems
                .Where(i => i.NestBatch.BatchId == batch.Id
                         && i.Part.Thumbnail == null
                         && i.Part.FileName != null)
                .Select(i => new { i.PartId, i.Part.FileName })
                .Distinct()
                .ToListAsync();
            if (thumbItems.Any())
            {
                Logger.LogInformation("Batch {Id} release: sending UpdateThumbnail for {Count} part(s)",
                    batch.Id, thumbItems.Count);
                var payload = JsonSerializer.Serialize(
                    thumbItems.Select(t => new { PartId = t.PartId, FileName = t.FileName }));
                var sent = BridgeHub.TrySendCommand(HubContext, stationId.Value,
                    Guid.NewGuid().ToString(), "UpdateThumbnail", payload);
                if (!sent)
                    Logger.LogWarning("Batch {Id} release: TrySendCommand returned false", batch.Id);
            }
            else
            {
                Logger.LogInformation("Batch {Id} release: no parts needing thumbnails", batch.Id);
            }

            await LoadData();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", ex.Message);
        }
        finally
        {
            _releasing = false;
            StateHasChanged();
        }
    }

