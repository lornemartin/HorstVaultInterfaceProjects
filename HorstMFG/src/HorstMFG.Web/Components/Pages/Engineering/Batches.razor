@page "/engineering/batches"
@attribute [Authorize(Policy = "Engineering")]
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JS
@inject IBomService BomService
@inject HorstMFG.Web.Services.BatchTreeFilterState BatchFilterState
@inject Microsoft.AspNetCore.SignalR.IHubContext<HorstMFG.Web.Hubs.BridgeHub> HubContext
@using HorstMFG.Infrastructure.Data
@using Microsoft.Extensions.Logging
@inject ILogger<Batches> Logger
@using HorstMFG.Web.Hubs
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.TreeGrid
@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.Data
@using Syncfusion.Blazor.Popups

<PageTitle>Batches - HorstMFG</PageTitle>

@if (_releasing)
{
    <div class="loading-overlay">
        <div class="spinner"></div>
        <span class="spinner-label">Releasing to production…</span>
    </div>
}

<h3>Batches</h3>

<div style="display: flex; gap: 2rem; margin-bottom: 1rem; align-items: flex-end; flex-wrap: wrap;">
    <div style="min-width: 200px;">
        <label style="display: block; font-weight: 600; margin-bottom: 0.25rem;">Plant</label>
        <SfDropDownList TValue="int?" TItem="PlantOption"
                        Value="_selectedPlantId"
                        ValueChanged="OnPlantChanged"
                        DataSource="_plantOptions"
                        Enabled="_isAdmin">
            <DropDownListFieldSettings Text="Name" Value="Id" />
        </SfDropDownList>
    </div>

    <div style="min-width: 140px;">
        <label style="display: block; font-weight: 600; margin-bottom: 0.25rem;">From</label>
        <SfDatePicker TValue="DateTime?" Value="_fromDate" ValueChanged="OnFromDateChanged" Format="MM/dd/yyyy" />
    </div>

    <div style="min-width: 140px;">
        <label style="display: block; font-weight: 600; margin-bottom: 0.25rem;">To</label>
        <SfDatePicker TValue="DateTime?" Value="_toDate" ValueChanged="OnToDateChanged" Format="MM/dd/yyyy" />
    </div>

    <div>
        <label style="display: block; font-weight: 600; margin-bottom: 0.25rem;">&nbsp;</label>
        <div style="display: flex; gap: 0.5rem;">
            <SfButton OnClick="@(() => SetDateRange(30))">30 days</SfButton>
            <SfButton OnClick="@(() => SetDateRange(90))">90 days</SfButton>
            <SfButton OnClick="@(() => SetDateRange(null))">All</SfButton>
        </div>
    </div>

    <div style="display: flex; align-items: center; padding-bottom: 0.25rem;">
        <SfCheckBox Label="Show Processed Items" @bind-Checked="_showProcessed" ValueChange="OnShowProcessedChanged" TChecked="bool" />
    </div>

    <div style="min-width: 240px;">
        <label style="display: block; font-weight: 600; margin-bottom: 0.25rem;">Search</label>
        <input type="text" value="@_searchTerm" @oninput="OnSearchInput"
               placeholder="Batch name, part number, description…"
               style="width: 100%; padding: 0.375rem 0.5rem; border: 1px solid #d1d5db; border-radius: 4px; font-size: 0.875rem;" />
    </div>
</div>

<SfTreeGrid TValue="ExportTreeItem" @ref="_batchGrid" ID="BatchesGrid_v5" IdMapping="TreeId" ParentIdMapping="TreeParentId"
            HasChildMapping="HasChildren" LoadChildOnDemand="true" EnablePersistence="true"
            TreeColumnIndex="0" AllowSorting="true" AllowMultiSorting="true" Height="600" AllowResizing="true"
            ContextMenuItems="@_contextMenuItems">
    <SfDataManager AdaptorInstance="typeof(HorstMFG.Web.Services.BatchTreeAdaptor)" Adaptor="Adaptors.CustomAdaptor" />
    <TreeGridEvents TValue="ExportTreeItem"
                    DataBound="OnBatchDataBound"
                    OnActionBegin="OnBatchActionBegin"
                    Expanded="OnBatchExpanded"
                    Collapsed="OnBatchCollapsed"
                    RowDataBound="OnRowDataBound"
                    ContextMenuOpen="OnContextMenuOpen"
                    ContextMenuItemClicked="OnContextMenuClicked" />
    <TreeGridColumns>
        <TreeGridColumn Field="@nameof(ExportTreeItem.Number)" HeaderText="Number" Width="300">
            <Template>
                @{
                    var item = context as ExportTreeItem;
                    @if (item!.IsBatchRow)
                    {
                        <strong>@item.BatchName</strong>
                    }
                    else if (item.IsProductRow)
                    {
                        <span style="font-style: italic;">@item.ProductName</span>
                    }
                    else if (item.HasPdf)
                    {
                        <span @onmouseenter="@(e => OnThumbEnter(item.Number!, e))"
                              @onmouseleave="OnThumbLeave"
                              style="cursor:default;">@item.Number</span>
                    }
                    else
                    {
                        <span>@item.Number</span>
                    }
                }
            </Template>
        </TreeGridColumn>
        <TreeGridColumn Field="@nameof(ExportTreeItem.Description)" HeaderText="Description" Width="220">
            <Template>
                @{
                    var item = context as ExportTreeItem;
                    @if (!item!.IsBatchRow && !item.IsProductRow)
                    {
                        <span>@item.Description</span>
                    }
                }
            </Template>
        </TreeGridColumn>
        <TreeGridColumn Field="@nameof(ExportTreeItem.CategoryOrder)" HeaderText="Category" Width="100">
            <Template>
                @{
                    var item = context as ExportTreeItem;
                    <span>@item!.Category</span>
                }
            </Template>
        </TreeGridColumn>
        <TreeGridColumn Field="@nameof(ExportTreeItem.Material)" HeaderText="Material" Width="120" />
        <TreeGridColumn Field="@nameof(ExportTreeItem.Thickness)" HeaderText="Thickness" Width="90" />
        <TreeGridColumn Field="@nameof(ExportTreeItem.Operations)" HeaderText="Operations" Width="110" />
        <TreeGridColumn Field="@nameof(ExportTreeItem.Qty)" HeaderText="Qty" Width="70" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
            <Template>
                @{
                    var item = context as ExportTreeItem;
                    @if (item!.IsBatchRow)
                    {
                        <span style="color: #6b7280;">@item.ItemCount items</span>
                    }
                    else if (item.IsProductRow)
                    {
                        <strong>@item.ParentQty</strong>
                    }
                    else
                    {
                        @item.Qty
                    }
                }
            </Template>
        </TreeGridColumn>
        <TreeGridColumn Field="@nameof(ExportTreeItem.IsStock)" HeaderText="Stock" Width="70"
                        TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center">
            <Template>
                @{
                    var item = context as ExportTreeItem;
                    if (!item!.IsBatchRow && !item.IsProductRow)
                    {
                        <input type="checkbox" checked="@item.IsStock"
                               @onchange="@(async e => await OnIsStockChanged(item, (bool)e.Value!))"
                               style="cursor: pointer; width: 16px; height: 16px;" />
                    }
                }
            </Template>
        </TreeGridColumn>
        <TreeGridColumn Field="@nameof(ExportTreeItem.HasPdf)" HeaderText="PDF" Width="70"
                        DisplayAsCheckBox="true" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center" />
        <TreeGridColumn Field="@nameof(ExportTreeItem.Notes)" HeaderText="Notes" Width="150" />
        <TreeGridColumn Field="@nameof(ExportTreeItem.ImportDate)" HeaderText="Imported" Width="140">
            <Template>
                @{
                    var item = context as ExportTreeItem;
                    @if (item!.IsBatchRow && item.ImportDate.HasValue)
                    {
                        @item.ImportDate.Value.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")
                    }
                }
            </Template>
        </TreeGridColumn>
        <TreeGridColumn Field="TreeId" IsPrimaryKey="true" Visible="false" Width="0" />
    </TreeGridColumns>
</SfTreeGrid>

@if (_thumbNumber is not null)
{
    <div style="position:fixed; left:@(_thumbX)px; top:@(_thumbY)px; z-index:9999;
                background:#fff; border:1px solid #dee2e6; border-radius:4px;
                box-shadow:0 4px 16px rgba(0,0,0,.18); padding:4px; pointer-events:none;">
        <img src="/api/pdf-thumbnail/@Uri.EscapeDataString(_thumbNumber)" loading="lazy"
             style="display:block; width:220px; height:auto;"
             onerror="this.parentElement.style.display='none'" />
    </div>
}

<SfDialog @bind-Visible="_showStockDialog" Width="440px" IsModal="true" ShowCloseIcon="true"
          Header="Update Stock Flag" AllowDragging="true">
    <DialogTemplates>
        <Content>
            @if (_stockDialogItem is not null)
            {
                <p>Part <strong>@_stockDialogItem.Number</strong> appears <strong>@_stockDialogSiblingCount</strong>
                   time@(_stockDialogSiblingCount != 1 ? "s" : "") in this batch.</p>
                <p>Update all instances or just this one?</p>
            }
        </Content>
        <FooterTemplate>
            <SfButton OnClick="OnStockDialogCancel">Cancel</SfButton>
            <SfButton OnClick="OnStockDialogThisOnly" CssClass="e-outline" style="margin-left: 8px;">This part only</SfButton>
            <SfButton OnClick="OnStockDialogAll" CssClass="e-primary" style="margin-left: 8px;">
                All @_stockDialogSiblingCount instance@(_stockDialogSiblingCount != 1 ? "s" : "")
            </SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    private List<PlantOption> _plantOptions = new();
    private int? _selectedPlantId;
    private bool _showProcessed;
    private bool _isAdmin;
    private bool _releasing;
    private DateTime? _fromDate = DateTime.Today.AddDays(-30);
    private DateTime? _toDate = DateTime.Today;

    // PDF thumbnail hover
    private string? _thumbNumber;
    private double  _thumbX, _thumbY;

    private void OnThumbEnter(string number, Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        _thumbNumber = number;
        _thumbX = e.ClientX + 18;
        _thumbY = e.ClientY - 10;
    }

    private void OnThumbLeave() => _thumbNumber = null;

    private SfTreeGrid<ExportTreeItem>? _batchGrid;

    private record PlantOption(int? Id, string Name);

    private readonly List<object> _contextMenuItems = new()
    {
        new ContextMenuItemModel { Text = "View PDF",                   Id = "view-pdf"       },
        new ContextMenuItemModel { Separator = true,                    Id = "sep-pdf"        },
        new ContextMenuItemModel { Text = "Laser Parts Report",         Id = "laser-report"   },
        new ContextMenuItemModel { Text = "Iron Worker Report",         Id = "op-iron-worker" },
        new ContextMenuItemModel { Text = "Machine Shop Report",        Id = "op-machine-shop"},
        new ContextMenuItemModel { Text = "Bandsaw Report",             Id = "op-bandsaw"     },
        new ContextMenuItemModel { Text = "Purchased Parts Report",     Id = "op-purchased"   },
        new ContextMenuItemModel { Separator = true,                    Id = "sep-reports"    },
        new ContextMenuItemModel { Text = "Release to Production",      Id = "release-batch"  },
        new ContextMenuItemModel { Separator = true,                    Id = "sep-release"    },
        new ContextMenuItemModel { Text = "Delete Batch",               Id = "delete-batch"   },
        new ContextMenuItemModel { Text = "Delete Batch Item",          Id = "delete-product" },
    };


    private static readonly Dictionary<string, string> _opMenuItems = new()
    {
        ["op-iron-worker"]  = "Iron Worker",
        ["op-machine-shop"] = "Machine Shop",
        ["op-bandsaw"]      = "Bandsaw",
        ["op-purchased"]    = "Purchased",
    };

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var plants = await db.Plants.Where(p => p.IsActive).OrderBy(p => p.Name).ToListAsync();
        _plantOptions = new List<PlantOption> { new(null, "All Plants") };
        _plantOptions.AddRange(plants.Select(p => new PlantOption(p.Id, p.Name)));

        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext?.User.Identity?.IsAuthenticated == true)
        {
            _isAdmin = httpContext.User.HasClaim(ClaimTypes.Role, "Admin");
            if (!_isAdmin)
            {
                var plantIdClaim = httpContext.User.FindFirst("PlantId")?.Value;
                if (int.TryParse(plantIdClaim, out var pid))
                    _selectedPlantId = pid;
            }
        }

        SyncFilterState();
    }

    private bool _isFirstLoad = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var user = HttpContextAccessor.HttpContext?.User;
        var canEdit = user?.HasClaim(ClaimTypes.Role, "Admin") == true
                   || user?.HasClaim(ClaimTypes.Role, "Engineering") == true;
        await JS.InvokeVoidAsync("setUserCanEdit", canEdit);
        _awaitingRestore = true;
        await LoadData();
        StateHasChanged();
    }

    private string _searchTerm = "";
    private CancellationTokenSource? _searchCts;

    private async Task OnSearchInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? "";
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(350, token);
            await LoadData();
        }
        catch (TaskCanceledException) { }
    }

    private void SyncFilterState()
    {
        BatchFilterState.PlantId = _selectedPlantId;
        BatchFilterState.IncludeProcessed = _showProcessed;
        BatchFilterState.FromDate = _fromDate;
        BatchFilterState.ToDate = _toDate;
        BatchFilterState.SearchTerm = string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm.Trim();
    }

    private async Task LoadData()
    {
        SyncFilterState();
        if (_isFirstLoad)
        {
            _isFirstLoad = false;
        }
        else
        {
            _awaitingRestore = true;
            if (_batchGrid is not null) await _batchGrid.RefreshAsync();
        }
    }

    private async Task OnPlantChanged(int? value)
    {
        _selectedPlantId = value;
        await LoadData();
        StateHasChanged();
    }

    private async Task OnShowProcessedChanged(Syncfusion.Blazor.Buttons.ChangeEventArgs<bool> args)
    {
        _showProcessed = args.Checked;
        await LoadData();
        StateHasChanged();
    }

    private async Task OnFromDateChanged(DateTime? value)
    {
        _fromDate = value;
        await LoadData();
        StateHasChanged();
    }

    private async Task OnToDateChanged(DateTime? value)
    {
        _toDate = value;
        await LoadData();
        StateHasChanged();
    }

    private async Task SetDateRange(int? days)
    {
        _fromDate = days.HasValue ? DateTime.Today.AddDays(-days.Value) : null;
        _toDate = days.HasValue ? DateTime.Today : null;
        await LoadData();
        StateHasChanged();
    }

    // ── Expansion state persistence ───────────────────────────────────────────
    private const string ExpandKey = "hfmg-batch-expanded";
    private bool _awaitingRestore;
    private bool _restoringExpansion;

    private async Task OnBatchDataBound(object _)
    {
        if (!_awaitingRestore || _restoringExpansion) return;
        _awaitingRestore = false;
        _restoringExpansion = true;
        try { await RestoreExpansionAsync(); }
        finally { _restoringExpansion = false; }
    }

    private void OnBatchActionBegin(ActionEventArgs<ExportTreeItem> args)
    {
        if (args.RequestType == Syncfusion.Blazor.Grids.Action.Sorting && !_restoringExpansion)
            _awaitingRestore = true;
    }

    private async Task OnBatchExpanded(RowExpandedEventArgs<ExportTreeItem> args)
    {
        if (_restoringExpansion || (!args.Data.IsBatchRow && !args.Data.IsProductRow)) return;
        await UpdateExpandedStorageAsync(args.Data.TreeId, add: true);
    }

    private async Task OnBatchCollapsed(RowCollapsedEventArgs<ExportTreeItem> args)
    {
        if (_restoringExpansion || (!args.Data.IsBatchRow && !args.Data.IsProductRow)) return;
        await UpdateExpandedStorageAsync(args.Data.TreeId, add: false);
    }

    private async Task RestoreExpansionAsync()
    {
        if (_batchGrid is null) return;
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", ExpandKey);
            if (string.IsNullOrEmpty(json)) return;
            var ids = System.Text.Json.JsonSerializer.Deserialize<List<int>>(json);
            if (ids is null || ids.Count == 0) return;

            // Pass 1: expand root rows (batch) — loads their product children
            foreach (var id in ids.Where(id => id < 1_000_000))
            {
                try { await _batchGrid.ExpandByKeyAsync(id); }
                catch (ArgumentOutOfRangeException) { }
            }

            // Pass 2: expand product rows — now visible after their parents expanded above
            foreach (var id in ids.Where(id => id >= 1_000_000))
            {
                try { await _batchGrid.ExpandByKeyAsync(id); }
                catch (ArgumentOutOfRangeException) { }  // parent not expanded, skip
            }
        }
        catch (JSDisconnectedException) { }
    }

    private async Task UpdateExpandedStorageAsync(int treeId, bool add)
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", ExpandKey);
            var ids = string.IsNullOrEmpty(json)
                ? new HashSet<int>()
                : new HashSet<int>(System.Text.Json.JsonSerializer.Deserialize<List<int>>(json) ?? new List<int>());
            if (add) ids.Add(treeId); else ids.Remove(treeId);
            await JS.InvokeVoidAsync("localStorage.setItem", ExpandKey,
                System.Text.Json.JsonSerializer.Serialize(ids));
        }
        catch (JSDisconnectedException) { }
    }

    // ── Context menu ──────────────────────────────────────────────────────────

    private void OnContextMenuOpen(ContextMenuOpenEventArgs<ExportTreeItem> args)
    {
        var row = args.RowInfo?.RowData;
        if (row is null) { args.Cancel = true; return; }

        if (!row.IsBatchRow && !row.IsProductRow)
        {
            // Leaf row — only allow menu if part has a PDF; app.js hides batch-level items
            if (!row.HasPdf) args.Cancel = true;
            return;
        }

        if (row.IsProductRow && row.ReadyForProduction) { args.Cancel = true; return; }
        // Batch/product row visibility handled by app.js (row-batch, row-product, row-released).
    }

    private async Task OnContextMenuClicked(ContextMenuClickEventArgs<ExportTreeItem> args)
    {
        var row = args.RowInfo?.RowData;
        if (row is null) return;

        if (args.Item.Id == "release-batch" && row.IsBatchRow)
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm",
                $"Release batch '{row.BatchName}' to production? This cannot be undone and the batch will become read-only.");
            if (!confirmed) return;

            var stationId = BridgeHub.GetAnyOnlineStationId();
            if (stationId == null)
            {
                await JS.InvokeVoidAsync("alert",
                    "No bridge connection is active. A bridge must be connected to release to production.");
                return;
            }

            _releasing = true;
            StateHasChanged();
            try
            {
                await BomService.ReleaseBatchToProductionAsync(row.TreeId);

                // Send thumbnail extraction to the bridge for parts that don't have one yet
                await using var db = await DbContextFactory.CreateDbContextAsync();
                var thumbItems = await db.BatchItems
                    .Where(i => i.NestBatch.BatchId == row.TreeId
                             && i.Part.Thumbnail == null
                             && i.Part.FileName != null)
                    .Select(i => new { i.PartId, i.Part.FileName })
                    .Distinct()
                    .ToListAsync();
                if (thumbItems.Any())
                {
                    Logger.LogInformation("Batch {Id} release: sending UpdateThumbnail for {Count} part(s)",
                        row.TreeId, thumbItems.Count);
                    var payload = JsonSerializer.Serialize(
                        thumbItems.Select(t => new { PartId = t.PartId, FileName = t.FileName }));
                    var sent = BridgeHub.TrySendCommand(HubContext, stationId.Value,
                        Guid.NewGuid().ToString(), "UpdateThumbnail", payload);
                    if (!sent)
                        Logger.LogWarning("Batch {Id} release: TrySendCommand returned false — station {StationId} disconnected?",
                            row.TreeId, stationId.Value);
                }
                else
                {
                    Logger.LogInformation("Batch {Id} release: no parts needing thumbnails (0 BatchItems or all already have thumbnails)",
                        row.TreeId);
                }

                _awaitingRestore = true;
                if (_batchGrid is not null) await _batchGrid.RefreshAsync();
            }
            catch (Exception ex)
            {
                await JS.InvokeVoidAsync("alert", ex.Message);
            }
            finally
            {
                _releasing = false;
            }
            return;
        }

        if (args.Item.Id == "delete-batch" && row.IsBatchRow)
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm",
                $"Delete entire batch '{row.BatchName}'? This will remove all batch items and parts and cannot be undone.");
            if (!confirmed) return;
            await BomService.DeleteBatchAsync(row.TreeId);
            if (_batchGrid is not null) await _batchGrid.RefreshAsync();
            return;
        }

        if (args.Item.Id == "delete-product" && row.IsProductRow)
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm",
                $"Delete batch item '{row.ProductName}' and all its parts? This cannot be undone.");
            if (!confirmed) return;
            await BomService.DeleteBatchProductAsync(row.TreeId - 1_000_000);
            _awaitingRestore = true;
            if (_batchGrid is not null) await _batchGrid.RefreshAsync();
            return;
        }

        if (args.Item.Id == "view-pdf" && row.Number is not null)
        {
            await JS.InvokeVoidAsync("window.open",
                $"/api/pdf-local/{Uri.EscapeDataString(row.Number)}", "_blank");
            return;
        }

        if (row.BatchName is not string name) return;
        if (args.Item.Id == "laser-report")
            await JS.InvokeVoidAsync("window.open",
                $"/api/reports/batch-laser/{Uri.EscapeDataString(name)}", "_blank");
        else if (_opMenuItems.TryGetValue(args.Item.Id, out var op))
            await JS.InvokeVoidAsync("window.open",
                $"/api/reports/batch-op/{Uri.EscapeDataString(name)}/{Uri.EscapeDataString(op)}", "_blank");
    }

    // ── IsStock editing ───────────────────────────────────────────────────────
    private bool _showStockDialog;
    private ExportTreeItem? _stockDialogItem;
    private bool _stockDialogNewValue;
    private int _stockDialogSiblingCount;

    private async Task OnIsStockChanged(ExportTreeItem item, bool newValue)
    {
        const int partOffset = 100_000_000;
        var partId = item.TreeId - partOffset;
        var count = await BomService.CountSiblingsByPartNumberAsync(partId);
        if (count > 1)
        {
            _stockDialogItem = item;
            _stockDialogNewValue = newValue;
            _stockDialogSiblingCount = count;
            _showStockDialog = true;
            return;
        }
        await BomService.UpdatePartIsStockAsync(partId, newValue);
        _awaitingRestore = true;
        if (_batchGrid is not null) await _batchGrid.RefreshAsync();
    }

    private async Task OnStockDialogThisOnly()
    {
        _showStockDialog = false;
        if (_stockDialogItem is null) return;
        const int partOffset = 100_000_000;
        await BomService.UpdatePartIsStockAsync(_stockDialogItem.TreeId - partOffset, _stockDialogNewValue);
        _stockDialogItem = null;
        _awaitingRestore = true;
        if (_batchGrid is not null) await _batchGrid.RefreshAsync();
    }

    private async Task OnStockDialogAll()
    {
        _showStockDialog = false;
        if (_stockDialogItem is null) return;
        const int partOffset = 100_000_000;
        await BomService.UpdatePartIsStockForAllSiblingsAsync(_stockDialogItem.TreeId - partOffset, _stockDialogNewValue);
        _stockDialogItem = null;
        _awaitingRestore = true;
        if (_batchGrid is not null) await _batchGrid.RefreshAsync();
    }

    private void OnStockDialogCancel()
    {
        _showStockDialog = false;
        _stockDialogItem = null;
    }

    // Non-stock items are dimmed — they belong on the Orders page
    private void OnRowDataBound(RowDataBoundEventArgs<ExportTreeItem> args)
    {
        if (args.Data.IsBatchRow)
        {
            args.Row.AddClass(new[] { "row-batch" });
            if (args.Data.ReadyForProduction)
                args.Row.AddClass(new[] { "row-released" });
        }
        else if (args.Data.IsProductRow)
        {
            args.Row.AddClass(new[] { "row-product" });
            if (args.Data.ReadyForProduction)
                args.Row.AddClass(new[] { "row-released" });
        }
        else
        {
            if (args.Data.ReadyForProduction)
                args.Row.AddClass(new[] { "row-released" });
            else if (args.Data.IsProcessed)
                args.Row.AddClass(new[] { "row-processed" });
            if (!string.IsNullOrWhiteSpace(args.Data.Notes))
                args.Row.AddClass(new[] { "row-has-notes" });
            if (!args.Data.IsStock)
                args.Row.AddClass(new[] { "row-dimmed" });
            if (args.Data.HasPdf)
                args.Row.AddClass(new[] { "row-leaf-pdf" });
        }
    }
}
