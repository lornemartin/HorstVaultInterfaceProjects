    private async Task OnRetryBatchProduct(int productId)
    {
        _activePartLineItemId = null;
        _forceReimportProductIds.Remove(productId);
        var result = await BatchImportSvc.RetrySingleBatchProductAsync(productId);
        if (!string.IsNullOrEmpty(result.GatewayError))
        {
            _statusMessage = $"Gateway error: {result.GatewayError}";
            _statusIsError = true;
        }
        else if (!result.Success)
        {
            _statusMessage = result.Errors.FirstOrDefault() ?? "Re-import failed.";
            _statusIsError = true;
        }
        else
        {
            _importErrorByProductId.Remove(productId);
            _importingProductIds.Add(productId);
            _statusMessage = null;
            StartProductPollIfNeeded();
        }
        StateHasChanged();
    }

    private async Task OnRetryBatchPending(int batchId)
    {
        var result = await BatchImportSvc.RetryBatchPendingAsync(batchId);
        if (!string.IsNullOrEmpty(result.GatewayError))
        {
            _statusMessage = $"Gateway error: {result.GatewayError}";
            _statusIsError = true;
        }
        else if (!result.Success)
        {
            _statusMessage = result.Errors.FirstOrDefault() ?? "Re-import failed.";
            _statusIsError = true;
        }
        else
        {
            var warning = result.Warnings.FirstOrDefault();
            if (warning is not null)
            {
                _statusMessage = warning;
                _statusIsError = false;
            }
            else
            {
                foreach (var id in _productMeta.Values
                    .Where(p => p.BatchId == batchId && !p.VaultBomImported)
                    .Select(p => p.Id))
                {
                    _importingProductIds.Add(id);
                }
                _statusMessage = null;
                StartProductPollIfNeeded();
            }
        }
        StateHasChanged();
    }

    private void StartProductPollIfNeeded()
    {
        if (_importingProductIds.Count == 0) return;
        _pollCts?.Cancel();
        _pollCts = new CancellationTokenSource();
        _ = PollBatchImportAsync(_pollCts.Token);
    }

    private async Task PollBatchImportAsync(CancellationToken ct)
    {
        var deadline = DateTime.UtcNow.AddSeconds(90);

        while (_importingProductIds.Count > 0)
        {
            if (ct.IsCancellationRequested) return;
            if (DateTime.UtcNow >= deadline) break;

            try { await Task.Delay(2000, ct); }
            catch (OperationCanceledException) { return; }

            try
            {
                await using var db = await DbContextFactory.CreateDbContextAsync(ct);
                var ids = _importingProductIds.ToList();
                var results = await db.BatchProducts
                    .Where(bp => ids.Contains(bp.Id))
                    .Select(bp => new { bp.Id, bp.VaultBomImported, bp.LastImportError })
                    .ToListAsync(ct);
                foreach (var r in results.Where(r => r.VaultBomImported))
                    _importingProductIds.Remove(r.Id);
                // A failure (e.g. item not found in Vault) is terminal — no need to wait
                // out the full timeout once the Gateway has already reported it.
                foreach (var r in results.Where(r => !r.VaultBomImported && r.LastImportError is not null))
                {
                    _importingProductIds.Remove(r.Id);
                    _importErrorByProductId[r.Id] = r.LastImportError!;
                }
                var found = results.Select(r => r.Id).ToHashSet();
                foreach (var id in ids.Where(id => !found.Contains(id)))
                    _importingProductIds.Remove(id);
            }
            catch (OperationCanceledException) { return; }
            catch (Exception) { }

            await InvokeAsync(StateHasChanged);
        }

        var timedOutIds = _importingProductIds.ToList();
        _importingProductIds.Clear();

        await InvokeAsync(async () =>
        {
            var scrollTop = await JS.InvokeAsync<double>("horstGrid.saveScrollTop", "BatchesGrid_v6");
            await LoadData();
            foreach (var id in timedOutIds)
                _importErrorByProductId[id] = "Timed out";
            StateHasChanged();
            await JS.InvokeVoidAsync("horstGrid.restoreScrollTop", "BatchesGrid_v6", scrollTop);
        });
    }

