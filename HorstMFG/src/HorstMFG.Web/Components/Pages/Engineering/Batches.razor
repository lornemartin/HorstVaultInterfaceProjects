    private async Task ApplyGridFilters()
    {
        if (_batchGrid is null) return;
        _restoringExpansion = true;
        await _batchGrid.ClearFilteringAsync();
        if (_hideReleased)
            await _batchGrid.FilterByColumnAsync("BatchReleased", "equal", false);
        if (_hideAssemblies)
            await _batchGrid.FilterByColumnAsync("CategoryOrder", "notequal", 1);
        if (_hideNonStock)
            await _batchGrid.FilterByColumnAsync("IsStock", "equal", true);
    }

    // ── Sort interception — keep CategoryOrder as permanent primary sort ─────
    private bool _managingSort;
    private bool _restoringExpansion;

    private async Task OnSortActionBegin(ActionEventArgs<FlatBatchPartRow> args)
    {
        await JS.InvokeVoidAsync("console.log",
            "[DBG Batches] OnSortActionBegin: requestType=" + args.RequestType +
            " col=" + args.ColumnName +
            " managingSort=" + _managingSort +
            " restoringExpansion=" + _restoringExpansion);
        if (args.RequestType != Syncfusion.Blazor.Grids.Action.Sorting || _managingSort || args.ColumnName == "CategoryOrder")
            return;
        if (_restoringExpansion) { args.Cancel = true; return; }

        args.Cancel = true;
        _managingSort = true;
        try
        {
            await _batchGrid!.SortColumnAsync("CategoryOrder", SortDirection.Ascending, false);
            await _batchGrid!.SortColumnAsync(args.ColumnName, args.Direction, true);
        }
        finally
        {
            _managingSort = false;
        }
        await RestoreExpansionAsync();
    }

    // ── State persistence ─────────────────────────────────────────────────────
    private async Task LoadStateAsync()
    {
        var state = await LocalStorage.GetAsync<BatchesGridState>(StateKey);
        if (state is null) return;
        _dateRangeDays   = state.DateRangeDays;
        _fromDate        = _dateRangeDays.HasValue ? DateTime.Today.AddDays(-_dateRangeDays.Value) : null;
        _toDate          = _dateRangeDays.HasValue ? DateTime.Today : null;
        _hideReleased    = state.HideReleased;
        _hideAssemblies  = state.HideAssemblies;
        _hideNonStock    = state.HideNonStock;
        _expandedBatchIds   = state.ExpandedBatchIds.ToHashSet();
        _expandedProductIds = state.ExpandedProductIds.ToHashSet();
    }

    private async Task SaveStateAsync()
    {
        await LocalStorage.SetAsync(StateKey, new BatchesGridState
        {
            DateRangeDays      = _dateRangeDays,
            HideReleased       = _hideReleased,
            HideAssemblies     = _hideAssemblies,
            HideNonStock       = _hideNonStock,
            ExpandedBatchIds   = _expandedBatchIds.ToList(),
            ExpandedProductIds = _expandedProductIds.ToList(),
        });
    }

    private void DebounceSaveState()
    {
        _saveCts?.Cancel();
        _saveCts = new CancellationTokenSource();
        _ = SaveAfterDelayAsync(_saveCts.Token);
    }

    private async Task SaveAfterDelayAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(400, token);
            await SaveStateAsync();
        }
        catch (OperationCanceledException) { }
        catch (Exception) { }
    }

    // ── Group expansion tracking ──────────────────────────────────────────────
    // Called from JS after user expands/collapses a group row.
    [JSInvokable]
    public void UpdateExpansionState(List<int> level1, List<int> level2)
    {
        _expandedBatchIds   = level1.ToHashSet();
        _expandedProductIds = level2.ToHashSet();
        Logger.LogWarning("[DBG Batches] UpdateExpansionState: level1=[{L1}] level2=[{L2}]",
            string.Join(",", level1), string.Join(",", level2));
        DebounceSaveState();
    }

    private record ExpandedGroupResult(List<int> Level1, List<int> Level2);

    // Re-expands saved groups after any operation that collapses them.
    // Delegates entirely to JS so row-index arithmetic stays correct as
    // Syncfusion adds rows to the DOM after each expansion.
    private async Task RestoreExpansionAsync()
    {
        if (_batchGrid is null || (_expandedBatchIds.Count == 0 && _expandedProductIds.Count == 0))
        {
            await JS.InvokeVoidAsync("console.log", "[DBG Batches] RestoreExpansionAsync: nothing to restore",
                "batches=", _expandedBatchIds.Count, "products=", _expandedProductIds.Count);
            _restoringExpansion = false;
            return;
        }
        await JS.InvokeVoidAsync("console.log", "[DBG Batches] RestoreExpansionAsync: restoring",
            "batches=", _expandedBatchIds.ToList(), "products=", _expandedProductIds.ToList());
        _ = Task.Delay(2500).ContinueWith(_ => InvokeAsync(() => { _restoringExpansion = false; }));
        try
        {
            await JS.InvokeVoidAsync("horstGrid.restoreExpansion", "BatchesGrid_v6",
                _expandedBatchIds.ToList(), _expandedProductIds.ToList());
        }
        catch (JSException) { }
    }

