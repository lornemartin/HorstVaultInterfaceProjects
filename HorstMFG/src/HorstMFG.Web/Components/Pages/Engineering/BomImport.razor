@page "/bom-import"
@attribute [Authorize(Policy = "EngineeringOnly")]
@rendermode InteractiveServer
@inject IBomService BomService
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JS
@inject BridgeNotificationService BridgeEvents
@implements IDisposable
@using HorstMFG.Infrastructure.Data
@using HorstMFG.Web.Services
@using Microsoft.EntityFrameworkCore

<PageTitle>BOM Import - HorstMFG</PageTitle>

<h3>BOM Import</h3>

@if (!string.IsNullOrEmpty(_message))
{
    <div style="padding: 0.75rem; margin-bottom: 1rem; border-radius: 0.25rem;
                background-color: @(_isError ? "#fee2e2" : "#dcfce7");
                color: @(_isError ? "#991b1b" : "#166534");">
        @_message
    </div>
}

@if (_importComplete)
{
    <div style="margin-bottom: 1rem;">
        <p>
            "@_batchName" imported successfully with @_parsedLines.Count items.
            @if (_pdfsCopied.HasValue)
            {
                <span> PDFs copied: @_pdfsCopied.Value of @_parsedLines.Select(l => l.Number).Distinct().Count().</span>
            }
        </p>
        <SfButton CssClass="e-primary" OnClick="Reset">Import Another</SfButton>
    </div>
}
else
{
    <div style="display: flex; gap: 2rem; margin-bottom: 1.5rem; align-items: flex-end; flex-wrap: wrap;">
        <div>
            <label style="display: block; font-weight: 600; margin-bottom: 0.25rem;">Import Type</label>
            <SfRadioButton Label="Batch" Name="bomType" Value="@("Batch")"
                           @bind-Checked="SelectedBomTypeStr" TChecked="string" />
            <SfRadioButton Label="Order" Name="bomType" Value="@("Order")"
                           @bind-Checked="SelectedBomTypeStr" TChecked="string"
                           style="margin-left: 1rem;" />
        </div>

        <div style="min-width: 200px;">
            <label style="display: block; font-weight: 600; margin-bottom: 0.25rem;">Plant</label>
            <SfDropDownList TValue="int" TItem="Plant"
                            @bind-Value="_selectedPlantId"
                            DataSource="_plants"
                            Enabled="_isAdmin">
                <DropDownListFieldSettings Text="Name" Value="Id" />
            </SfDropDownList>
        </div>

        @if (SelectedBomTypeStr == "Batch")
        {
            <div style="min-width: 200px;">
                <label style="display: block; font-weight: 600; margin-bottom: 0.25rem;">Batch Name</label>
                <SfTextBox @bind-Value="_batchName" Placeholder="e.g. 2026-03-04 Batch" />
            </div>
            <div style="min-width: 100px;">
                <label style="display: block; font-weight: 600; margin-bottom: 0.25rem;">Batch Qty</label>
                <SfNumericTextBox TValue="int" @bind-Value="_batchQty" Min="1" Max="9999" />
            </div>
        }
        else
        {
            <div style="min-width: 200px;">
                <label style="display: block; font-weight: 600; margin-bottom: 0.25rem;">Schedule Name</label>
                <SfTextBox @bind-Value="_batchName" Placeholder="e.g. 2026-03-04 Schedule A" />
            </div>
            <div style="min-width: 200px;">
                <label style="display: block; font-weight: 600; margin-bottom: 0.25rem;">Order Number <span style="color: #b91c1c;">*</span></label>
                <SfTextBox @bind-Value="_orderNumber" Placeholder="e.g. 12345" />
            </div>
            <div style="min-width: 100px;">
                <label style="display: block; font-weight: 600; margin-bottom: 0.25rem;">Order Qty</label>
                <SfNumericTextBox TValue="int" @bind-Value="_orderQty" Min="1" Max="9999" />
            </div>
        }
    </div>

    <div style="margin-bottom: 1.5rem;">
        <label style="display: block; font-weight: 600; margin-bottom: 0.25rem;">Upload Vault Export File</label>
        <InputFile OnChange="OnFileSelected" accept=".txt,.tsv" />
    </div>

    @if (_parsing)
    {
        <p>Parsing file...</p>
    }

    @if (_parsedLines.Count > 0)
    {
        <div style="margin-bottom: 1rem; display: flex; gap: 1rem; align-items: center;">
            <strong>@_parsedLines.Count items parsed</strong>
            <span>|</span>
            <span style="color: @(_missingPdfCount > 0 ? "#b91c1c" : "#166534");">Missing PDFs: @_missingPdfCount</span>
        </div>

        <SfGrid DataSource="_parsedLines" AllowSorting="true" AllowFiltering="true" Height="450"
                AllowSelection="true" TValue="BomExportLine">
            <GridEditSettings AllowEditing="true" Mode="Syncfusion.Blazor.Grids.EditMode.Batch" />
            <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Single" />
            <GridEvents RowSelected="OnRowSelected" RowDataBound="OnRowDataBound" TValue="BomExportLine" />
            <GridSortSettings>
                <GridSortColumns>
                    <GridSortColumn Field="@nameof(BomExportLine.SortOrder)" Direction="SortDirection.Ascending" />
                    <GridSortColumn Field="@nameof(BomExportLine.Category)" Direction="SortDirection.Ascending" />
                    <GridSortColumn Field="@nameof(BomExportLine.Operations)" Direction="SortDirection.Ascending" />
                    <GridSortColumn Field="@nameof(BomExportLine.Thickness)" Direction="SortDirection.Ascending" />
                    <GridSortColumn Field="@nameof(BomExportLine.Material)" Direction="SortDirection.Ascending" />
                </GridSortColumns>
            </GridSortSettings>
            <GridColumns>
                <GridColumn Field="@nameof(BomExportLine.SortOrder)" HeaderText="Sort" Width="0" Visible="false" />
                <GridColumn Field="@nameof(BomExportLine.HasPdf)" HeaderText="PDF" Width="70" TextAlign="TextAlign.Center"
                            DisplayAsCheckBox="true" AllowEditing="false" />
                <GridColumn Field="@nameof(BomExportLine.Number)" HeaderText="Number" Width="150" />
                <GridColumn Field="@nameof(BomExportLine.Title)" HeaderText="Title" Width="180" />
                <GridColumn Field="@nameof(BomExportLine.Category)" HeaderText="Category" Width="100" />
                <GridColumn Field="@nameof(BomExportLine.Material)" HeaderText="Material" Width="120" />
                <GridColumn Field="@nameof(BomExportLine.Thickness)" HeaderText="Thickness" Width="90" />
                <GridColumn Field="@nameof(BomExportLine.Operations)" HeaderText="Operations" Width="110" />
                <GridColumn Field="@nameof(BomExportLine.Qty)" HeaderText="Qty" Width="60" TextAlign="TextAlign.Right" />
                <GridColumn Field="@nameof(BomExportLine.IsStock)" HeaderText="Stock" Width="70" TextAlign="TextAlign.Center"
                            DisplayAsCheckBox="true" EditType="EditType.BooleanEdit" />
                <GridColumn Field="@nameof(BomExportLine.StructCode)" HeaderText="Struct Code" Width="180" />
                <GridColumn Field="@nameof(BomExportLine.Parent)" HeaderText="Parent" Width="140" />
                <GridColumn Field="@nameof(BomExportLine.Notes)" HeaderText="Notes" Width="150" />
            </GridColumns>
        </SfGrid>

        @if (_selectedLine is not null)
        {
            <div style="margin-top: 1rem; padding: 1rem; border: 1px solid #d1d5db; border-radius: 0.5rem; background: #f9fafb;">
                <h4 style="margin: 0 0 0.75rem 0;">@_selectedLine.Number — @_selectedLine.Title</h4>

                @if (_selectedLine.HasPdf)
                {
                    <iframe src="/api/pdf/@(Uri.EscapeDataString(_selectedLine.Number))"
                            style="width: 100%; height: 600px; border: 1px solid #e5e7eb; border-radius: 0.25rem;"
                            title="PDF Preview" />
                }
                else
                {
                    <div style="padding: 0.75rem; background: #fef3c7; color: #92400e; border-radius: 0.25rem; margin-bottom: 0.75rem;">
                        No PDF found on share for this item. (State: @_selectedLine.LifecycleState)
                    </div>
                    <SfButton CssClass="e-primary" OnClick="GeneratePdf" Disabled="@_generatingPdf">
                        @if (_generatingPdf)
                        {
                            <span>Generating PDF...</span>
                        }
                        else
                        {
                            <span>Generate PDF</span>
                        }
                    </SfButton>
                    @if (_generateResult is not null)
                    {
                        <div style="margin-top: 0.5rem; padding: 0.5rem; border-radius: 0.25rem;
                                    background: @(_generateSuccess ? "#dcfce7" : "#fee2e2");
                                    color: @(_generateSuccess ? "#166534" : "#991b1b");">
                            @_generateResult
                        </div>
                    }
                }
            </div>
        }

        <div style="margin-top: 1rem;">
            <SfButton CssClass="e-primary" OnClick="ImportBatch" Disabled="@(_importing || string.IsNullOrWhiteSpace(_batchName) || OrderNumberMissing)">
                @if (_importing)
                {
                    <span>Importing...</span>
                }
                else
                {
                    <span>Import to Database</span>
                }
            </SfButton>
            @if (OrderNumberMissing)
            {
                <span style="margin-left: 1rem; color: #b91c1c; font-size: 0.875rem;">Order Number is required for Order imports.</span>
            }
        </div>
    }
}

@code {
    private List<BomExportLine> _parsedLines = new();
    private List<Plant> _plants = new();
    private string SelectedBomTypeStr = "Batch";
    private BomType SelectedBomType => SelectedBomTypeStr == "Order" ? BomType.MakeToStock : BomType.MakeToOrder;
    private bool OrderNumberMissing => SelectedBomTypeStr == "Order" && string.IsNullOrWhiteSpace(_orderNumber);
    private int _selectedPlantId;
    private string _batchName = "";
    private string _orderNumber = "";
    private int _batchQty = 1;
    private int _orderQty = 1;
    private bool _parsing;
    private bool _importing;
    private bool _importComplete;
    private bool _isAdmin;
    private int _userId;
    private string? _message;
    private bool _isError;
    private BomExportLine? _selectedLine;
    private bool _generatingPdf;
    private string? _generateResult;
    private bool _generateSuccess;
    private int _missingPdfCount;
    private bool _jsReady;
    private int? _pdfsCopied;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        _plants = await db.Plants.Where(p => p.IsActive).OrderBy(p => p.Name).ToListAsync();

        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext?.User.Identity?.IsAuthenticated == true)
        {
            var userIdClaim = httpContext.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (int.TryParse(userIdClaim, out var uid))
                _userId = uid;

            var plantIdClaim = httpContext.User.FindFirst("PlantId")?.Value;
            if (int.TryParse(plantIdClaim, out var pid))
                _selectedPlantId = pid;

            _isAdmin = httpContext.User.HasClaim(ClaimTypes.Role, "Admin");
        }

        _batchName = DateTime.Now.ToString("yyyy-MM-dd");
    }

    public void Dispose()
    {
        BridgeEvents.BomExportReceived -= OnBomExportReceived;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _jsReady = true;
            BridgeEvents.BomExportReceived += OnBomExportReceived;

            // Pre-populate if the user navigated here after clicking the banner.
            // Must be here (not OnInitializedAsync) to avoid SSR pre-render consuming
            // and clearing PendingBomExport before the interactive phase runs.
            if (!string.IsNullOrEmpty(BridgeEvents.PendingBomExport))
                await LoadPendingBomExportAsync();

            var savedBomType = await JS.InvokeAsync<string?>("localStorage.getItem", "bomImport_bomType");
            if (savedBomType == "Batch" || savedBomType == "Order")
                SelectedBomTypeStr = savedBomType;

            var savedPlantId = await JS.InvokeAsync<string?>("localStorage.getItem", "bomImport_plantId");
            if (!string.IsNullOrEmpty(savedPlantId) && int.TryParse(savedPlantId, out var pid) && _isAdmin)
                _selectedPlantId = pid;

            var savedBatchName = await JS.InvokeAsync<string?>("localStorage.getItem", "bomImport_batchName");
            if (!string.IsNullOrEmpty(savedBatchName))
                _batchName = savedBatchName;

            StateHasChanged();
        }
    }

    private async Task SaveStickyValues()
    {
        if (!_jsReady) return;
        await JS.InvokeVoidAsync("localStorage.setItem", "bomImport_bomType", SelectedBomTypeStr);
        await JS.InvokeVoidAsync("localStorage.setItem", "bomImport_plantId", _selectedPlantId.ToString());
        await JS.InvokeVoidAsync("localStorage.setItem", "bomImport_batchName", _batchName);
    }

    private void OnBomExportReceived(int stationId, string fileContents)
    {
        _ = InvokeAsync(async () => await LoadPendingBomExportAsync());
    }

    private async Task LoadPendingBomExportAsync()
    {
        var contents = BridgeEvents.PendingBomExport;
        if (string.IsNullOrEmpty(contents)) return;

        if (_importComplete)
            Reset();

        _parsing = true;
        _message = null;
        _parsedLines.Clear();
        StateHasChanged();

        try
        {
            var bytes = System.Text.Encoding.UTF8.GetBytes(contents);
            using var ms = new MemoryStream(bytes);
            _parsedLines     = BomService.ParseExportFile(ms, SelectedBomType);
            _missingPdfCount = _parsedLines.Count(l => !l.HasPdf);
            _message = $"BOM auto-loaded from Vault export — {_parsedLines.Count} item(s). Select import type and fill in name/qty, then click Import.";
            _isError = false;
            BridgeEvents.ClearPendingBomExport();
        }
        catch (Exception ex)
        {
            _message = $"Error parsing auto-loaded BOM: {ex.Message}";
            _isError = true;
        }
        finally
        {
            _parsing = false;
            StateHasChanged();
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _parsing = true;
        _message = null;
        _parsedLines.Clear();
        StateHasChanged();

        try
        {
            var file = e.File;
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            _parsedLines = BomService.ParseExportFile(ms, SelectedBomType);
            _missingPdfCount = _parsedLines.Count(l => !l.HasPdf);

            if (_parsedLines.Count == 0)
            {
                _message = "No items found in the file. Make sure it is a valid Vault Item Export file.";
                _isError = true;
            }

            if (_batchName == DateTime.Now.ToString("yyyy-MM-dd"))
            {
                var baseName = Path.GetFileNameWithoutExtension(file.Name);
                if (baseName != "VaultExportData")
                    _batchName = $"{DateTime.Now:yyyy-MM-dd} {baseName}";
            }
        }
        catch (Exception ex)
        {
            _message = $"Error parsing file: {ex.Message}";
            _isError = true;
        }
        finally
        {
            _parsing = false;
        }
    }

    private async Task ImportBatch()
    {
        if (_parsedLines.Count == 0 || string.IsNullOrWhiteSpace(_batchName)) return;
        if (OrderNumberMissing) return;

        _importing = true;
        _message = null;
        _pdfsCopied = null;
        StateHasChanged();

        try
        {
            if (SelectedBomTypeStr == "Order")
            {
                var schedule = await BomService.ImportScheduleAsync(
                    _batchName, _orderNumber.Trim(), _orderQty, _selectedPlantId, _userId, _parsedLines);
                _pdfsCopied = _parsedLines.Count(l => l.HasPdf);
            }
            else
            {
                var batch = await BomService.ImportBatchAsync(
                    _batchName, _batchQty, _selectedPlantId, _userId, _parsedLines);
                _pdfsCopied = _parsedLines.Count(l => l.HasPdf);
            }

            await SaveStickyValues();
            _importComplete = true;
        }
        catch (Exception ex)
        {
            _message = $"Error importing: {ex.Message}";
            _isError = true;
        }
        finally
        {
            _importing = false;
        }
    }

    private void OnRowDataBound(RowDataBoundEventArgs<BomExportLine> args)
    {
        if (!args.Data.HasPdf)
            args.Row.AddClass(new[] { "row-no-pdf" });
        if (!string.IsNullOrWhiteSpace(args.Data.Notes))
            args.Row.AddClass(new[] { "row-has-notes" });
    }

    private void OnRowSelected(RowSelectEventArgs<BomExportLine> args)
    {
        _selectedLine = args.Data;
        _generateResult = null;
    }

    private async Task GeneratePdf()
    {
        if (_selectedLine is null) return;

        _generatingPdf = true;
        _generateResult = null;
        StateHasChanged();

        try
        {
            var success = await BomService.GeneratePdfAsync(_selectedLine.Number);
            _generateSuccess = success;
            if (success)
            {
                _selectedLine.HasPdf = true;
                _missingPdfCount = _parsedLines.Count(l => !l.HasPdf);
                _generateResult = $"PDF generated successfully for {_selectedLine.Number}.";
            }
            else
            {
                _generateResult = $"PDF generation failed for {_selectedLine.Number}. Check logs for details.";
            }
        }
        catch (Exception ex)
        {
            _generateSuccess = false;
            _generateResult = $"Error: {ex.Message}";
        }
        finally
        {
            _generatingPdf = false;
        }
    }

    private void Reset()
    {
        _parsedLines.Clear();
        _importComplete = false;
        _orderNumber = "";
        _batchQty = 1;
        _orderQty = 1;
        _message = null;
        _isError = false;
        _selectedLine = null;
        _generateResult = null;
        _missingPdfCount = 0;
        _pdfsCopied = null;
    }
}
