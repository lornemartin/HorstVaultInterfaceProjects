@page "/engineering/orders"
@attribute [Authorize(Policy = "Engineering")]
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JS
@inject IBomService BomService
@inject HorstMFG.Web.Services.ExcelScheduleImportService ScheduleImportSvc
@inject Microsoft.AspNetCore.SignalR.IHubContext<HorstMFG.Web.Hubs.BridgeHub> HubContext
@inject HorstMFG.Web.Services.LocalStorageService LocalStorage
@using HorstMFG.Core.DTOs
@using HorstMFG.Infrastructure.Data
@using HorstMFG.Web.Hubs
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.Popups
@using HorstMFG.Web.Components.Shared
@using HorstMFG.Web.Services
@implements IAsyncDisposable

<PageTitle>Orders - HorstMFG</PageTitle>

@if (_releasing)
{
    <div class="loading-overlay">
        <div class="spinner"></div>
        <span class="spinner-label">Releasing to production…</span>
    </div>
}

@if (_loading)
{
    <div class="loading-overlay">
        <div class="spinner"></div>
        <span class="spinner-label">Loading…</span>
    </div>
}

<h3>Orders</h3>

@if (_statusMessage is not null)
{
    <div style="padding: 0.5rem 0.75rem; border-radius: 4px; margin-bottom: 0.75rem;
                background: @(_statusIsError ? "#fee2e2" : "#dcfce7");
                color: @(_statusIsError ? "#991b1b" : "#166534"); font-size: 0.875rem;">
        @_statusMessage
    </div>
}

<div style="display: flex; gap: 2rem; margin-bottom: 1rem; align-items: flex-end; flex-wrap: wrap;">
    <div style="min-width: 200px;">
        <label style="display: block; font-weight: 600; margin-bottom: 0.25rem;">Plant</label>
        <SfDropDownList TValue="int?" TItem="PlantOption"
                        Value="_selectedPlantId"
                        ValueChanged="OnPlantChanged"
                        DataSource="_plantOptions"
                        Enabled="_isAdmin">
            <DropDownListFieldSettings Text="Name" Value="Id" />
        </SfDropDownList>
    </div>

    <div>
        <label style="display: block; font-weight: 600; margin-bottom: 0.25rem;">Date range</label>
        <div style="display: flex; gap: 0.5rem;">
            <SfButton OnClick="@(() => SetDateRange(30))">30 days</SfButton>
            <SfButton OnClick="@(() => SetDateRange(60))">60 days</SfButton>
            <SfButton OnClick="@(() => SetDateRange(90))">90 days</SfButton>
            <SfButton OnClick="@(() => SetDateRange(null))">All</SfButton>
        </div>
    </div>

    <div style="min-width: 240px;">
        <label style="display: block; font-weight: 600; margin-bottom: 0.25rem;">Search</label>
        <input type="text" value="@_searchTerm" @oninput="OnSearchInput"
               placeholder="Order name, part number, description…"
               style="width: 100%; padding: 0.375rem 0.5rem; border: 1px solid #d1d5db; border-radius: 4px; font-size: 0.875rem;" />
    </div>

    <div style="display: flex; flex-direction: column; gap: 0.4rem; padding-bottom: 0.25rem;">
        <label style="display: flex; align-items: center; gap: 0.4rem; cursor: pointer; font-size: 0.875rem;">
            <input type="checkbox" @bind="_hideStock" @bind:after="OnHideStockChanged" />
            Hide stock parts
        </label>
        <label style="display: flex; align-items: center; gap: 0.4rem; cursor: pointer; font-size: 0.875rem;">
            <input type="checkbox" @bind="_hideReleased" @bind:after="OnHideReleasedChanged" />
            Hide released
        </label>
        <label style="display: flex; align-items: center; gap: 0.4rem; cursor: pointer; font-size: 0.875rem;">
            <input type="checkbox" @bind="_crossPlantOnly" @bind:after="OnCrossPlantOnlyChanged" />
            Cross-plant only
        </label>
    </div>
</div>

<SfGrid TValue="FlatSchedulePartRow" @ref="_schedGrid" ID="@GridId"
        DataSource="_rows" AllowGrouping="true" AllowSorting="false" AllowFiltering="true" EnablePersistence="true"
        AllowResizing="true" Height="600">
    <GridGroupSettings ShowGroupedColumn="false" ShowDropArea="false" EnableLazyLoading="true"
                       Columns="@(new[] { "ScheduleId", "ScheduleOrderId" })">
        <CaptionTemplate>
            @{
                var ctx = context as CaptionTemplateContext;
                var key = Convert.ToInt32(ctx!.Key);
            }
            @if (ctx.Field == "ScheduleId" && _scheduleMeta.TryGetValue(key, out var sched))
            {
                <span data-group-key="@sched.Id" data-group-level="1" style="display:none;"></span>
                @if (sched.IsReleased)
                {
                    <span class="released-marker" style="display:none;"></span>
                    <span style="margin-right: 0.4rem; opacity: 0.75;" title="Released to production">&#128274;</span>
                }
                <CrossPlantMarker PartPlantId="_selectedPlantId" ParentPlantId="sched.PlantId"
                                  ViewerPlantId="_selectedPlantId" Plants="_plantLabels" Subject="schedule" ShowStatus="false" />
                <span style="font-weight: 700; font-size: 1rem;">@sched.Name</span>
                <span style="margin-left: 1rem; color: #6b7280; font-size: 0.8rem;">
                    @sched.ImportDate.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")
                </span>
                <span style="margin-left: 0.75rem; color: #6b7280; font-size: 0.8rem;">
                    (@ctx.Count part@(ctx.Count != 1 ? "s" : ""))
                </span>
                @if (_scheduleMissingPdfCount.TryGetValue(sched.Id, out var scheduleMissing) && scheduleMissing > 0)
                {
                    <span style="margin-left: 0.5rem; color: #b91c1c; font-size: 0.75rem; font-weight: 600;">
                        &#9888; @scheduleMissing missing PDF@(scheduleMissing != 1 ? "s" : "")
                    </span>
                }
                <span style="margin-left: 1.5rem; display: inline-flex; gap: 0.4rem; align-items: center;">
                    @if (!sched.IsReleased && sched.PlantId == _selectedPlantId)
                    {
                        @if (_orderMeta.Values.Any(o => o.ScheduleId == sched.Id && !o.VaultBomImported && !string.IsNullOrEmpty(o.ProductNumber)))
                        {
                            <button @onclick="@(async () => await OnRetrySchedulePending(sched.Id))" @onclick:stopPropagation="true"
                                    style="@BtnStyle("e-primary")">Re-import pending</button>
                        }
                        <button @onclick="@(async () => await OnReleaseSchedule(sched))" @onclick:stopPropagation="true"
                                style="@BtnStyle("e-primary")">Release to Production</button>
                        <button @onclick="@(async () => await OnDeleteSchedule(sched))" @onclick:stopPropagation="true"
                                style="@BtnStyle("danger")">Delete</button>
                        @if (DraftHandoffCountForSchedule(sched.Id) is var draftCount && draftCount > 0)
                        {
                            <button @onclick="@(async () => await OnNotifyScheduleHandoffs(sched))" @onclick:stopPropagation="true"
                                    style="@BtnStyle("e-primary")" title="Send @draftCount queued cross-plant item(s) to @DraftHandoffPlantNameForSchedule(sched.Id)">
                                Notify @DraftHandoffPlantNameForSchedule(sched.Id) (@draftCount)
                            </button>
                        }
                        <span style="border-left: 1px solid #d1d5db; height: 18px; margin: 0 0.2rem;"></span>
                    }
                    else if (AcceptedUnreleasedCountForSchedule(sched.Id) is var acceptedCount && acceptedCount > 0)
                    {
                        <button @onclick="@(async () => await OnReleaseScheduleHandoffs(sched))" @onclick:stopPropagation="true"
                                style="@BtnStyle("e-primary")" title="Release @acceptedCount accepted item(s) to production">
                            Release to Production (@acceptedCount)
                        </button>
                        <span style="border-left: 1px solid #d1d5db; height: 18px; margin: 0 0.2rem;"></span>
                    }
                    @* The traveller belongs to the plant doing the assembly; hide it on incoming schedules. *@
                    @if (_selectedPlantId is not { } viewerPlantId || viewerPlantId == sched.PlantId)
                    {
                        <button @onclick="@(async () => await OpenReport("schedule-traveller", sched.Id))" @onclick:stopPropagation="true"
                                style="@BtnStyle("")">Shop Traveller</button>
                    }
                    <button @onclick="@(() => _printDialog!.ShowAsync(ReportSource.Schedule, sched.Id, sched.Name, _selectedPlantId ?? sched.PlantId))"
                            @onclick:stopPropagation="true" style="@BtnStyle("")">Print drawings…</button>
                    @if (_scheduleCustomPlantValues.TryGetValue(sched.Id, out var customPlantValues) && customPlantValues.Count > 0)
                    {
                        <select @bind:get="GetCustomPlantSelection(sched.Id)"
                                @bind:set="@((string v) => OnCustomPlantReportSelected(sched.Id, sched.Name, v))"
                                @onclick:stopPropagation="true"
                                title="Print a report of just the parts marked with a custom Plant value"
                                style="border: 1px solid #d1d5db; border-radius: 3px; padding: 2px 4px; font-size: 0.8rem;">
                            <option value="">Custom Report…</option>
                            @foreach (var val in customPlantValues)
                            {
                                <option value="@val">@val</option>
                            }
                        </select>
                    }
                </span>
            }
            else if (ctx.Field == "ScheduleOrderId" && _orderMeta.TryGetValue(key, out var order))
            {
                <span data-group-key="@order.Id" data-group-level="2" style="display:none;"></span>
                <CrossPlantMarker PartPlantId="_selectedPlantId" ParentPlantId="_scheduleMeta.GetValueOrDefault(order.ScheduleId)?.PlantId ?? _selectedPlantId ?? 0"
                                  ViewerPlantId="_selectedPlantId" Plants="_plantLabels" Subject="order"
                                  Status="_scheduleOrderHandoffs.GetValueOrDefault(order.Id)?.Status" />
                @if (order.IsReleased)
                {
                    <span class="released-marker" style="display:none;"></span>
                    <span style="margin-right: 0.4rem; opacity: 0.75;" title="Released to production">&#128274;</span>
                    @if (order.ProductNumber is not null)
                    {
                        <span style="font-style: italic; color: #374151; margin-right: 0.5rem;">@order.ProductNumber</span>
                    }
                }
                else
                {
                    <input type="text" value="@order.ProductNumber"
                           @onchange="@(async e => await OnScheduleOrderProductNumberChanged(order.Id, e.Value?.ToString()))"
                           @onkeydown="@(async e => { if (e.Key == "Enter") await JS.InvokeVoidAsync("eval", "document.activeElement.blur()"); })"
                           @onclick:stopPropagation="true"
                           @onkeydown:stopPropagation="true"
                           @onkeyup:stopPropagation="true"
                           placeholder="product number"
                           title="Edit product number, press Enter or click elsewhere to save"
                           style="width: 170px; font-style: italic; border: 1px solid #d1d5db; border-radius: 3px; padding: 1px 4px; font-size: 0.875rem; color: #374151;" />
                }
                <span style="font-weight: 700; margin-left: 0.35rem;">@order.OrderNumber</span>
                @if (order.ProductDescription is not null)
                {
                    <span style="margin-left: 0.75rem; color: #6b7280; font-size: 0.85rem;">@order.ProductDescription</span>
                }
                <span style="margin-left: 0.75rem; display: inline-flex; gap: 0.35rem;">
                    <button @onclick="@(async () => await OpenOrderReport("order-subassemblies", order.Id))" @onclick:stopPropagation="true"
                            style="@BtnStyle("")" title="Print all sub-assemblies for this order">Sub-Assemblies</button>
                    <button @onclick="@(async () => await OpenOrderReport("order-assemblies-parts", order.Id))" @onclick:stopPropagation="true"
                            style="@BtnStyle("")" title="Print all assemblies and parts for this order">Assemblies + Parts</button>
                </span>
                @if (_orderMissingPdfCount.TryGetValue(order.Id, out var orderMissing) && orderMissing > 0)
                {
                    <span style="margin-left: 0.5rem; color: #b91c1c; font-size: 0.75rem; font-weight: 600;">
                        &#9888; @orderMissing missing PDF@(orderMissing != 1 ? "s" : "")
                    </span>
                }
                <span style="margin-left: 1.5rem; display: inline-flex; gap: 0.5rem; align-items: center;">
                    <span style="font-size: 0.8rem; color: #6b7280;">Plant:</span>
                    @if (order.IsReleased || !IsSenderForSchedule(order.ScheduleId))
                    {
                        <strong>@(_plantOptions.FirstOrDefault(o => o.Id == order.PlantId)?.Name ?? "—")</strong>
                    }
                    else
                    {
                        <select value="@order.PlantId"
                                @onchange="@(async e => await OnScheduleOrderPlantChanged(order.Id, e.Value?.ToString() ?? ""))"
                                @onclick:stopPropagation="true"
                                style="border: 1px solid #d1d5db; border-radius: 3px; padding: 1px 3px; font-weight: 600;">
                            @foreach (var opt in _plantOptions.Where(o => o.Id.HasValue))
                            {
                                <option value="@opt.Id" selected="@(opt.Id == order.PlantId)">@opt.Name</option>
                            }
                        </select>
                    }
                </span>
                <span style="margin-left: 1.5rem; display: inline-flex; gap: 0.5rem; align-items: center;">
                    <span style="font-size: 0.8rem; color: #6b7280;">Qty:</span>
                    @if (order.IsReleased || !IsSenderForSchedule(order.ScheduleId))
                    {
                        <strong>@order.Qty</strong>
                    }
                    else
                    {
                        <input type="number" value="@order.Qty"
                               @onchange="@(async e => await OnScheduleOrderQtyChanged(order.Id, e.Value?.ToString() ?? ""))"
                               @onclick:stopPropagation="true"
                               min="1" max="9999"
                               style="width: 58px; text-align: right; border: 1px solid #d1d5db; border-radius: 3px; padding: 1px 3px; font-weight: 600;" />
                        @if (_importingOrderIds.Contains(order.Id) && !order.VaultBomImported)
                        {
                            <span style="display:inline-flex;align-items:center;gap:0.3rem;color:#3b82f6;font-size:0.8rem;">
                                <span style="display:inline-block;width:12px;height:12px;border:2px solid #bfdbfe;border-top-color:#3b82f6;border-radius:50%;animation:spin 0.8s linear infinite;flex-shrink:0;"></span>
                                Importing…
                            </span>
                        }
                        else if (!order.VaultBomImported && !string.IsNullOrEmpty(order.ProductNumber))
                        {
                            @if (_importErrorByOrderId.TryGetValue(order.Id, out var importErr))
                            {
                                <span style="color:#dc2626;font-size:0.75rem;margin-right:0.25rem;">@importErr —</span>
                            }
                            <button @onclick="@(async () => await OnRetryOrder(order.Id))" @onclick:stopPropagation="true"
                                    style="@BtnStyle("e-primary")">Re-import BOM</button>
                        }
                        else if (!string.IsNullOrEmpty(order.ProductNumber) && _forceReimportOrderIds.Contains(order.Id))
                        {
                            <button @onclick="@(async () => await OnRetryOrder(order.Id))" @onclick:stopPropagation="true"
                                    style="@BtnStyle("e-primary")">Re-import BOM</button>
                        }
                        else if (!string.IsNullOrEmpty(order.ProductNumber))
                        {
                            <button @onclick="@(() => _forceReimportOrderIds.Add(order.Id))" @onclick:stopPropagation="true"
                                    style="border: none; background: none; padding: 0 4px; cursor: pointer; color: #9ca3af; font-size: 0.9rem;"
                                    title="Show re-import option">&#8942;</button>
                        }
                        <button @onclick="@(async () => await OnDeleteOrder(order))" @onclick:stopPropagation="true"
                                style="@BtnStyle("danger")">Delete</button>
                    }
                </span>
                @if (_scheduleOrderHandoffs.TryGetValue(order.Id, out var handoff))
                {
                    <span style="margin-left: 1.5rem; display: inline-flex; gap: 0.5rem; align-items: center; font-size: 0.8rem;">
                        @if (IsSenderForSchedule(order.ScheduleId))
                        {
                            <span style="color: #6b7280;">&#8594; @handoff.DestinationPlantName:</span>
                            @if (handoff.Status == HandoffStatus.Draft)
                            {
                                <span style="color: #6b7280;">Draft (not yet sent)</span>
                            }
                            else if (handoff.Status == HandoffStatus.Pending)
                            {
                                <span style="color: #92400e;">Pending</span>
                            }
                            else if (handoff.Status == HandoffStatus.Accepted && !handoff.ReleasedDate.HasValue)
                            {
                                <span style="color: #166534;">Accepted by @handoff.AcceptedByUserName</span>
                            }
                            else if (handoff.Status == HandoffStatus.Accepted && handoff.ReleasedDate.HasValue)
                            {
                                <span style="color: #166534;">Accepted by @handoff.AcceptedByUserName — released by @handoff.ReleasedByUserName</span>
                            }
                            else if (handoff.Status == HandoffStatus.Rejected)
                            {
                                <span style="color: #991b1b;">Rejected by @handoff.RejectedByUserName: @handoff.RejectionReason</span>
                                <button @onclick="@(async () => await OnResubmitScheduleOrderHandoff(order.Id, handoff.DestinationPlantId, handoff.DestinationPlantName))"
                                        @onclick:stopPropagation="true" style="@BtnStyle("e-primary")">Resubmit</button>
                            }
                        }
                        else
                        {
                            <span style="color: #6b7280;">(from @OriginPlantNameForSchedule(order.ScheduleId))</span>
                            @if (handoff.Status == HandoffStatus.Pending)
                            {
                                <button @onclick="@(async () => await OnAcceptScheduleOrderHandoff(handoff.Id))" @onclick:stopPropagation="true"
                                        style="@BtnStyle("e-primary")">Accept</button>
                                <button @onclick="@(() => OnRejectScheduleOrderHandoffClicked(handoff.Id, order.OrderNumber))" @onclick:stopPropagation="true"
                                        style="@BtnStyle("danger")">Reject</button>
                            }
                            else if (handoff.Status == HandoffStatus.Accepted && !handoff.ReleasedDate.HasValue)
                            {
                                <span style="color: #166534;">Accepted</span>
                            }
                            else if (handoff.Status == HandoffStatus.Accepted && handoff.ReleasedDate.HasValue)
                            {
                                <span style="color: #166534;">Released</span>
                            }
                        }
                    </span>
                }
            }
            else
            {
                <span style="font-weight: 600;">@ctx.Key</span>
                <span style="margin-left: 0.5rem; color: #6b7280; font-size: 0.8rem;">(@ctx.Count)</span>
            }
        </CaptionTemplate>
    </GridGroupSettings>
    <GridSortSettings>
        <GridSortColumns>
            <GridSortColumn Field="CategoryOrder"   Direction="SortDirection.Ascending" />
            <GridSortColumn Field="IsStock"         Direction="SortDirection.Ascending" />
            <GridSortColumn Field="Operations"      Direction="SortDirection.Ascending" />
            <GridSortColumn Field="ThicknessOrder"  Direction="SortDirection.Ascending" />
        </GridSortColumns>
    </GridSortSettings>
    <GridEvents TValue="FlatSchedulePartRow" RowDataBound="OnRowDataBound" />
    <GridColumns>
        <GridColumn Field="ScheduleId" Visible="false" Width="0" />
        <GridColumn Field="ScheduleOrderId" Visible="false" Width="0" />
        <GridColumn Field="PartLineItemId" IsPrimaryKey="true" Visible="false" Width="0" />
        <GridColumn Field="CategoryOrder"    Visible="false" Width="0" />
        <GridColumn Field="ThicknessOrder"   Visible="false" Width="0" />
        <GridColumn Field="ScheduleReleased" Visible="false" Width="0" />
        <GridColumn Field="IsCrossPlant"     Visible="false" Width="0" />
        <GridColumn Field="PartNumber" HeaderText="Number" Width="300">
            <Template>
                @{
                    var row = context as FlatSchedulePartRow;
                    if (row!.ScheduleReleased)
                    {
                        <span style="margin-right: 0.4rem; opacity: 0.75;" title="Released to production">&#128274;</span>
                    }
                    <CrossPlantMarker PartPlantId="row.PlantId" ParentPlantId="row.SchedulePlantId"
                                      ViewerPlantId="_selectedPlantId" Plants="_plantLabels" ParentKind="order"
                                      Status="_scheduleOrderHandoffs.GetValueOrDefault(row.ScheduleOrderId)?.Status" />
                    if (row.HasPdf)
                    {
                        <a href="/api/pdf-local/@Uri.EscapeDataString(row.PartNumber)" target="_blank"
                           @onclick:stopPropagation="true"
                           style="margin-right: 0.4rem; color: #3b82f6; font-size: 0.75rem; text-decoration: none;"
                           title="View PDF">&#x1F4C4;</a>
                        <span @onmouseenter="@(e => OnThumbEnter(row.PartNumber, e))"
                              @onmouseleave="OnThumbLeave"
                              style="cursor: default;">
                            @row.PartNumber
                        </span>
                    }
                    else if (row.RequiresPdf)
                    {
                        @if (_refreshingPartIds.Contains(row.PartLineItemId))
                        {
                            <span style="margin-right: 0.4rem; font-size: 0.75rem;" title="Checking share…">&#8987;</span>
                        }
                        else
                        {
                            <button @onclick="@(async () => await OnRefreshPdf(row))" @onclick:stopPropagation="true"
                                    style="margin-right: 0.4rem; border: none; background: none; padding: 0; cursor: pointer; font-size: 0.75rem;"
                                    title="Re-check the share for this PDF">&#x1F504;</button>
                        }
                        <span style="color: #b91c1c;" title="PDF required but missing">@row.PartNumber</span>
                    }
                    else
                    {
                        <span>@row.PartNumber</span>
                    }
                }
            </Template>
        </GridColumn>
        <GridColumn Field="Description" HeaderText="Description" Width="220" />
        <GridColumn Field="Category" HeaderText="Category" Width="100" />
        <GridColumn Field="Material" HeaderText="Material" Width="120" />
        <GridColumn Field="Thickness" HeaderText="Thickness" Width="90" />
        <GridColumn Field="Operations" HeaderText="Operations" Width="110" />
        <GridColumn Field="SecondOperation" HeaderText="2nd Op" Width="110" />
        <GridColumn Field="FinishOps" HeaderText="Finish" Width="100" />
        <GridColumn Field="Qty" HeaderText="Qty" Width="70" TextAlign="TextAlign.Right" />
        <GridColumn Field="PlantId" HeaderText="Plant" Width="110">
            <Template>
                @{
                    var row = context as FlatSchedulePartRow;
                }
                @if (_customPlantEditIds.Contains(row!.PartLineItemId))
                {
                    <input type="text" value="@(row.PlantIdRaw ?? "")"
                           @onchange="@(async e => await OnPartPlantRawChanged(row, e.Value?.ToString() ?? ""))"
                           @onclick:stopPropagation="true"
                           placeholder="Custom plant…"
                           style="width: 100%; border: 1px solid #d1d5db; border-radius: 3px; padding: 1px 3px;" />
                }
                else
                {
                    var currentValue = row.PlantId?.ToString() ?? (row.PlantIdRaw is not null ? "custom:" + row.PlantIdRaw : "");
                    <select value="@currentValue"
                            @onchange="@(async e => await OnPartPlantSelectChanged(row, e.Value?.ToString() ?? ""))"
                            @onclick:stopPropagation="true"
                            style="width: 100%; border: 1px solid #d1d5db; border-radius: 3px; padding: 1px 3px;">
                        @foreach (var opt in _plantOptions.Where(o => o.Id.HasValue))
                        {
                            <option value="@opt.Id" selected="@(currentValue == opt.Id.ToString())">@opt.Name</option>
                        }
                        @if (_scheduleCustomPlantValues.TryGetValue(row.ScheduleId, out var customVals))
                        {
                            @foreach (var cv in customVals)
                            {
                                <option value="@("custom:" + cv)" selected="@(currentValue == "custom:" + cv)">@cv</option>
                            }
                        }
                        <option value="__other__">Other…</option>
                    </select>
                }
            </Template>
        </GridColumn>
        <GridColumn Field="IsStock" HeaderText="Stock" Width="70" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var row = context as FlatSchedulePartRow;
                    var stockLocked = row!.ScheduleReleased || IsHandoffReleasedForRow(row);
                    <input type="checkbox" checked="@row.IsStock"
                           @onchange="@(async e => await OnIsStockChanged(row, (bool)e.Value!))"
                           disabled="@stockLocked"
                           style="cursor: @(stockLocked ? "default" : "pointer"); width: 16px; height: 16px;" />
                }
            </Template>
        </GridColumn>
        <GridColumn Field="HasPdf" HeaderText="PDF" Width="60" DisplayAsCheckBox="true" TextAlign="TextAlign.Center" />
        <GridColumn Field="Notes" HeaderText="Notes" Width="150" />
    </GridColumns>
</SfGrid>

@if (_thumbNumber is not null)
{
    <div style="position:fixed; left:@(_thumbX)px; top:@(_thumbY)px; z-index:9999;
                background:#fff; border:1px solid #dee2e6; border-radius:4px;
                box-shadow:0 4px 16px rgba(0,0,0,.18); padding:4px; pointer-events:none;">
        <img src="/api/pdf-thumbnail/@Uri.EscapeDataString(_thumbNumber)" loading="lazy"
             style="display:block; width:220px; height:auto;"
             onerror="this.parentElement.style.display='none'" />
    </div>
}

<PrintDrawingsDialog @ref="_printDialog" Plants="_plantLabels" />

<SfDialog @bind-Visible="_showStockDialog" Width="440px" IsModal="true" ShowCloseIcon="true"
          Header="Update Stock Flag" AllowDragging="true">
    <DialogTemplates>
        <Content>
            @if (_stockDialogRow is not null)
            {
                <p>Part <strong>@_stockDialogRow.PartNumber</strong> appears <strong>@_stockDialogSiblingCount</strong>
                   time@(_stockDialogSiblingCount != 1 ? "s" : "") in this schedule.</p>
                <p>Update all instances or just this one?</p>
            }
        </Content>
        <FooterTemplate>
            <SfButton OnClick="OnStockDialogCancel">Cancel</SfButton>
            <SfButton OnClick="OnStockDialogThisOnly" CssClass="e-outline" style="margin-left: 8px;">This part only</SfButton>
            <SfButton OnClick="OnStockDialogAll" CssClass="e-primary" style="margin-left: 8px;">
                All @_stockDialogSiblingCount instance@(_stockDialogSiblingCount != 1 ? "s" : "")
            </SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<SfDialog @bind-Visible="_showPlantDialog" Width="440px" IsModal="true" ShowCloseIcon="true"
          Header="Update Plant" AllowDragging="true">
    <DialogTemplates>
        <Content>
            @if (_plantDialogRow is not null)
            {
                <p>Part <strong>@_plantDialogRow.PartNumber</strong> appears <strong>@_plantDialogSiblingCount</strong>
                   time@(_plantDialogSiblingCount != 1 ? "s" : "") in this schedule.</p>
                <p>Update all instances or just this one?</p>
            }
        </Content>
        <FooterTemplate>
            <SfButton OnClick="OnPlantDialogCancel">Cancel</SfButton>
            <SfButton OnClick="OnPlantDialogThisOnly" CssClass="e-outline" style="margin-left: 8px;">This part only</SfButton>
            <SfButton OnClick="OnPlantDialogAll" CssClass="e-primary" style="margin-left: 8px;">
                All @_plantDialogSiblingCount instance@(_plantDialogSiblingCount != 1 ? "s" : "")
            </SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<SfDialog @bind-Visible="_showRejectHandoffDialog" Width="440px" IsModal="true" ShowCloseIcon="true"
          Header="Reject Cross-Plant Handoff" AllowDragging="true">
    <DialogTemplates>
        <Content>
            @if (_rejectHandoffOrderNumber is not null)
            {
                <p>Reject the handoff of <strong>@_rejectHandoffOrderNumber</strong>?</p>
                <label style="display: block; font-weight: 600; margin-bottom: 0.25rem;">Reason</label>
                <textarea @bind="_rejectReason" rows="3"
                          style="width: 100%; border: 1px solid #d1d5db; border-radius: 4px; padding: 0.4rem;"
                          placeholder="Why is this being rejected?"></textarea>
            }
        </Content>
        <FooterTemplate>
            <SfButton OnClick="OnRejectHandoffCancel">Cancel</SfButton>
            <SfButton OnClick="OnRejectHandoffConfirm" CssClass="e-primary" style="margin-left: 8px;">Reject</SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    // ── Data ─────────────────────────────────────────────────────────────────
    private List<FlatSchedulePartRow> _rows = new();
    private Dictionary<int, ScheduleCaption> _scheduleMeta = new();
    private Dictionary<int, OrderCaption> _orderMeta = new();
    private Dictionary<int, int> _scheduleMissingPdfCount = new();
    private Dictionary<int, int> _orderMissingPdfCount = new();
    private Dictionary<int, List<string>> _scheduleCustomPlantValues = new();
    private Dictionary<int, string> _customPlantReportSelection = new();

    private sealed record ScheduleCaption(int Id, string Name, DateTime ImportDate, bool IsReleased, int PlantId);
    private sealed record OrderCaption(int Id, int ScheduleId, string? OrderNumber, int Qty, bool IsReleased,
                                       string? ProductNumber, string? ProductDescription, bool VaultBomImported, int PlantId);

    private sealed record HandoffCaptionInfo(int Id, int DestinationPlantId, string DestinationPlantName, HandoffStatus Status,
        DateTime? AcceptedDate, string? AcceptedByUserName, DateTime? RejectedDate, string? RejectedByUserName, string? RejectionReason,
        DateTime? ReleasedDate, string? ReleasedByUserName);

    // ── Persisted state ───────────────────────────────────────────────────────
    private sealed class OrdersGridState
    {
        public int?       DateRangeDays      { get; set; } = 30;
        public bool       HideStock          { get; set; } = true;
        public bool       HideReleased       { get; set; } = false;
        public bool       CrossPlantOnly     { get; set; } = false;
        public List<int>  ExpandedScheduleIds { get; set; } = new();
        public List<int>  ExpandedOrderIds    { get; set; } = new();
    }
    private const string StateKey = "horstmfg.orders.grid.state";
    // Bump the version whenever the grid's columns change — Syncfusion persists column layout
    // under this ID, and restoring a stale layout over a changed column set scrambles the order.
    private const string GridId = "OrdersGrid_v8";

    // ── UI state ─────────────────────────────────────────────────────────────
    private SfGrid<FlatSchedulePartRow>? _schedGrid;
    private List<PlantOption> _plantOptions = new();
    private Dictionary<int, (string Code, string Name)> _plantLabels = new();
    private int? _selectedPlantId;
    private PrintDrawingsDialog? _printDialog;
    private int? _userId;
    private bool _isAdmin;
    private bool _releasedOnly;
    private bool _releasing;
    private bool _loading;
    private int?      _dateRangeDays = 30;
    private DateTime? _fromDate = DateTime.Today.AddDays(-30);
    private DateTime? _toDate = DateTime.Today;
    private string _searchTerm = "";
    private bool _hideStock = true;
    private bool _hideReleased = false;
    private bool _crossPlantOnly = false;
    private HashSet<int> _expandedScheduleIds = new();
    private HashSet<int> _expandedOrderIds    = new();
    private CancellationTokenSource? _searchCts;
    private CancellationTokenSource? _saveCts;
    private CancellationTokenSource? _pollCts;
    private DotNetObjectReference<DailySchedule>? _dotNetRef;

    // Orders currently being polled for VaultBomImported completion
    private HashSet<int> _importingOrderIds = new();
    private Dictionary<int, string> _importErrorByOrderId = new();

    // Orders where the user has manually revealed the Re-import BOM button
    // (hidden by default once an order has successfully imported).
    private HashSet<int> _forceReimportOrderIds = new();
    private int? _activePartLineItemId;

    // Part rows where the user clicked "Other…" to type a custom Plant value
    private HashSet<int> _customPlantEditIds = new();

    // Status message (retry feedback)
    private string? _statusMessage;
    private bool _statusIsError;

    // PDF thumbnail hover
    private string? _thumbNumber;
    private double _thumbX, _thumbY;

    // PDF refresh
    private HashSet<int> _refreshingPartIds = new();

    // Stock dialog
    private bool _showStockDialog;
    private FlatSchedulePartRow? _stockDialogRow;
    private bool _stockDialogNewValue;
    private int _stockDialogSiblingCount;
    private double _stockDialogScrollTop;

    private bool _showPlantDialog;
    private FlatSchedulePartRow? _plantDialogRow;
    private int? _plantDialogNewPlantId;
    private string? _plantDialogNewPlantIdRaw;
    private int _plantDialogSiblingCount;
    private double _plantDialogScrollTop;

    private record PlantOption(int? Id, string Name);

    // Cross-plant handoffs — latest row per ScheduleOrderId, for any pair relevant to this viewer
    // (either this is the sender's own order, or it's destined for this viewer).
    private Dictionary<int, HandoffCaptionInfo> _scheduleOrderHandoffs = new();
    private bool _showRejectHandoffDialog;
    private int? _rejectHandoffId;
    private string? _rejectHandoffOrderNumber;
    private string _rejectReason = "";

    // ── Helpers ───────────────────────────────────────────────────────────────
    private bool IsSenderForSchedule(int scheduleId) =>
        _scheduleMeta.TryGetValue(scheduleId, out var schedule) && schedule.PlantId == _selectedPlantId;

    private string OriginPlantNameForSchedule(int scheduleId)
    {
        if (!_scheduleMeta.TryGetValue(scheduleId, out var schedule)) return "?";
        return _plantOptions.FirstOrDefault(o => o.Id == schedule.PlantId)?.Name ?? "?";
    }

    // Count of still-queued (Draft) handoffs across every order in this schedule.
    private int DraftHandoffCountForSchedule(int scheduleId) => DraftHandoffsForSchedule(scheduleId).Count;

    // The destination plant's name for this schedule's Draft handoffs (only one possible
    // "other" plant at a time, so any Draft row's name works).
    private string DraftHandoffPlantNameForSchedule(int scheduleId)
    {
        var drafts = DraftHandoffsForSchedule(scheduleId);
        return drafts.Count > 0 ? drafts[0].DestinationPlantName : "";
    }

    private List<HandoffCaptionInfo> DraftHandoffsForSchedule(int scheduleId) =>
        _orderMeta.Values
            .Where(o => o.ScheduleId == scheduleId)
            .Select(o => _scheduleOrderHandoffs.GetValueOrDefault(o.Id))
            .Where(h => h is not null && h.Status == HandoffStatus.Draft)
            .Select(h => h!)
            .ToList();

    // Count of Accepted-but-not-yet-released handoffs destined to this viewer within this
    // schedule — only meaningful when the viewer is the receiving plant, not the sender.
    private int AcceptedUnreleasedCountForSchedule(int scheduleId) =>
        _orderMeta.Values
            .Where(o => o.ScheduleId == scheduleId)
            .Select(o => _scheduleOrderHandoffs.GetValueOrDefault(o.Id))
            .Count(h => h is not null && h.Status == HandoffStatus.Accepted && !h.ReleasedDate.HasValue);

    // A receiver-visible row is locked for editing once its handoff has been released —
    // the destination plant has already nested it, so it shouldn't change out from under them.
    private bool IsHandoffReleasedForRow(FlatSchedulePartRow row) =>
        !IsSenderForSchedule(row.ScheduleId)
        && _scheduleOrderHandoffs.TryGetValue(row.ScheduleOrderId, out var h)
        && h.ReleasedDate.HasValue;

    private static string BtnStyle(string variant) => variant switch
    {
        "e-primary" => "padding: 2px 8px; font-size: 0.75rem; border-radius: 3px; border: 1px solid #3b82f6; background: #3b82f6; color: white; cursor: pointer;",
        "danger"    => "padding: 2px 8px; font-size: 0.75rem; border-radius: 3px; border: 1px solid #ef4444; background: white; color: #ef4444; cursor: pointer;",
        _           => "padding: 2px 8px; font-size: 0.75rem; border-radius: 3px; border: 1px solid #d1d5db; background: white; color: #374151; cursor: pointer;",
    };

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var plants = await db.Plants.Where(p => p.IsActive).OrderBy(p => p.Name).ToListAsync();
        _plantOptions = new List<PlantOption> { new(null, "All Plants") };
        _plantOptions.AddRange(plants.Select(p => new PlantOption(p.Id, p.Name)));
        _plantLabels = plants.ToDictionary(p => p.Id, p => (p.Code, p.Name));

        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext?.User.Identity?.IsAuthenticated == true)
        {
            var userIdClaim = httpContext.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (int.TryParse(userIdClaim, out var uid))
                _userId = uid;

            _isAdmin = httpContext.User.HasClaim(ClaimTypes.Role, "Admin");
            if (!_isAdmin)
            {
                var plantIdClaim = httpContext.User.FindFirst("PlantId")?.Value;
                if (int.TryParse(plantIdClaim, out var pid))
                    _selectedPlantId = pid;
            }

            // ShopFloor and Nesting users reach this page via the "Engineering" policy (Admin,
            // Engineering, Nesting, ShopFloor all share it), but only Admin/Engineering should
            // see work that hasn't been released to production yet.
            _releasedOnly = !_isAdmin
                         && !httpContext.User.HasClaim(ClaimTypes.Role, "Engineering");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var user = HttpContextAccessor.HttpContext?.User;
        var canEdit = user?.HasClaim(ClaimTypes.Role, "Admin") == true
                   || user?.HasClaim(ClaimTypes.Role, "Engineering") == true;
        await JS.InvokeVoidAsync("setUserCanEdit", canEdit);
        _dotNetRef = DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("horstGrid.watchExpansion", GridId, _dotNetRef); }
        catch (JSException) { /* app.js not yet available (stale cache); expansion tracking inactive */ }
        await LoadStateAsync();
        await LoadData();
    }

    // ── Data loading ──────────────────────────────────────────────────────────
    private async Task LoadData()
    {
        _loading = true;
        _statusMessage = null;
        _importErrorByOrderId.Clear();
        StateHasChanged();
        var term = string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm.Trim();
        _rows = await BomService.GetFlatSchedulePartsAsync(_selectedPlantId, _fromDate, _toDate, term, _releasedOnly);
        BuildMeta();
        await LoadHandoffsAsync();
        _loading = false;
        StateHasChanged();
        await ApplyGridFilters();
        await RestoreExpansionAsync();
    }

    // ── Cross-plant handoffs — inline on the ScheduleOrder caption, no separate banner ───────
    private async Task LoadHandoffsAsync()
    {
        _scheduleOrderHandoffs.Clear();
        if (_selectedPlantId is not { } myPlantId) return;

        await using var db = await DbContextFactory.CreateDbContextAsync();

        var relevant = await db.ScheduleOrderHandoffs
            .Where(h => h.ScheduleOrder.Schedule.PlantId == myPlantId || h.DestinationPlantId == myPlantId)
            .OrderByDescending(h => h.Id)
            .Select(h => new
            {
                h.Id, h.ScheduleOrderId, h.DestinationPlantId, h.Status,
                h.AcceptedDate, AcceptedByUserName = h.AcceptedByUser == null ? null : h.AcceptedByUser.FullName,
                h.RejectedDate, RejectedByUserName = h.RejectedByUser == null ? null : h.RejectedByUser.FullName, h.RejectionReason,
                h.ReleasedDate, ReleasedByUserName = h.ReleasedByUser == null ? null : h.ReleasedByUser.FullName
            })
            .ToListAsync();

        _scheduleOrderHandoffs = relevant
            .GroupBy(h => h.ScheduleOrderId)
            .ToDictionary(g => g.Key, g =>
            {
                var h = g.First(); // latest, since the query is already ordered newest-first
                return new HandoffCaptionInfo(
                    h.Id, h.DestinationPlantId,
                    _plantOptions.FirstOrDefault(o => o.Id == h.DestinationPlantId)?.Name ?? "Plant " + h.DestinationPlantId,
                    h.Status, h.AcceptedDate, h.AcceptedByUserName, h.RejectedDate, h.RejectedByUserName, h.RejectionReason,
                    h.ReleasedDate, h.ReleasedByUserName);
            });
    }

    private async Task OnAcceptScheduleOrderHandoff(int handoffId)
    {
        if (_userId is not { } userId) return;
        await BomService.AcceptScheduleOrderHandoffAsync(handoffId, userId);
        await LoadData();
    }

    private void OnRejectScheduleOrderHandoffClicked(int handoffId, string? orderNumber)
    {
        _rejectHandoffId = handoffId;
        _rejectHandoffOrderNumber = orderNumber;
        _rejectReason = "";
        _showRejectHandoffDialog = true;
        StateHasChanged();
    }

    private async Task OnRejectHandoffConfirm()
    {
        _showRejectHandoffDialog = false;
        if (_rejectHandoffId is not { } handoffId || _userId is not { } userId) return;
        await BomService.RejectScheduleOrderHandoffAsync(handoffId, userId, _rejectReason);
        _rejectHandoffId = null;
        _rejectHandoffOrderNumber = null;
        await LoadData();
    }

    private void OnRejectHandoffCancel()
    {
        _showRejectHandoffDialog = false;
        _rejectHandoffId = null;
        _rejectHandoffOrderNumber = null;
    }

    private async Task OnResubmitScheduleOrderHandoff(int scheduleOrderId, int destinationPlantId, string destinationPlantName)
    {
        var count = await BomService.ResubmitScheduleOrderHandoffAsync(scheduleOrderId, destinationPlantId);
        _statusMessage = count > 0
            ? $"Resubmitted handoff to {destinationPlantName}."
            : "Nothing to resubmit — the Plant field hasn't been changed back to this destination yet.";
        _statusIsError = count == 0;
        await LoadData();
    }

    private async Task OnNotifyScheduleHandoffs(ScheduleCaption sched)
    {
        var count = await BomService.NotifyScheduleHandoffsAsync(sched.Id);
        _statusMessage = count > 0
            ? $"Notified — {count} item(s) sent for review."
            : "Nothing queued to send.";
        _statusIsError = false;
        await LoadData();
    }

    private async Task OnReleaseScheduleHandoffs(ScheduleCaption sched)
    {
        if (_userId is not { } userId || _selectedPlantId is not { } myPlantId) return;
        var stationId = BridgeHub.GetAnyOnlineStationId();
        if (stationId == null)
        {
            await JS.InvokeVoidAsync("alert",
                "No bridge connection is active. A bridge must be connected to release to production.");
            return;
        }

        _releasing = true;
        StateHasChanged();
        try
        {
            var nestOrderIds = await BomService.ReleaseScheduleHandoffsAsync(sched.Id, myPlantId, userId);

            await using var db = await DbContextFactory.CreateDbContextAsync();
            var thumbItems = await db.OrderItems
                .Where(i => nestOrderIds.Contains(i.NestOrderId)
                         && i.Part.Thumbnail == null
                         && i.Part.FileName != null)
                .Select(i => new { i.PartId, i.Part.FileName })
                .Distinct()
                .ToListAsync();
            if (thumbItems.Any())
            {
                var payload = JsonSerializer.Serialize(
                    thumbItems.Select(t => new { PartId = t.PartId, FileName = t.FileName }));
                BridgeHub.TrySendCommand(HubContext, stationId.Value,
                    Guid.NewGuid().ToString(), "UpdateThumbnail", payload);
            }

            await LoadData();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", ex.Message);
        }
        finally
        {
            _releasing = false;
            StateHasChanged();
        }
    }

    private void BuildMeta()
    {
        _scheduleMeta = _rows
            .GroupBy(r => r.ScheduleId)
            .ToDictionary(g => g.Key, g => new ScheduleCaption(
                g.Key,
                g.First().ScheduleName,
                g.First().ScheduleImportDate,
                g.First().ScheduleReleased,
                g.First().SchedulePlantId));

        _orderMeta = _rows
            .GroupBy(r => r.ScheduleOrderId)
            .ToDictionary(g => g.Key, g => new OrderCaption(
                g.Key,
                g.First().ScheduleId,
                g.First().OrderNumber,
                g.First().OrderQty,
                g.First().ScheduleReleased,
                g.First().ProductNumber,
                g.First().ProductDescription,
                g.First().VaultBomImported,
                g.First().ScheduleOrderPlantId));

        RecomputeMissingPdfCounts();
    }

    // Missing-PDF counts and the custom-plant dropdown options only include rows currently
    // visible under the "Hide stock parts" and "Cross-plant only" filters — a part hidden from
    // the grid shouldn't count toward the badge or appear as a printable custom-plant value.
    private void RecomputeMissingPdfCounts()
    {
        var visibleRows = _rows.Where(r => (!_hideStock || !r.IsStock)
                                         && (!_crossPlantOnly || r.IsCrossPlant));

        var missingRows = visibleRows.Where(r => r.PartLineItemId != 0 && r.RequiresPdf && !r.HasPdf);
        _scheduleMissingPdfCount = missingRows
            .GroupBy(r => r.ScheduleId)
            .ToDictionary(g => g.Key, g => g.Count());
        _orderMissingPdfCount = missingRows
            .GroupBy(r => r.ScheduleOrderId)
            .ToDictionary(g => g.Key, g => g.Count());

        _scheduleCustomPlantValues = visibleRows
            .Where(r => r.PlantId is null && !string.IsNullOrWhiteSpace(r.PlantIdRaw))
            .GroupBy(r => r.ScheduleId)
            .ToDictionary(g => g.Key, g => g.Select(r => r.PlantIdRaw!)
                                             .Distinct(StringComparer.OrdinalIgnoreCase)
                                             .OrderBy(v => v, StringComparer.OrdinalIgnoreCase)
                                             .ToList());
    }

    private async Task ApplyGridFilters()
    {
        if (_schedGrid is null) return;
        await _schedGrid.ClearFilteringAsync();
        if (_hideStock)
            await _schedGrid.FilterByColumnAsync("IsStock", "equal", false);
        if (_hideReleased)
            await _schedGrid.FilterByColumnAsync("ScheduleReleased", "equal", false);
        if (_crossPlantOnly)
            await _schedGrid.FilterByColumnAsync("IsCrossPlant", "equal", true);
    }

    // ── Filter handlers ───────────────────────────────────────────────────────
    private async Task OnSearchInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? "";
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(350, token);
            await LoadData();
        }
        catch (TaskCanceledException) { }
    }

    private async Task OnPlantChanged(int? value)
    {
        _selectedPlantId = value;
        await LoadData();
    }

    private async Task SetDateRange(int? days)
    {
        _dateRangeDays = days;
        _fromDate = days.HasValue ? DateTime.Today.AddDays(-days.Value) : null;
        _toDate = days.HasValue ? DateTime.Today : null;
        await LoadData();
        await SaveStateAsync();
    }

    private async Task OnHideStockChanged()
    {
        RecomputeMissingPdfCounts();
        await ApplyGridFilters();
        await RestoreExpansionAsync();
        await SaveStateAsync();
    }

    private async Task OnCrossPlantOnlyChanged()
    {
        RecomputeMissingPdfCounts();
        await ApplyGridFilters();
        await RestoreExpansionAsync();
        await SaveStateAsync();
    }

    private async Task OnHideReleasedChanged()
    {
        await ApplyGridFilters();
        await RestoreExpansionAsync();
        await SaveStateAsync();
    }

    // ── State persistence ─────────────────────────────────────────────────────
    private async Task LoadStateAsync()
    {
        var state = await LocalStorage.GetAsync<OrdersGridState>(StateKey);
        if (state is null) return;
        _dateRangeDays = state.DateRangeDays;
        _fromDate      = _dateRangeDays.HasValue ? DateTime.Today.AddDays(-_dateRangeDays.Value) : null;
        _toDate        = _dateRangeDays.HasValue ? DateTime.Today : null;
        _hideStock     = state.HideStock;
        _hideReleased  = state.HideReleased;
        _crossPlantOnly = state.CrossPlantOnly;
        _expandedScheduleIds = state.ExpandedScheduleIds.ToHashSet();
        _expandedOrderIds    = state.ExpandedOrderIds.ToHashSet();
    }

    private async Task SaveStateAsync()
    {
        await LocalStorage.SetAsync(StateKey, new OrdersGridState
        {
            DateRangeDays       = _dateRangeDays,
            HideStock           = _hideStock,
            HideReleased        = _hideReleased,
            CrossPlantOnly      = _crossPlantOnly,
            ExpandedScheduleIds = _expandedScheduleIds.ToList(),
            ExpandedOrderIds    = _expandedOrderIds.ToList(),
        });
    }

    private void DebounceSaveState()
    {
        _saveCts?.Cancel();
        _saveCts = new CancellationTokenSource();
        _ = SaveAfterDelayAsync(_saveCts.Token);
    }

    private async Task SaveAfterDelayAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(400, token);
            await SaveStateAsync();
        }
        catch (OperationCanceledException) { }
        catch (Exception) { }
    }

    // ── Group expansion tracking ──────────────────────────────────────────────
    // Called from JS after user expands/collapses a group row.
    [JSInvokable]
    public void UpdateExpansionState(List<int> level1, List<int> level2)
    {
        _expandedScheduleIds = level1.ToHashSet();
        _expandedOrderIds    = level2.ToHashSet();
        DebounceSaveState();
    }

    private record ExpandedGroupResult(List<int> Level1, List<int> Level2);

    // Re-expands saved groups after any operation that collapses them.
    // Delegates entirely to JS so row-index arithmetic stays correct as
    // Syncfusion adds rows to the DOM after each expansion.
    private async Task RestoreExpansionAsync()
    {
        if (_schedGrid is null || (_expandedScheduleIds.Count == 0 && _expandedOrderIds.Count == 0))
            return;
        try
        {
            await JS.InvokeVoidAsync("horstGrid.restoreExpansion", GridId,
                _expandedScheduleIds.ToList(), _expandedOrderIds.ToList());
        }
        catch (JSException) { }
    }

    // ── Row styling ───────────────────────────────────────────────────────────
    private void OnRowDataBound(RowDataBoundEventArgs<FlatSchedulePartRow> args)
    {
        if (args.Data.ScheduleReleased)
            args.Row.AddClass(new[] { "row-released" });
        if (!string.IsNullOrWhiteSpace(args.Data.Notes))
            args.Row.AddClass(new[] { "row-has-notes" });
        if (args.Data.IsStock)
            args.Row.AddClass(new[] { "row-dimmed" });
        if (args.Data.PartLineItemId == _activePartLineItemId)
            args.Row.AddClass(new[] { "row-active-part" });
    }

    // ── PDF thumbnail ─────────────────────────────────────────────────────────
    private void OnThumbEnter(string number, Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        _thumbNumber = number;
        _thumbX = e.ClientX + 18;
        _thumbY = e.ClientY - 10;
    }

    private void OnThumbLeave() => _thumbNumber = null;

    // ── PDF refresh ───────────────────────────────────────────────────────────
    private async Task OnRefreshPdf(FlatSchedulePartRow row)
    {
        _refreshingPartIds.Add(row.PartLineItemId);
        StateHasChanged();
        var scrollTop = await JS.InvokeAsync<double>("horstGrid.saveScrollTop", GridId);
        try
        {
            var found = await BomService.RefreshPartPdfAsync(row.PartLineItemId);
            _statusMessage = found
                ? $"PDF found and copied for {row.PartNumber}."
                : $"Still no PDF on the share for {row.PartNumber}.";
            _statusIsError = !found;
        }
        finally
        {
