        await BomService.UpdatePartIsStockAsync(_stockDialogRow.PartLineItemId, _stockDialogNewValue);
        _stockDialogRow = null;
        await LoadData();
        await JS.InvokeVoidAsync("horstGrid.restoreScrollTop", "OrdersGrid_v6", _stockDialogScrollTop);
