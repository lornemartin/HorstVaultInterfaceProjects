    private async Task OnRetryOrder(int orderId)
    {
        _activePartLineItemId = null;
        _forceReimportOrderIds.Remove(orderId);
        var result = await ScheduleImportSvc.RetrySingleScheduleOrderAsync(orderId);
        if (!string.IsNullOrEmpty(result.GatewayError))
        {
            _statusMessage = $"Gateway error: {result.GatewayError}";
            _statusIsError = true;
        }
        else if (!result.Success)
        {
            _statusMessage = result.Errors.FirstOrDefault() ?? "Re-import failed.";
            _statusIsError = true;
        }
        else
        {
            _importErrorByOrderId.Remove(orderId);
            _importingOrderIds.Add(orderId);
            _statusMessage = null;
            StartOrderPollIfNeeded();
        }
        StateHasChanged();
    }

    private async Task OnRetrySchedulePending(int scheduleId)
    {
        var result = await ScheduleImportSvc.RetrySchedulePendingAsync(scheduleId);
        if (!string.IsNullOrEmpty(result.GatewayError))
        {
            _statusMessage = $"Gateway error: {result.GatewayError}";
            _statusIsError = true;
        }
        else if (!result.Success)
        {
            _statusMessage = result.Errors.FirstOrDefault() ?? "Re-import failed.";
            _statusIsError = true;
        }
        else
        {
            var warning = result.Warnings.FirstOrDefault();
            if (warning is not null)
            {
                _statusMessage = warning;
                _statusIsError = false;
            }
            else
            {
                foreach (var id in _orderMeta.Values
                    .Where(o => o.ScheduleId == scheduleId && !o.VaultBomImported && !string.IsNullOrEmpty(o.ProductNumber))
                    .Select(o => o.Id))
                {
                    _importingOrderIds.Add(id);
                }
                _statusMessage = null;
                StartOrderPollIfNeeded();
            }
        }
        StateHasChanged();
    }

    private void StartOrderPollIfNeeded()
    {
        if (_importingOrderIds.Count == 0) return;
        _pollCts?.Cancel();
        _pollCts = new CancellationTokenSource();
        _ = PollOrderImportAsync(_pollCts.Token);
    }

    private async Task PollOrderImportAsync(CancellationToken ct)
    {
        var deadline = DateTime.UtcNow.AddSeconds(90);

        while (_importingOrderIds.Count > 0)
        {
            if (ct.IsCancellationRequested) return;
            if (DateTime.UtcNow >= deadline) break;

            try { await Task.Delay(2000, ct); }
            catch (OperationCanceledException) { return; }

            try
            {
                await using var db = await DbContextFactory.CreateDbContextAsync(ct);
                var ids = _importingOrderIds.ToList();
                var results = await db.ScheduleOrders
                    .Where(so => ids.Contains(so.Id))
                    .Select(so => new { so.Id, so.VaultBomImported, so.LastImportError })
                    .ToListAsync(ct);
                foreach (var r in results.Where(r => r.VaultBomImported))
                    _importingOrderIds.Remove(r.Id);
                // A failure (e.g. item not found in Vault) is terminal — no need to wait
                // out the full timeout once the Gateway has already reported it.
                foreach (var r in results.Where(r => !r.VaultBomImported && r.LastImportError is not null))
                {
                    _importingOrderIds.Remove(r.Id);
                    _importErrorByOrderId[r.Id] = r.LastImportError!;
                }
                var found = results.Select(r => r.Id).ToHashSet();
                foreach (var id in ids.Where(id => !found.Contains(id)))
                    _importingOrderIds.Remove(id);
            }
            catch (OperationCanceledException) { return; }
            catch (Exception) { }

            await InvokeAsync(StateHasChanged);
        }

        var timedOutIds = _importingOrderIds.ToList();
        _importingOrderIds.Clear();

        await InvokeAsync(async () =>
        {
            var scrollTop = await JS.InvokeAsync<double>("horstGrid.saveScrollTop", GridId);
            await LoadData();
            foreach (var id in timedOutIds)
                _importErrorByOrderId[id] = "Timed out";
            StateHasChanged();
            await JS.InvokeVoidAsync("horstGrid.restoreScrollTop", GridId, scrollTop);
        });
    }

