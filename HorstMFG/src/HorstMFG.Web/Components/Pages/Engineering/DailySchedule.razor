    // ── PDF refresh ───────────────────────────────────────────────────────────
    private async Task OnRefreshPdf(FlatSchedulePartRow row)
    {
        _refreshingPartIds.Add(row.PartLineItemId);
        StateHasChanged();
        var scrollTop = await JS.InvokeAsync<double>("horstGrid.saveScrollTop", "OrdersGrid_v6");
        try
        {
            var found = await BomService.RefreshPartPdfAsync(row.PartLineItemId);
            _statusMessage = found
                ? $"PDF found and copied for {row.PartNumber}."
                : $"Still no PDF on the share for {row.PartNumber}.";
            _statusIsError = !found;
        }
        finally
        {
            _refreshingPartIds.Remove(row.PartLineItemId);
        }
        await LoadData();
        await JS.InvokeVoidAsync("horstGrid.restoreScrollTop", "OrdersGrid_v6", scrollTop);
    }

    // ── Schedule actions ──────────────────────────────────────────────────────
    private async Task OnReleaseSchedule(ScheduleCaption sched)
    {
        var missingCount = _scheduleMissingPdfCount.GetValueOrDefault(sched.Id);
        var warning = missingCount > 0
            ? $"Warning: {missingCount} part{(missingCount != 1 ? "s" : "")} in this schedule require a PDF but are missing one.\n\n"
            : "";
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"{warning}Release schedule '{sched.Name}' to production? This cannot be undone and the schedule will become read-only.");
        if (!confirmed) return;

        var stationId = BridgeHub.GetAnyOnlineStationId();
        if (stationId == null)
        {
            await JS.InvokeVoidAsync("alert",
                "No bridge connection is active. A bridge must be connected to release to production.");
            return;
        }

        _releasing = true;
        StateHasChanged();
        try
        {
            await BomService.ReleaseScheduleToProductionAsync(sched.Id);

            await using var db = await DbContextFactory.CreateDbContextAsync();
            var thumbItems = await db.OrderItems
                .Where(i => i.NestOrder.ScheduleOrder.ScheduleId == sched.Id
                         && i.Part.Thumbnail == null
                         && i.Part.FileName != null)
                .Select(i => new { i.PartId, i.Part.FileName })
                .Distinct()
                .ToListAsync();
            if (thumbItems.Any())
            {
                var payload = JsonSerializer.Serialize(
                    thumbItems.Select(t => new { PartId = t.PartId, FileName = t.FileName }));
                BridgeHub.TrySendCommand(HubContext, stationId.Value,
                    Guid.NewGuid().ToString(), "UpdateThumbnail", payload);
            }

            await LoadData();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", ex.Message);
        }
        finally
        {
            _releasing = false;
            StateHasChanged();
        }
    }

