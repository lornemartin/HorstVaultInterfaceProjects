    private async Task OnIsStockChanged(FlatSchedulePartRow row, bool newValue)
    {
        _activePartLineItemId = row.PartLineItemId;
        var count = await BomService.CountSiblingsByPartNumberAsync(row.PartLineItemId);
        if (count > 1)
        {
            _stockDialogScrollTop = await JS.InvokeAsync<double>("horstGrid.saveScrollTop", "OrdersGrid_v6");
            _stockDialogRow = row;
            _stockDialogNewValue = newValue;
            _stockDialogSiblingCount = count;
            _showStockDialog = true;
            StateHasChanged();
            return;
        }
        var scrollTop = await JS.InvokeAsync<double>("horstGrid.saveScrollTop", "OrdersGrid_v6");
        await BomService.UpdatePartIsStockAsync(row.PartLineItemId, newValue);
        await LoadData();
        await JS.InvokeVoidAsync("horstGrid.restoreScrollTop", "OrdersGrid_v6", scrollTop);
    }

