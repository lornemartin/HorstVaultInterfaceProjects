    {
        var trimmed = rawValue.Trim();
        var match = _plantOptions.FirstOrDefault(o => o.Id.HasValue
            && string.Equals(o.Name, trimmed, StringComparison.OrdinalIgnoreCase));
        int? plantId = match?.Id;
        string? plantIdRaw = string.IsNullOrEmpty(trimmed) ? null : trimmed;
        _customPlantEditIds.Remove(row.PartLineItemId);
        await ApplyPartPlantChangeAsync(row, plantId, plantIdRaw);
    }

