@page "/engineering/orders"
@attribute [Authorize(Policy = "Engineering")]
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JS
@inject IBomService BomService
@inject HorstMFG.Web.Services.ExcelScheduleImportService ScheduleImportSvc
@inject Microsoft.AspNetCore.SignalR.IHubContext<HorstMFG.Web.Hubs.BridgeHub> HubContext
@inject HorstMFG.Web.Services.LocalStorageService LocalStorage
@using HorstMFG.Core.DTOs
@using HorstMFG.Infrastructure.Data
@using HorstMFG.Web.Hubs
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.Popups
@implements IAsyncDisposable

<PageTitle>Orders - HorstMFG</PageTitle>

@if (_releasing)
{
    <div class="loading-overlay">
        <div class="spinner"></div>
        <span class="spinner-label">Releasing to production…</span>
    </div>
}

@if (_loading)
{
    <div class="loading-overlay">
        <div class="spinner"></div>
        <span class="spinner-label">Loading…</span>
    </div>
}

<h3>Orders</h3>

@if (_statusMessage is not null)
{
    <div style="padding: 0.5rem 0.75rem; border-radius: 4px; margin-bottom: 0.75rem;
                background: @(_statusIsError ? "#fee2e2" : "#dcfce7");
                color: @(_statusIsError ? "#991b1b" : "#166534"); font-size: 0.875rem;">
        @_statusMessage
    </div>
}

<div style="display: flex; gap: 2rem; margin-bottom: 1rem; align-items: flex-end; flex-wrap: wrap;">
    <div style="min-width: 200px;">
        <label style="display: block; font-weight: 600; margin-bottom: 0.25rem;">Plant</label>
        <SfDropDownList TValue="int?" TItem="PlantOption"
                        Value="_selectedPlantId"
                        ValueChanged="OnPlantChanged"
                        DataSource="_plantOptions"
                        Enabled="_isAdmin">
            <DropDownListFieldSettings Text="Name" Value="Id" />
        </SfDropDownList>
    </div>

    <div>
        <label style="display: block; font-weight: 600; margin-bottom: 0.25rem;">Date range</label>
        <div style="display: flex; gap: 0.5rem;">
            <SfButton OnClick="@(() => SetDateRange(30))">30 days</SfButton>
            <SfButton OnClick="@(() => SetDateRange(60))">60 days</SfButton>
            <SfButton OnClick="@(() => SetDateRange(90))">90 days</SfButton>
            <SfButton OnClick="@(() => SetDateRange(null))">All</SfButton>
        </div>
    </div>

    <div style="min-width: 240px;">
        <label style="display: block; font-weight: 600; margin-bottom: 0.25rem;">Search</label>
        <input type="text" value="@_searchTerm" @oninput="OnSearchInput"
               placeholder="Order name, part number, description…"
               style="width: 100%; padding: 0.375rem 0.5rem; border: 1px solid #d1d5db; border-radius: 4px; font-size: 0.875rem;" />
    </div>

    <div style="display: flex; flex-direction: column; gap: 0.4rem; padding-bottom: 0.25rem;">
        <label style="display: flex; align-items: center; gap: 0.4rem; cursor: pointer; font-size: 0.875rem;">
            <input type="checkbox" @bind="_hideStock" @bind:after="OnHideStockChanged" />
            Hide stock parts
        </label>
        <label style="display: flex; align-items: center; gap: 0.4rem; cursor: pointer; font-size: 0.875rem;">
            <input type="checkbox" @bind="_hideReleased" @bind:after="OnHideReleasedChanged" />
            Hide released
        </label>
    </div>
</div>

<SfGrid TValue="FlatSchedulePartRow" @ref="_schedGrid" ID="OrdersGrid_v6"
        DataSource="_rows" AllowGrouping="true" AllowSorting="false" AllowFiltering="true" EnablePersistence="true"
        AllowResizing="true" Height="600">
    <GridGroupSettings ShowGroupedColumn="false" ShowDropArea="false" EnableLazyLoading="true"
                       Columns="@(new[] { "ScheduleId", "ScheduleOrderId" })">
        <CaptionTemplate>
            @{
                var ctx = context as CaptionTemplateContext;
                var key = Convert.ToInt32(ctx!.Key);
            }
            @if (ctx.Field == "ScheduleId" && _scheduleMeta.TryGetValue(key, out var sched))
            {
                <span data-group-key="@sched.Id" data-group-level="1" style="display:none;"></span>
                <span style="font-weight: 700; font-size: 1rem;">@sched.Name</span>
                <span style="margin-left: 1rem; color: #6b7280; font-size: 0.8rem;">
                    @sched.ImportDate.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")
                </span>
                <span style="margin-left: 0.75rem; color: #6b7280; font-size: 0.8rem;">
                    (@ctx.Count part@(ctx.Count != 1 ? "s" : ""))
                </span>
                @if (_scheduleMissingPdfCount.TryGetValue(sched.Id, out var scheduleMissing) && scheduleMissing > 0)
                {
                    <span style="margin-left: 0.5rem; color: #b91c1c; font-size: 0.75rem; font-weight: 600;">
                        &#9888; @scheduleMissing missing PDF@(scheduleMissing != 1 ? "s" : "")
                    </span>
                }
                <span style="margin-left: 1.5rem; display: inline-flex; gap: 0.4rem; align-items: center;">
                    @if (!sched.IsReleased)
                    {
                        @if (_orderMeta.Values.Any(o => o.ScheduleId == sched.Id && !o.VaultBomImported && !string.IsNullOrEmpty(o.ProductNumber)))
                        {
                            <button @onclick="@(async () => await OnRetrySchedulePending(sched.Id))" @onclick:stopPropagation="true"
                                    style="@BtnStyle("e-primary")">Re-import pending</button>
                        }
                        <button @onclick="@(async () => await OnReleaseSchedule(sched))" @onclick:stopPropagation="true"
                                style="@BtnStyle("e-primary")">Release to Production</button>
                        <button @onclick="@(async () => await OnDeleteSchedule(sched))" @onclick:stopPropagation="true"
                                style="@BtnStyle("danger")">Delete</button>
                        <span style="border-left: 1px solid #d1d5db; height: 18px; margin: 0 0.2rem;"></span>
                    }
                    <button @onclick="@(async () => await OpenReport("schedule-traveller", sched.Name))" @onclick:stopPropagation="true"
                            style="@BtnStyle("")">Shop Traveller</button>
                    <button @onclick="@(async () => await OpenReport("schedule-op", sched.Name, "laser"))" @onclick:stopPropagation="true"
                            style="@BtnStyle("")">Laser</button>
                    <button @onclick="@(async () => await OpenReport("schedule-op", sched.Name, "Iron Worker"))" @onclick:stopPropagation="true"
                            style="@BtnStyle("")">Iron Worker</button>
                    <button @onclick="@(async () => await OpenReport("schedule-op", sched.Name, "Machine Shop"))" @onclick:stopPropagation="true"
                            style="@BtnStyle("")">Machine Shop</button>
                    <button @onclick="@(async () => await OpenReport("schedule-op", sched.Name, "Bandsaw"))" @onclick:stopPropagation="true"
                            style="@BtnStyle("")">Bandsaw</button>
                    <button @onclick="@(async () => await OpenReport("schedule-op", sched.Name, "Purchased"))" @onclick:stopPropagation="true"
                            style="@BtnStyle("")">Purchased</button>
                </span>
            }
            else if (ctx.Field == "ScheduleOrderId" && _orderMeta.TryGetValue(key, out var order))
            {
                <span data-group-key="@order.Id" data-group-level="2" style="display:none;"></span>
                @if (order.IsReleased)
                {
                    @if (order.ProductNumber is not null)
                    {
                        <span style="font-style: italic; color: #374151; margin-right: 0.5rem;">@order.ProductNumber</span>
                    }
                }
                else
                {
                    <input type="text" value="@order.ProductNumber"
                           @onchange="@(async e => await OnScheduleOrderProductNumberChanged(order.Id, e.Value?.ToString()))"
                           @onkeydown="@(async e => { if (e.Key == "Enter") await JS.InvokeVoidAsync("eval", "document.activeElement.blur()"); })"
                           @onclick:stopPropagation="true"
                           @onkeydown:stopPropagation="true"
                           @onkeyup:stopPropagation="true"
                           placeholder="product number"
                           title="Edit product number, press Enter or click elsewhere to save"
                           style="width: 170px; font-style: italic; border: 1px solid #d1d5db; border-radius: 3px; padding: 1px 4px; font-size: 0.875rem; color: #374151;" />
                }
                <span style="font-weight: 700; margin-left: 0.35rem;">@order.OrderNumber</span>
                @if (order.ProductDescription is not null)
                {
                    <span style="margin-left: 0.75rem; color: #6b7280; font-size: 0.85rem;">@order.ProductDescription</span>
                }
                @if (_orderMissingPdfCount.TryGetValue(order.Id, out var orderMissing) && orderMissing > 0)
                {
                    <span style="margin-left: 0.5rem; color: #b91c1c; font-size: 0.75rem; font-weight: 600;">
                        &#9888; @orderMissing missing PDF@(orderMissing != 1 ? "s" : "")
                    </span>
                }
                <span style="margin-left: 1.5rem; display: inline-flex; gap: 0.5rem; align-items: center;">
                    <span style="font-size: 0.8rem; color: #6b7280;">Qty:</span>
                    @if (order.IsReleased)
                    {
                        <strong>@order.Qty</strong>
                    }
                    else
                    {
                        <input type="number" value="@order.Qty"
                               @onchange="@(async e => await OnScheduleOrderQtyChanged(order.Id, e.Value?.ToString() ?? ""))"
                               @onclick:stopPropagation="true"
                               min="1" max="9999"
                               style="width: 58px; text-align: right; border: 1px solid #d1d5db; border-radius: 3px; padding: 1px 3px; font-weight: 600;" />
                        @if (_importingOrderIds.Contains(order.Id) && !order.VaultBomImported)
                        {
                            <span style="display:inline-flex;align-items:center;gap:0.3rem;color:#3b82f6;font-size:0.8rem;">
                                <span style="display:inline-block;width:12px;height:12px;border:2px solid #bfdbfe;border-top-color:#3b82f6;border-radius:50%;animation:spin 0.8s linear infinite;flex-shrink:0;"></span>
                                Importing…
                            </span>
                        }
                        else if (!order.VaultBomImported && !string.IsNullOrEmpty(order.ProductNumber))
                        {
                            @if (_importErrorByOrderId.TryGetValue(order.Id, out var importErr))
                            {
                                <span style="color:#dc2626;font-size:0.75rem;margin-right:0.25rem;">@importErr —</span>
                            }
                            <button @onclick="@(async () => await OnRetryOrder(order.Id))" @onclick:stopPropagation="true"
                                    style="@BtnStyle("e-primary")">Re-import BOM</button>
                        }
                        <button @onclick="@(async () => await OnDeleteOrder(order))" @onclick:stopPropagation="true"
                                style="@BtnStyle("danger")">Delete</button>
                    }
                </span>
            }
            else
            {
                <span style="font-weight: 600;">@ctx.Key</span>
                <span style="margin-left: 0.5rem; color: #6b7280; font-size: 0.8rem;">(@ctx.Count)</span>
            }
        </CaptionTemplate>
    </GridGroupSettings>
    <GridSortSettings>
        <GridSortColumns>
            <GridSortColumn Field="CategoryOrder"   Direction="SortDirection.Ascending" />
            <GridSortColumn Field="IsStock"         Direction="SortDirection.Ascending" />
            <GridSortColumn Field="Operations"      Direction="SortDirection.Ascending" />
            <GridSortColumn Field="ThicknessOrder"  Direction="SortDirection.Ascending" />
        </GridSortColumns>
    </GridSortSettings>
    <GridEvents TValue="FlatSchedulePartRow" RowDataBound="OnRowDataBound" />
    <GridColumns>
        <GridColumn Field="ScheduleId" Visible="false" Width="0" />
        <GridColumn Field="ScheduleOrderId" Visible="false" Width="0" />
        <GridColumn Field="PartLineItemId" IsPrimaryKey="true" Visible="false" Width="0" />
        <GridColumn Field="CategoryOrder"    Visible="false" Width="0" />
        <GridColumn Field="ThicknessOrder"   Visible="false" Width="0" />
        <GridColumn Field="ScheduleReleased" Visible="false" Width="0" />
        <GridColumn Field="PartNumber" HeaderText="Number" Width="300">
            <Template>
                @{
                    var row = context as FlatSchedulePartRow;
                    if (row!.HasPdf)
                    {
                        <a href="/api/pdf-local/@Uri.EscapeDataString(row.PartNumber)" target="_blank"
                           @onclick:stopPropagation="true"
                           style="margin-right: 0.4rem; color: #3b82f6; font-size: 0.75rem; text-decoration: none;"
                           title="View PDF">&#x1F4C4;</a>
                        <span @onmouseenter="@(e => OnThumbEnter(row.PartNumber, e))"
                              @onmouseleave="OnThumbLeave"
                              style="cursor: default;">
                            @row.PartNumber
                        </span>
                    }
                    else if (row.RequiresPdf)
                    {
                        @if (_refreshingPartIds.Contains(row.PartLineItemId))
                        {
                            <span style="margin-right: 0.4rem; font-size: 0.75rem;" title="Checking share…">&#8987;</span>
                        }
                        else
                        {
                            <button @onclick="@(async () => await OnRefreshPdf(row))" @onclick:stopPropagation="true"
                                    style="margin-right: 0.4rem; border: none; background: none; padding: 0; cursor: pointer; font-size: 0.75rem;"
                                    title="Re-check the share for this PDF">&#x1F504;</button>
                        }
                        <span style="color: #b91c1c;" title="PDF required but missing">@row.PartNumber</span>
                    }
                    else
                    {
                        <span>@row.PartNumber</span>
                    }
                }
            </Template>
        </GridColumn>
        <GridColumn Field="Description" HeaderText="Description" Width="220" />
        <GridColumn Field="Category" HeaderText="Category" Width="100" />
        <GridColumn Field="Material" HeaderText="Material" Width="120" />
        <GridColumn Field="Thickness" HeaderText="Thickness" Width="90" />
        <GridColumn Field="Operations" HeaderText="Operations" Width="110" />
        <GridColumn Field="Qty" HeaderText="Qty" Width="70" TextAlign="TextAlign.Right" />
        <GridColumn Field="IsStock" HeaderText="Stock" Width="70" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var row = context as FlatSchedulePartRow;
                    <input type="checkbox" checked="@row!.IsStock"
                           @onchange="@(async e => await OnIsStockChanged(row, (bool)e.Value!))"
                           disabled="@row.ScheduleReleased"
                           style="cursor: @(row.ScheduleReleased ? "default" : "pointer"); width: 16px; height: 16px;" />
                }
            </Template>
        </GridColumn>
        <GridColumn Field="HasPdf" HeaderText="PDF" Width="60" DisplayAsCheckBox="true" TextAlign="TextAlign.Center" />
        <GridColumn Field="Notes" HeaderText="Notes" Width="150" />
    </GridColumns>
</SfGrid>

@if (_thumbNumber is not null)
{
    <div style="position:fixed; left:@(_thumbX)px; top:@(_thumbY)px; z-index:9999;
                background:#fff; border:1px solid #dee2e6; border-radius:4px;
                box-shadow:0 4px 16px rgba(0,0,0,.18); padding:4px; pointer-events:none;">
        <img src="/api/pdf-thumbnail/@Uri.EscapeDataString(_thumbNumber)" loading="lazy"
             style="display:block; width:220px; height:auto;"
             onerror="this.parentElement.style.display='none'" />
    </div>
}

<SfDialog @bind-Visible="_showStockDialog" Width="440px" IsModal="true" ShowCloseIcon="true"
          Header="Update Stock Flag" AllowDragging="true">
    <DialogTemplates>
        <Content>
            @if (_stockDialogRow is not null)
            {
                <p>Part <strong>@_stockDialogRow.PartNumber</strong> appears <strong>@_stockDialogSiblingCount</strong>
                   time@(_stockDialogSiblingCount != 1 ? "s" : "") in this schedule.</p>
                <p>Update all instances or just this one?</p>
            }
        </Content>
        <FooterTemplate>
            <SfButton OnClick="OnStockDialogCancel">Cancel</SfButton>
            <SfButton OnClick="OnStockDialogThisOnly" CssClass="e-outline" style="margin-left: 8px;">This part only</SfButton>
            <SfButton OnClick="OnStockDialogAll" CssClass="e-primary" style="margin-left: 8px;">
                All @_stockDialogSiblingCount instance@(_stockDialogSiblingCount != 1 ? "s" : "")
            </SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    // ── Data ─────────────────────────────────────────────────────────────────
    private List<FlatSchedulePartRow> _rows = new();
    private Dictionary<int, ScheduleCaption> _scheduleMeta = new();
    private Dictionary<int, OrderCaption> _orderMeta = new();
    private Dictionary<int, int> _scheduleMissingPdfCount = new();
    private Dictionary<int, int> _orderMissingPdfCount = new();

    private sealed record ScheduleCaption(int Id, string Name, DateTime ImportDate, bool IsReleased);
    private sealed record OrderCaption(int Id, int ScheduleId, string? OrderNumber, int Qty, bool IsReleased,
                                       string? ProductNumber, string? ProductDescription, bool VaultBomImported);

    // ── Persisted state ───────────────────────────────────────────────────────
    private sealed class OrdersGridState
    {
        public int?       DateRangeDays      { get; set; } = 30;
        public bool       HideStock          { get; set; } = true;
        public bool       HideReleased       { get; set; } = false;
        public List<int>  ExpandedScheduleIds { get; set; } = new();
        public List<int>  ExpandedOrderIds    { get; set; } = new();
    }
    private const string StateKey = "horstmfg.orders.grid.state";

    // ── UI state ─────────────────────────────────────────────────────────────
    private SfGrid<FlatSchedulePartRow>? _schedGrid;
    private List<PlantOption> _plantOptions = new();
    private int? _selectedPlantId;
    private bool _isAdmin;
    private bool _releasing;
    private bool _loading;
    private int?      _dateRangeDays = 30;
    private DateTime? _fromDate = DateTime.Today.AddDays(-30);
    private DateTime? _toDate = DateTime.Today;
    private string _searchTerm = "";
    private bool _hideStock = true;
    private bool _hideReleased = false;
    private HashSet<int> _expandedScheduleIds = new();
    private HashSet<int> _expandedOrderIds    = new();
    private CancellationTokenSource? _searchCts;
    private CancellationTokenSource? _saveCts;
    private CancellationTokenSource? _pollCts;
    private DotNetObjectReference<DailySchedule>? _dotNetRef;

    // Orders currently being polled for VaultBomImported completion
    private HashSet<int> _importingOrderIds = new();
    private Dictionary<int, string> _importErrorByOrderId = new();
    private int? _activePartLineItemId;

    // Status message (retry feedback)
    private string? _statusMessage;
    private bool _statusIsError;

    // PDF thumbnail hover
    private string? _thumbNumber;
    private double _thumbX, _thumbY;

    // PDF refresh
    private HashSet<int> _refreshingPartIds = new();

    // Stock dialog
    private bool _showStockDialog;
    private FlatSchedulePartRow? _stockDialogRow;
    private bool _stockDialogNewValue;
    private int _stockDialogSiblingCount;
    private double _stockDialogScrollTop;

    private record PlantOption(int? Id, string Name);

    // ── Helpers ───────────────────────────────────────────────────────────────
    private static string BtnStyle(string variant) => variant switch
    {
        "e-primary" => "padding: 2px 8px; font-size: 0.75rem; border-radius: 3px; border: 1px solid #3b82f6; background: #3b82f6; color: white; cursor: pointer;",
        "danger"    => "padding: 2px 8px; font-size: 0.75rem; border-radius: 3px; border: 1px solid #ef4444; background: white; color: #ef4444; cursor: pointer;",
        _           => "padding: 2px 8px; font-size: 0.75rem; border-radius: 3px; border: 1px solid #d1d5db; background: white; color: #374151; cursor: pointer;",
    };

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var plants = await db.Plants.Where(p => p.IsActive).OrderBy(p => p.Name).ToListAsync();
        _plantOptions = new List<PlantOption> { new(null, "All Plants") };
        _plantOptions.AddRange(plants.Select(p => new PlantOption(p.Id, p.Name)));

        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext?.User.Identity?.IsAuthenticated == true)
        {
            _isAdmin = httpContext.User.HasClaim(ClaimTypes.Role, "Admin");
            if (!_isAdmin)
            {
                var plantIdClaim = httpContext.User.FindFirst("PlantId")?.Value;
                if (int.TryParse(plantIdClaim, out var pid))
                    _selectedPlantId = pid;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var user = HttpContextAccessor.HttpContext?.User;
        var canEdit = user?.HasClaim(ClaimTypes.Role, "Admin") == true
                   || user?.HasClaim(ClaimTypes.Role, "Engineering") == true;
        await JS.InvokeVoidAsync("setUserCanEdit", canEdit);
        _dotNetRef = DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("horstGrid.watchExpansion", "OrdersGrid_v6", _dotNetRef); }
        catch (JSException) { /* app.js not yet available (stale cache); expansion tracking inactive */ }
        await LoadStateAsync();
        await LoadData();
    }

    // ── Data loading ──────────────────────────────────────────────────────────
    private async Task LoadData()
    {
        _loading = true;
        _statusMessage = null;
        _importErrorByOrderId.Clear();
        StateHasChanged();
        var term = string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm.Trim();
        _rows = await BomService.GetFlatSchedulePartsAsync(_selectedPlantId, _fromDate, _toDate, term);
        BuildMeta();
        _loading = false;
        StateHasChanged();
        await ApplyGridFilters();
        await RestoreExpansionAsync();
    }

    private void BuildMeta()
    {
        _scheduleMeta = _rows
            .GroupBy(r => r.ScheduleId)
            .ToDictionary(g => g.Key, g => new ScheduleCaption(
                g.Key,
                g.First().ScheduleName,
                g.First().ScheduleImportDate,
                g.First().ScheduleReleased));

        _orderMeta = _rows
            .GroupBy(r => r.ScheduleOrderId)
            .ToDictionary(g => g.Key, g => new OrderCaption(
                g.Key,
                g.First().ScheduleId,
                g.First().OrderNumber,
                g.First().OrderQty,
                g.First().ScheduleReleased,
                g.First().ProductNumber,
                g.First().ProductDescription,
                g.First().VaultBomImported));

        RecomputeMissingPdfCounts();
    }

    // Missing-PDF counts only include rows currently visible under the "Hide stock
    // parts" filter — a part hidden from the grid shouldn't count toward the badge.
    private void RecomputeMissingPdfCounts()
    {
        var missingRows = _rows.Where(r => r.PartLineItemId != 0 && r.RequiresPdf && !r.HasPdf
                                         && (!_hideStock || !r.IsStock));
        _scheduleMissingPdfCount = missingRows
            .GroupBy(r => r.ScheduleId)
            .ToDictionary(g => g.Key, g => g.Count());
        _orderMissingPdfCount = missingRows
            .GroupBy(r => r.ScheduleOrderId)
            .ToDictionary(g => g.Key, g => g.Count());
    }

    private async Task ApplyGridFilters()
    {
        if (_schedGrid is null) return;
        await _schedGrid.ClearFilteringAsync();
        if (_hideStock)
            await _schedGrid.FilterByColumnAsync("IsStock", "equal", false);
        if (_hideReleased)
            await _schedGrid.FilterByColumnAsync("ScheduleReleased", "equal", false);
    }

    // ── Filter handlers ───────────────────────────────────────────────────────
    private async Task OnSearchInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? "";
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(350, token);
            await LoadData();
        }
        catch (TaskCanceledException) { }
    }

    private async Task OnPlantChanged(int? value)
    {
        _selectedPlantId = value;
        await LoadData();
    }

    private async Task SetDateRange(int? days)
    {
        _dateRangeDays = days;
        _fromDate = days.HasValue ? DateTime.Today.AddDays(-days.Value) : null;
        _toDate = days.HasValue ? DateTime.Today : null;
        await LoadData();
        await SaveStateAsync();
    }

    private async Task OnHideStockChanged()
    {
        RecomputeMissingPdfCounts();
        await ApplyGridFilters();
        await RestoreExpansionAsync();
        await SaveStateAsync();
    }

    private async Task OnHideReleasedChanged()
    {
        await ApplyGridFilters();
        await RestoreExpansionAsync();
        await SaveStateAsync();
    }

    // ── State persistence ─────────────────────────────────────────────────────
    private async Task LoadStateAsync()
    {
        var state = await LocalStorage.GetAsync<OrdersGridState>(StateKey);
        if (state is null) return;
        _dateRangeDays = state.DateRangeDays;
        _fromDate      = _dateRangeDays.HasValue ? DateTime.Today.AddDays(-_dateRangeDays.Value) : null;
        _toDate        = _dateRangeDays.HasValue ? DateTime.Today : null;
        _hideStock     = state.HideStock;
        _hideReleased  = state.HideReleased;
        _expandedScheduleIds = state.ExpandedScheduleIds.ToHashSet();
        _expandedOrderIds    = state.ExpandedOrderIds.ToHashSet();
    }

    private async Task SaveStateAsync()
    {
        await LocalStorage.SetAsync(StateKey, new OrdersGridState
        {
            DateRangeDays       = _dateRangeDays,
            HideStock           = _hideStock,
            HideReleased        = _hideReleased,
            ExpandedScheduleIds = _expandedScheduleIds.ToList(),
            ExpandedOrderIds    = _expandedOrderIds.ToList(),
        });
    }

    private void DebounceSaveState()
    {
        _saveCts?.Cancel();
        _saveCts = new CancellationTokenSource();
        _ = SaveAfterDelayAsync(_saveCts.Token);
    }

    private async Task SaveAfterDelayAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(400, token);
            await SaveStateAsync();
        }
        catch (OperationCanceledException) { }
        catch (Exception) { }
    }

    // ── Group expansion tracking ──────────────────────────────────────────────
    // Called from JS after user expands/collapses a group row.
    [JSInvokable]
    public void UpdateExpansionState(List<int> level1, List<int> level2)
    {
        _expandedScheduleIds = level1.ToHashSet();
        _expandedOrderIds    = level2.ToHashSet();
        DebounceSaveState();
    }

    private record ExpandedGroupResult(List<int> Level1, List<int> Level2);

    // Re-expands saved groups after any operation that collapses them.
    // Delegates entirely to JS so row-index arithmetic stays correct as
    // Syncfusion adds rows to the DOM after each expansion.
    private async Task RestoreExpansionAsync()
    {
        if (_schedGrid is null || (_expandedScheduleIds.Count == 0 && _expandedOrderIds.Count == 0))
            return;
        try
        {
            await JS.InvokeVoidAsync("horstGrid.restoreExpansion", "OrdersGrid_v6",
                _expandedScheduleIds.ToList(), _expandedOrderIds.ToList());
        }
        catch (JSException) { }
    }

    // ── Row styling ───────────────────────────────────────────────────────────
    private void OnRowDataBound(RowDataBoundEventArgs<FlatSchedulePartRow> args)
    {
        if (args.Data.ScheduleReleased)
