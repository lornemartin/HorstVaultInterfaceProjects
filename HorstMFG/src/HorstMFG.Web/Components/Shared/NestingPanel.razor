@inject IHubContext<BridgeHub> HubContext
@inject BridgeNotificationService BridgeEvents
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject IConfiguration Configuration
@inject IJSRuntime JS
@implements IDisposable

@using HorstMFG.Core.Entities
@using HorstMFG.Infrastructure.Data
@using HorstMFG.Web.Hubs
@using HorstMFG.Web.Services
@using Microsoft.AspNetCore.SignalR
@using Microsoft.EntityFrameworkCore
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.DropDowns
@using System.Text.Json

<div class="nesting-panel border rounded p-2 bg-light" style="margin-bottom:1.5rem;">

    @* Row 1: Station selector + active project *@
    <div style="display:flex; gap:.75rem; align-items:flex-end; flex-wrap:wrap; margin-bottom:.6rem;">

        <div style="min-width:200px;">
            <label style="font-weight:600; display:block; margin-bottom:.2rem; font-size:.85em;">Nesting Station</label>
            @if (StationId.HasValue)
            {
                @* Station is fixed by the user's account — show as read-only label *@
                var label = _stations.FirstOrDefault(s => s.Id == StationId)?.Label ?? $"Station {StationId}";
                <div style="padding:.35rem .5rem; background:#fff; border:1px solid #dee2e6; border-radius:4px; font-size:.9em;">@label</div>
            }
            else
            {
                @* Admin or unassigned user — show dropdown *@
                <SfDropDownList TValue="int?" TItem="StationOption"
                                Value="_stationId" ValueChanged="OnStationChangedAsync"
                                DataSource="_stations" Placeholder="Select station…">
                    <DropDownListFieldSettings Text="Label" Value="Id" />
                </SfDropDownList>
            }
        </div>

        <div style="flex:1; min-width:260px;">
            <label style="font-weight:600; display:block; margin-bottom:.2rem; font-size:.85em;">Active Project</label>
            <div style="display:flex; gap:.4rem;">
                <input type="text" class="form-control form-control-sm" placeholder="Path to .rpd file…"
                       value="@StripProjectRoot(_projectPath)"
                       @onchange="@(e => _projectPath = ExpandProjectRoot(e.Value?.ToString() ?? ""))"
                       disabled="@(_stationId == null)" />
                <SfButton OnClick="SetActiveProjectAsync"
                          Disabled="@(_stationId == null || string.IsNullOrWhiteSpace(_projectPath))">
                    Set
                </SfButton>
            </div>
        </div>
    </div>

    @* Row 2: Command buttons *@
    <div style="display:flex; gap:.75rem; align-items:center; flex-wrap:wrap; margin-bottom:.6rem;">

        <SfButton CssClass="e-primary" IconCss="e-icons e-upload-1" OnClick="SendToNestingAsync"
                  Disabled="@(_isBusy || _stationId == null || !SelectedItems.Any(i => i.QtyNested < i.QtyRequired))">
            Send to Nesting
        </SfButton>

        <SfButton IconCss="e-icons e-import" OnClick="RetrieveFromNestingAsync"
                  Disabled="@(_isBusy || _stationId == null || !SelectedItems.Any(i => i.RadanIdNumber != null))">
            Retrieve Selection
        </SfButton>

        <SfButton IconCss="e-icons e-import-1" OnClick="RetrieveAllFromNestingAsync"
                  Disabled="@(_isBusy || _stationId == null)">
            Retrieve All
        </SfButton>

        <SfButton IconCss="e-icons e-refresh" OnClick="SyncAsync"
                  Disabled="@(_isBusy || _stationId == null)">
            Sync
        </SfButton>

        <SfButton CssClass="e-danger" IconCss="e-icons e-check" OnClick="FinalizeAsync"
                  Disabled="@(_isBusy || _stationId == null)">
            Finalize
        </SfButton>

        <div style="margin-left:auto; display:flex; gap:.5rem;">
            <SfButton CssClass="e-outline" IconCss="e-icons e-lock" OnClick="RetrieveFromVaultAsync"
                      Disabled="@(_isBusy || _stationId == null || !SelectedItems.Any())">
                Retrieve from Vault
            </SfButton>

            <SfButton CssClass="e-outline" IconCss="e-icons e-thumbnail" OnClick="UpdateThumbnailsAsync"
                      Disabled="@(_isBusy || _stationId == null || !SelectedItems.Any())">
                Update Thumbnails
            </SfButton>

            <SfButton CssClass="e-danger e-outline" IconCss="e-icons e-close" OnClick="OnDeleteSelectedAsync"
                      Disabled="@(_isBusy || !SelectedItems.Any())">
                Delete Selected
            </SfButton>
        </div>
    </div>

    @if (_statusLines.Count > 0)
    {
        <div style="background:#fff; border:1px solid #dee2e6; border-radius:4px;
                                  padding:.4rem .6rem; font-size:.82em;
                                  max-height:120px; overflow-y:auto;">
            @foreach (var line in _statusLines)
            {
                <div class="@line.Css">@line.Text</div>
            }
        </div>
    }
</div>

@code {
    // ── Parameters ────────────────────────────────────────────────────────────
    [Parameter] public string  ItemType  { get; set; } = "Order";   // "Order" | "Batch"
    [Parameter] public int     PlantId   { get; set; }
    [Parameter] public int?    StationId { get; set; }   // from user's StationId claim; null = admin/unassigned
    [Parameter] public IReadOnlyList<NestingSelectionItem> SelectedItems { get; set; }
        = Array.Empty<NestingSelectionItem>();
    [Parameter] public EventCallback OnCompleted { get; set; }

    // ── State ─────────────────────────────────────────────────────────────────
    private List<StationOption> _stations = new();
    private int? _stationId;
    private string _projectPath = "";
    private bool _isBusy;
    private bool _pendingFinalize;
    private string? _pendingCommandId;
    private string? _pendingCommandType;
    private List<StatusLine> _statusLines = new();
    private bool _eventsSubscribed;
    private int _prevPlantId = -1;

    private record StationOption(int Id, string Label);
    private record StatusLine(string Text, string Css = "");

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync() => await LoadStationsAsync();

    protected override async Task OnParametersSetAsync()
    {
        if (PlantId != _prevPlantId)
        {
            _prevPlantId = PlantId;
            await LoadStationsAsync();
        }
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_eventsSubscribed)
        {
            _eventsSubscribed              = true;
            BridgeEvents.ProgressReceived  += OnProgress;
            BridgeEvents.CommandCompleted  += OnCommandCompleted;
            BridgeEvents.AutoSyncReceived  += OnAutoSync;
        }
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        BridgeEvents.ProgressReceived -= OnProgress;
        BridgeEvents.CommandCompleted -= OnCommandCompleted;
        BridgeEvents.AutoSyncReceived -= OnAutoSync;
    }

    private async Task LoadStationsAsync()
    {
        await using var db = await DbContextFactory.CreateDbContextAsync();
        var raw = await db.NestingStations
            .Where(s => s.PlantId == PlantId)
            .Select(s => new { s.Id, s.Name })
            .ToListAsync();

        _stations = raw.Select(s =>
        {
            var online = BridgeHub.IsStationOnline(s.Id);
            return new StationOption(s.Id, $"{s.Name}  {(online ? "●" : "○")}");
        }).ToList();

        // Only auto-set _stationId from the user's assigned station claim.
        // Admins without an assignment must select manually from the dropdown.
        if (_stationId == null && StationId.HasValue)
        {
            _stationId = StationId;
            var station = await db.NestingStations.FindAsync(StationId.Value);
            _projectPath = station?.ProjectPath ?? "";
        }
    }

    // ── Station / project selection ───────────────────────────────────────────

    private async Task OnStationChangedAsync(int? id)
    {
        _stationId   = id;
        _projectPath = "";
        await LoadStationsAsync();   // refresh ●/○ indicators
        if (id.HasValue)
        {
            await using var db = await DbContextFactory.CreateDbContextAsync();
            var station = await db.NestingStations.FindAsync(id.Value);
            _projectPath = station?.ProjectPath ?? "";
        }
    }

    private async Task SetActiveProjectAsync()
    {
        if (_stationId == null || string.IsNullOrWhiteSpace(_projectPath)) return;

        await using var db = await DbContextFactory.CreateDbContextAsync();
        var station = await db.NestingStations.FindAsync(_stationId.Value);
        if (station == null) return;

        station.ProjectPath = _projectPath.Trim();
        station.ProjectName = System.IO.Path.GetFileNameWithoutExtension(_projectPath.Trim());
        await db.SaveChangesAsync();

        bool online = BridgeHub.TrySendSetActiveProject(HubContext, _stationId.Value, _projectPath.Trim());
        Log(online
            ? $"Active project set to: {station.ProjectName}"
            : "Project saved. Station is offline — will apply on next connection.");
        StateHasChanged();
    }

    // ── Commands ──────────────────────────────────────────────────────────────

    private async Task SendToNestingAsync()
    {
        // Send items with remaining qty only — fully nested items (QtyNested >= QtyRequired) are excluded.
        var toSend = SelectedItems
            .Where(i => i.QtyNested < i.QtyRequired)
            .ToList();
        if (!toSend.Any()) return;

        // For each filename that has an item being sent, also pull in any already-in-project
        // siblings sharing that filename (not already in toSend) so the bridge sees the full
        // group: combined qty and all order numbers get concatenated correctly.
        var toSendIds = toSend.Select(i => i.ItemId).ToHashSet();
        var newFileNames = toSend
            .Where(i => !string.IsNullOrEmpty(i.FileName))
            .Select(i => i.FileName!)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        var inProjectSiblings = SelectedItems
            .Where(i => !toSendIds.Contains(i.ItemId)
                     && i.IsInRadanProject
                     && i.FileName != null
                     && newFileNames.Contains(i.FileName))
            .ToList();
        if (inProjectSiblings.Any())
            toSend.AddRange(inProjectSiblings);

        var noFile = toSend.Where(i => string.IsNullOrEmpty(i.FileName)).ToList();
        if (noFile.Any())
        {
            bool ok = await JS.InvokeAsync<bool>("confirm",
                $"{noFile.Count} item(s) have no file name (no .sym will be found). " +
                $"They will still be added to the project. Continue?");
            if (!ok) return;
        }

        var payload = JsonSerializer.Serialize(toSend.Select(i => new
        {
            ItemId        = i.ItemId,
            ItemType      = ItemType,
            FileName      = i.FileName ?? "",
            QtyRequired   = i.QtyRequired - i.QtyNested,
            Material      = i.Material,
            Thickness     = i.Thickness,
            OrderNumber   = i.GroupName,
            Description   = i.Description,
            ScheduleName  = i.ScheduleName,
            BatchName     = i.BatchName,
            HasBends      = i.HasBends,
            RadanIdNumber = i.RadanIdNumber,  // non-null when re-sending a partially-nested item
        }));

        await SendCommandAsync("SendToNesting", payload);
    }

    private async Task RetrieveFromNestingAsync()
    {
        var toRetrieve = SelectedItems.Where(i => i.RadanIdNumber != null).ToList();
        if (!toRetrieve.Any()) return;

        // Deduplicate — send one representative per unique RadanIdNumber
        var payload = JsonSerializer.Serialize(toRetrieve
            .GroupBy(i => i.RadanIdNumber!.Value)
            .Select(g => new
            {
                ItemId        = g.First().ItemId,
                RadanIdNumber = g.Key,
            }));

        await SendCommandAsync("RetrieveFromNesting", payload);
    }

    private async Task RetrieveAllFromNestingAsync()
    {
        var payload = await BuildRetrieveAllPayloadAsync();
        if (payload == null) { Log("No items currently in a Radan project for this station."); return; }
        await SendCommandAsync("RetrieveFromNesting", payload);
    }

    private async Task<string?> BuildRetrieveAllPayloadAsync()
    {
        if (_stationId == null) return null;
        await using var db = await DbContextFactory.CreateDbContextAsync();

        if (ItemType == "Order")
        {
            var items = await db.OrderItems
                .Where(i => i.NestingStationId == _stationId && i.RadanIdNumber != null && i.IsInRadanProject)
                .Select(i => new { i.Id, i.RadanIdNumber })
                .ToListAsync();
            if (!items.Any()) return null;
            return JsonSerializer.Serialize(items
                .GroupBy(i => i.RadanIdNumber!.Value)
                .Select(g => new { ItemId = g.First().Id, RadanIdNumber = g.Key }));
        }
        else
        {
            var items = await db.BatchItems
                .Where(i => i.NestingStationId == _stationId && i.RadanIdNumber != null && i.IsInRadanProject)
                .Select(i => new { i.Id, i.RadanIdNumber })
                .ToListAsync();
            if (!items.Any()) return null;
            return JsonSerializer.Serialize(items
                .GroupBy(i => i.RadanIdNumber!.Value)
                .Select(g => new { ItemId = g.First().Id, RadanIdNumber = g.Key }));
        }
    }

    private async Task RetrieveFromVaultAsync()
    {
        if (!SelectedItems.Any()) return;

        var payload = JsonSerializer.Serialize(SelectedItems.Select(i => new
        {
            ItemId   = i.ItemId,
            FileName = i.FileName ?? "",
        }));

        await SendCommandAsync("RetrieveFromVault", payload);
    }

    private async Task UpdateThumbnailsAsync()
    {
        if (!SelectedItems.Any()) return;

        Log($"UpdateThumbnail: {SelectedItems.Count} item(s) — " +
            string.Join(", ", SelectedItems.Select(i => $"{i.FileName} (PartId={i.PartId})")));

        var payload = JsonSerializer.Serialize(SelectedItems.Select(i => new
        {
            PartId   = i.PartId,
            FileName = i.FileName ?? "",
        }));

        await SendCommandAsync("UpdateThumbnail", payload);
    }

    private Task SyncAsync() => SendCommandAsync("Sync", "{}");

    private async Task FinalizeAsync()
    {
        bool ok = await JS.InvokeAsync<bool>("confirm",
            "This will retrieve all nested parts, mark completion, and create a new empty project. Continue?");
        if (!ok) return;

        var retrievePayload = await BuildRetrieveAllPayloadAsync();
        if (retrievePayload != null)
        {
            Log("Retrieving all nested parts before finalizing…");
            _pendingFinalize = true;
            await SendCommandAsync("RetrieveFromNesting", retrievePayload);
        }
        else
        {
            await SendCommandAsync("Finalize", "{}");
        }
    }

    private async Task SendCommandAsync(string commandType, string payload)
    {
        if (_stationId == null)
        {
            Log("SendCommandAsync: no station selected — command not sent.", "text-danger");
            return;
        }

        _isBusy             = true;
        _pendingCommandId   = Guid.NewGuid().ToString();
        _pendingCommandType = commandType;
        _statusLines.Clear();
        Log($"Sending {commandType} to station {_stationId}…");

        bool sent = BridgeHub.TrySendCommand(HubContext, _stationId.Value,
                                             _pendingCommandId, commandType, payload);
        if (!sent)
        {
            Log($"Station {_stationId} is not connected.", "text-danger");
            _isBusy = false;
        }
        else
        {
            Log($"Command {_pendingCommandId![..8]}… dispatched — waiting for result.");
        }
        StateHasChanged();
        await Task.CompletedTask;
    }

    // ── Event handlers (called from non-Blazor threads) ───────────────────────

    private void OnProgress(int stationId, string commandId, string message, int percent)
    {
        if (commandId != _pendingCommandId) return;
        _ = InvokeAsync(() =>
        {
            Log($"[{percent}%] {message}");
            StateHasChanged();
        });
    }

    private void OnCommandCompleted(int stationId, string commandId, bool success, string payload)
    {
        if (commandId != _pendingCommandId) return;
        _ = InvokeAsync(async () =>
        {
            _isBusy           = false;
            _pendingCommandId = null;

            if (!success)
            {
                Log($"Failed: {payload}", "text-danger");
                StateHasChanged();
                return;
            }

            try   { await ProcessResultAsync(payload); }
            catch (Exception ex) { Log($"Error processing result: {ex.Message}", "text-danger"); }

            // If Finalize requested a retrieve-all first, now send the actual Finalize
            if (_pendingFinalize && _pendingCommandType == "RetrieveFromNesting")
            {
                _pendingFinalize = false;
                StateHasChanged();
                await OnCompleted.InvokeAsync();
                await SendCommandAsync("Finalize", "{}");
                return;
            }

            StateHasChanged();
            await OnCompleted.InvokeAsync();
        });
    }

    private void OnAutoSync(int stationId, string syncPayloadJson)
    {
        if (stationId != _stationId) return;
        _ = InvokeAsync(async () =>
        {
            try
            {
                var sync = JsonSerializer.Deserialize<SyncPayloadDto>(syncPayloadJson,
                    new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (sync != null)
                {
                    await ApplySyncPayloadAsync(sync);
                    Log("Auto-synced from file change.");
                }
            }
            catch (Exception ex) { Log($"Auto-sync error: {ex.Message}", "text-danger"); }
            StateHasChanged();
            await OnCompleted.InvokeAsync();
        });
    }

    // ── Result processing + DB updates ────────────────────────────────────────

    private async Task ProcessResultAsync(string payload)
    {
        switch (_pendingCommandType)
        {
            case "SendToNesting":      await ProcessSendToNestingAsync(payload); break;
            case "RetrieveFromNesting": await ProcessRetrieveFromNestingAsync(payload); break;
            case "Sync":               await ProcessSyncAsync(payload); break;
            case "Finalize":           await ProcessFinalizeAsync(payload); break;
            case "RetrieveFromVault":  await ProcessRetrieveFromVaultAsync(payload); break;
            case "UpdateThumbnail":    await ProcessUpdateThumbnailAsync(payload); break;
        }
    }

    private async Task ProcessSendToNestingAsync(string payload)
    {
        var results = JsonSerializer.Deserialize<List<SendToNestingResultDto>>(payload,
            new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        if (results == null) return;

        int sent = 0, warned = 0;
        await using var db = await DbContextFactory.CreateDbContextAsync();

        foreach (var r in results)
        {
            if (ItemType == "Order")
            {
                var item = await db.OrderItems.FindAsync(r.ItemId);
                if (item != null) { item.IsInRadanProject = true; item.RadanIdNumber = (int)r.RadanIdNumber; item.NestingStationId = _stationId; }
            }
            else
            {
                var item = await db.BatchItems.FindAsync(r.ItemId);
                if (item != null) { item.IsInRadanProject = true; item.RadanIdNumber = (int)r.RadanIdNumber; item.NestingStationId = _stationId; }
            }
            sent++;
            if (r.MissingSymFile) warned++;
        }

        await db.SaveChangesAsync();

        foreach (var r in results)
        {
            var name = SelectedItems.FirstOrDefault(i => i.ItemId == r.ItemId)?.FileName
                       ?? $"ItemId {r.ItemId}";
            var verified = r.VerifiedInProject ? " ✓ confirmed in project" : " ✗ NOT found in saved project";
            if (r.MissingSymFile)
                Log($"  {name} → Radan ID #{r.RadanIdNumber} (no .sym file — added without geometry){verified}", "text-warning");
            else if (!r.VerifiedInProject)
                Log($"  {name} → Radan ID #{r.RadanIdNumber}{verified}", "text-danger");
            else
                Log($"  {name} → Radan ID #{r.RadanIdNumber}{verified}");
        }

        var notVerified = results.Count(r => !r.VerifiedInProject);
        Log($"Sent {sent} item(s) to nesting project." +
            (warned     > 0 ? $" {warned} missing .sym file(s)." : "") +
            (notVerified > 0 ? $" {notVerified} could not be verified in saved RPD." : ""),
            notVerified > 0 ? "text-danger" : warned > 0 ? "text-warning" : "");
    }

    private async Task ProcessRetrieveFromNestingAsync(string payload)
    {
        var result = JsonSerializer.Deserialize<RetrieveFromNestingResultDto>(payload,
            new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        if (result == null) return;

        await ApplySyncPayloadAsync(result.Sync);

        await using var db = await DbContextFactory.CreateDbContextAsync();

        // Each ID in ClearedItemIds / AdjustedItemIds is a representative for a unique RadanIdNumber.
        // Expand to ALL DB items sharing that RadanIdNumber at this station so grouped items are
        // all updated together.
        if (ItemType == "Order")
        {
            if (result.ClearedItemIds.Any())
            {
                var clearedRadanIds = await db.OrderItems
                    .Where(i => result.ClearedItemIds.Contains(i.Id) && i.RadanIdNumber != null)
                    .Select(i => i.RadanIdNumber!.Value).Distinct().ToListAsync();
                if (clearedRadanIds.Any())
                {
                    var allCleared = await db.OrderItems
                        .Where(i => i.NestingStationId == _stationId
                                 && i.RadanIdNumber != null
                                 && clearedRadanIds.Contains(i.RadanIdNumber!.Value))
                        .ToListAsync();
                    foreach (var item in allCleared)
                        { item.IsInRadanProject = false; item.RadanIdNumber = null; item.NestingStationId = null; }
                }
            }

            if (result.AdjustedItemIds.Any())
            {
                var adjustedRadanIds = await db.OrderItems
                    .Where(i => result.AdjustedItemIds.Contains(i.Id) && i.RadanIdNumber != null)
                    .Select(i => i.RadanIdNumber!.Value).Distinct().ToListAsync();
                if (adjustedRadanIds.Any())
                {
                    var allAdjusted = await db.OrderItems
                        .Where(i => i.NestingStationId == _stationId
                                 && i.RadanIdNumber != null
                                 && adjustedRadanIds.Contains(i.RadanIdNumber!.Value))
                        .ToListAsync();
                    foreach (var item in allAdjusted)
                        { item.IsInRadanProject = false; item.NestingStationId = null; }
                }
            }
        }
        else
        {
            if (result.ClearedItemIds.Any())
            {
                var clearedRadanIds = await db.BatchItems
                    .Where(i => result.ClearedItemIds.Contains(i.Id) && i.RadanIdNumber != null)
                    .Select(i => i.RadanIdNumber!.Value).Distinct().ToListAsync();
                if (clearedRadanIds.Any())
                {
                    var allCleared = await db.BatchItems
                        .Where(i => i.NestingStationId == _stationId
                                 && i.RadanIdNumber != null
                                 && clearedRadanIds.Contains(i.RadanIdNumber!.Value))
                        .ToListAsync();
                    foreach (var item in allCleared)
                        { item.IsInRadanProject = false; item.RadanIdNumber = null; item.NestingStationId = null; }
                }
            }

            if (result.AdjustedItemIds.Any())
            {
                var adjustedRadanIds = await db.BatchItems
                    .Where(i => result.AdjustedItemIds.Contains(i.Id) && i.RadanIdNumber != null)
                    .Select(i => i.RadanIdNumber!.Value).Distinct().ToListAsync();
                if (adjustedRadanIds.Any())
                {
                    var allAdjusted = await db.BatchItems
                        .Where(i => i.NestingStationId == _stationId
                                 && i.RadanIdNumber != null
                                 && adjustedRadanIds.Contains(i.RadanIdNumber!.Value))
                        .ToListAsync();
                    foreach (var item in allAdjusted)
                        { item.IsInRadanProject = false; item.NestingStationId = null; }
                }
            }
        }

        await db.SaveChangesAsync();
        Log($"Retrieved {result.ClearedItemIds.Count + result.AdjustedItemIds.Count} item(s) from nesting project.");
    }

    private async Task ProcessSyncAsync(string payload)
    {
        var sync = JsonSerializer.Deserialize<SyncPayloadDto>(payload,
            new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        if (sync == null) return;

        await ApplySyncPayloadAsync(sync);
        Log($"Synced {sync.Parts.Count} part(s).");
    }

    private async Task ProcessFinalizeAsync(string payload)
    {
        var result = JsonSerializer.Deserialize<FinalizeResultDto>(payload,
            new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        if (result == null) return;

        await ApplySyncPayloadAsync(result.Sync);

        await using var db = await DbContextFactory.CreateDbContextAsync();

        // Build QtyNested lookup by RadanIdNumber from the sync payload
        var nestedQty = result.Sync.Parts
            .ToDictionary(p => (int)p.RadanIdNumber, p => p.QtyNested);

        // Process ALL order items at this station regardless of ItemType
        var orderItems = await db.OrderItems
            .Where(i => i.NestingStationId == _stationId)
            .ToListAsync();
        foreach (var item in orderItems)
        {
            var qty = item.RadanIdNumber.HasValue
                   && nestedQty.TryGetValue(item.RadanIdNumber.Value, out var q) ? q : 0;
            item.IsInRadanProject = false;
            item.NestingStationId = null;
            if (qty == 0) item.RadanIdNumber = null;
        }

        // Process ALL batch items at this station regardless of ItemType
        var batchItems = await db.BatchItems
            .Where(i => i.NestingStationId == _stationId)
            .ToListAsync();
        foreach (var item in batchItems)
        {
            var qty = item.RadanIdNumber.HasValue
                   && nestedQty.TryGetValue(item.RadanIdNumber.Value, out var q) ? q : 0;
            item.IsInRadanProject = false;
            item.NestingStationId = null;
            if (qty == 0) item.RadanIdNumber = null;
        }

        // Update station project info and sync the textbox
        if (_stationId.HasValue)
        {
            var station = await db.NestingStations.FindAsync(_stationId.Value);
            if (station != null)
            {
                station.ProjectName = result.NewProjectName;
                station.ProjectPath = result.NewProjectPath;
            }
            _projectPath = result.NewProjectPath;
        }

        await db.SaveChangesAsync();
        Log($"Finalized. New project: {result.NewProjectName}");
    }

    private async Task ProcessRetrieveFromVaultAsync(string payload)
    {
        var results = JsonSerializer.Deserialize<List<RetrieveFromVaultResultDto>>(payload,
            new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        if (results == null) return;

        int ok  = results.Count(r => r.Success);
        int err = results.Count(r => !r.Success);
        if (ok  > 0) Log($"{ok} file(s) retrieved from Vault.");
        if (err > 0) Log($"{err} file(s) failed:", "text-danger");
        foreach (var r in results.Where(r => !r.Success))
            Log($"  Item {r.ItemId}: {r.Error}", "text-danger");

        // Auto-follow-up: update thumbnails for every successfully retrieved part
        var successIds  = results.Where(r => r.Success).Select(r => r.ItemId).ToHashSet();
        var thumbItems  = SelectedItems.Where(i => successIds.Contains(i.ItemId)).ToList();
        if (thumbItems.Any())
        {
            Log($"Updating thumbnail for {thumbItems.Count} retrieved file(s)…");
            var thumbPayload = JsonSerializer.Serialize(thumbItems.Select(i => new
            {
                PartId   = i.PartId,
                FileName = i.FileName ?? "",
            }));
            await SendCommandAsync("UpdateThumbnail", thumbPayload);
        }
    }

    private async Task OnDeleteSelectedAsync()
    {
        if (!SelectedItems.Any()) return;

        await using var db = await DbContextFactory.CreateDbContextAsync();
        var ids = SelectedItems.Select(i => i.ItemId).ToList();

        if (ItemType == "Order")
        {
            var items = await db.OrderItems.Where(i => ids.Contains(i.Id)).ToListAsync();
            var blocked = items
                .Where(i => i.QtyNested > 0)
                .Select(i => SelectedItems.FirstOrDefault(s => s.ItemId == i.Id)?.FileName ?? $"Id {i.Id}")
                .ToList();
            if (blocked.Any())
            {
                await JS.InvokeVoidAsync("alert",
                    $"Cannot delete — {blocked.Count} item(s) have nested quantities and must be retrieved first:\n{string.Join("\n", blocked)}");
                return;
            }
            bool ok = await JS.InvokeAsync<bool>("confirm", $"Delete {items.Count} selected item(s)? This cannot be undone.");
            if (!ok) return;
            db.OrderItems.RemoveRange(items);
        }
        else
        {
            var items = await db.BatchItems.Where(i => ids.Contains(i.Id)).ToListAsync();
            var blocked = items
                .Where(i => i.QtyNested > 0)
                .Select(i => SelectedItems.FirstOrDefault(s => s.ItemId == i.Id)?.FileName ?? $"Id {i.Id}")
                .ToList();
            if (blocked.Any())
            {
                await JS.InvokeVoidAsync("alert",
                    $"Cannot delete — {blocked.Count} item(s) have nested quantities and must be retrieved first:\n{string.Join("\n", blocked)}");
                return;
            }
            bool ok = await JS.InvokeAsync<bool>("confirm", $"Delete {items.Count} selected item(s)? This cannot be undone.");
            if (!ok) return;
            db.BatchItems.RemoveRange(items);
        }

        await db.SaveChangesAsync();
        Log($"Deleted {ids.Count} item(s).");
        StateHasChanged();
        await OnCompleted.InvokeAsync();
    }

    private Task ProcessUpdateThumbnailAsync(string payload)
    {
        var results = JsonSerializer.Deserialize<List<UpdateThumbnailResultDto>>(payload,
            new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        if (results == null) return Task.CompletedTask;

        foreach (var r in results)
        {
            var name = SelectedItems.FirstOrDefault(i => i.PartId == r.PartId)?.FileName
                       ?? $"PartId {r.PartId}";
            if (r.Success && r.ThumbnailBytes != null)
                Log($"Thumbnail updated: {name}");
            else
                Log($"No sym file for {name} — thumbnail cleared.", "text-warning");
        }
        return Task.CompletedTask;
    }

    private async Task ApplySyncPayloadAsync(SyncPayloadDto sync)
    {
        if (sync.Parts.Count == 0 || _stationId == null) return;
        await using var db = await DbContextFactory.CreateDbContextAsync();

        // Resolve plant ID from the station so admin users (PlantId==0) work correctly.
        var nestPlantId = PlantId > 0
            ? PlantId
            : (await db.NestingStations.AsNoTracking()
                   .Where(s => s.Id == _stationId)
                   .Select(s => s.PlantId)
                   .FirstOrDefaultAsync());

        if (ItemType == "Order")
        {
            var items = await db.OrderItems
                .Where(i => i.NestingStationId == _stationId && i.RadanIdNumber != null)
                .ToListAsync();

            // Preload all existing NestedParts so we can calculate per-item remaining capacity
            // without hitting the DB per row, and keep the list in sync as we process each nest.
            var orderItemIds = items.Select(i => i.Id).ToList();
            var allNestedParts = await db.NestedParts
                .Where(np => np.OrderItemId.HasValue && orderItemIds.Contains(np.OrderItemId.Value))
                .ToListAsync();

            foreach (var syncNest in sync.Nests)
            {
                var nest = await db.Nests
                    .FirstOrDefaultAsync(n => n.NestName == syncNest.NestName && n.PlantId == nestPlantId);
                if (nest == null)
                {
                    nest = new Nest { NestName = syncNest.NestName, NestPath = syncNest.NestPath, Thumbnail = syncNest.ThumbnailBytes, PlantId = nestPlantId };
                    db.Nests.Add(nest);
                    await db.SaveChangesAsync();
                }
                else
                {
                    if (syncNest.NestPath != null) nest.NestPath = syncNest.NestPath;
                    if (syncNest.ThumbnailBytes != null) nest.Thumbnail = syncNest.ThumbnailBytes;
                }

                foreach (var entry in syncNest.Parts)
                {
                    var sharedItems = items.Where(i => i.RadanIdNumber == (int)entry.RadanIdNumber)
                                           .OrderBy(i => i.Id).ToList();
                    int remaining = entry.Qty;
                    for (int idx = 0; idx < sharedItems.Count; idx++)
                    {
                        var item = sharedItems[idx];
                        // Capacity = how much more this item can absorb in THIS nest:
                        // QtyRequired minus what's already recorded in every OTHER nest.
                        var otherNestsQty = allNestedParts
                            .Where(np => np.OrderItemId == item.Id && np.NestId != nest.Id)
                            .Sum(np => np.Qty);
                        var capacity = Math.Max(0, item.QtyRequired - otherNestsQty);
                        int fill = idx == sharedItems.Count - 1 ? remaining : Math.Min(remaining, capacity);
                        remaining = Math.Max(0, remaining - fill);

                        var np = allNestedParts.FirstOrDefault(x => x.NestId == nest.Id && x.OrderItemId == item.Id);
                        if (fill > 0)
                        {
                            if (np == null)
                            {
                                var newNp = new NestedPart { NestId = nest.Id, OrderItemId = item.Id, Qty = fill };
                                db.NestedParts.Add(newNp);
                                allNestedParts.Add(newNp);
                            }
                            else
                                np.Qty = fill;
                        }
                        else if (np != null)
                        {
                            db.NestedParts.Remove(np);
                            allNestedParts.Remove(np);
                        }
                    }
                }
            }

            foreach (var item in items)
                item.QtyNested = allNestedParts.Where(np => np.OrderItemId == item.Id).Sum(np => np.Qty);
        }
        else
        {
            var items = await db.BatchItems
                .Where(i => i.NestingStationId == _stationId && i.RadanIdNumber != null)
                .ToListAsync();

            var batchItemIds = items.Select(i => i.Id).ToList();
            var allNestedParts = await db.NestedParts
                .Where(np => np.BatchItemId.HasValue && batchItemIds.Contains(np.BatchItemId.Value))
                .ToListAsync();

            foreach (var syncNest in sync.Nests)
            {
                var nest = await db.Nests
                    .FirstOrDefaultAsync(n => n.NestName == syncNest.NestName && n.PlantId == nestPlantId);
                if (nest == null)
                {
                    nest = new Nest { NestName = syncNest.NestName, NestPath = syncNest.NestPath, Thumbnail = syncNest.ThumbnailBytes, PlantId = nestPlantId };
                    db.Nests.Add(nest);
                    await db.SaveChangesAsync();
                }
                else
                {
                    if (syncNest.NestPath != null) nest.NestPath = syncNest.NestPath;
                    if (syncNest.ThumbnailBytes != null) nest.Thumbnail = syncNest.ThumbnailBytes;
                }

                foreach (var entry in syncNest.Parts)
                {
                    var sharedItems = items.Where(i => i.RadanIdNumber == (int)entry.RadanIdNumber)
                                           .OrderBy(i => i.Id).ToList();
                    int remaining = entry.Qty;
                    for (int idx = 0; idx < sharedItems.Count; idx++)
                    {
                        var item = sharedItems[idx];
                        var otherNestsQty = allNestedParts
                            .Where(np => np.BatchItemId == item.Id && np.NestId != nest.Id)
                            .Sum(np => np.Qty);
                        var capacity = Math.Max(0, item.QtyRequired - otherNestsQty);
                        int fill = idx == sharedItems.Count - 1 ? remaining : Math.Min(remaining, capacity);
                        remaining = Math.Max(0, remaining - fill);

                        var np = allNestedParts.FirstOrDefault(x => x.NestId == nest.Id && x.BatchItemId == item.Id);
                        if (fill > 0)
                        {
                            if (np == null)
                            {
                                var newNp = new NestedPart { NestId = nest.Id, BatchItemId = item.Id, Qty = fill };
                                db.NestedParts.Add(newNp);
                                allNestedParts.Add(newNp);
                            }
                            else
                                np.Qty = fill;
                        }
                        else if (np != null)
                        {
                            db.NestedParts.Remove(np);
                            allNestedParts.Remove(np);
                        }
                    }
                }
            }

            foreach (var item in items)
                item.QtyNested = allNestedParts.Where(np => np.BatchItemId == item.Id).Sum(np => np.Qty);
        }

        await db.SaveChangesAsync();
    }

    private void Log(string text, string css = "") =>
        _statusLines.Insert(0, new StatusLine(text, css));

    // ── Private deserialization DTOs ──────────────────────────────────────────

    private record SendToNestingResultDto(int ItemId, long RadanIdNumber, bool MissingSymFile, bool VerifiedInProject);
    private record SyncPartDto(long RadanIdNumber, int QtyNested);
    private class NestEntryDto { public long RadanIdNumber { get; set; } public int Qty { get; set; } }
    private class SyncNestDto  { public string NestName { get; set; } = ""; public string? NestPath { get; set; } public byte[]? ThumbnailBytes { get; set; } public List<NestEntryDto> Parts { get; set; } = new(); }
    private class SyncPayloadDto { public List<SyncPartDto> Parts { get; set; } = new(); public List<SyncNestDto> Nests { get; set; } = new(); }
    private class RetrieveFromNestingResultDto
    {
        public SyncPayloadDto Sync            { get; set; } = new();
        public List<int>      ClearedItemIds  { get; set; } = new();
        public List<int>      AdjustedItemIds { get; set; } = new();
    }
    private class FinalizeResultDto
    {
        public SyncPayloadDto Sync            { get; set; } = new();
        public List<int>      ClearedItemIds  { get; set; } = new();
        public List<int>      AdjustedItemIds { get; set; } = new();
        public string         NewProjectName  { get; set; } = "";
        public string         NewProjectPath  { get; set; } = "";
    }

    private string _projectsRoot => Configuration["FileSystemPaths:RadanProjectsRootPath"] ?? "";

    private string StripProjectRoot(string path)
    {
        var root = _projectsRoot;
        if (string.IsNullOrEmpty(path) || string.IsNullOrEmpty(root)) return path;
        if (path.StartsWith(root, StringComparison.OrdinalIgnoreCase))
            return path[root.Length..].TrimStart('\\', '/');
        return path;
    }

    private string ExpandProjectRoot(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return input;
        // If user typed a relative path (doesn't start with a drive letter or UNC), prepend the root
        if (!System.IO.Path.IsPathRooted(input))
            return System.IO.Path.Combine(_projectsRoot, input);
        return input;
    }
    private record RetrieveFromVaultResultDto(int ItemId, bool Success, string? Error);
    private record UpdateThumbnailResultDto(int PartId, byte[]? ThumbnailBytes, bool Success);
